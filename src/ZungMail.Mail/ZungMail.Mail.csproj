<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>ZungMail.Mail</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.18.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <!-- MailKit → MimeKit 默认解析到 Pkcs 10.0.0，有高危公告 GHSA-846f-f764-76mx；
         这里直接抬到 10.0.13（同一大版本的补丁），把传递依赖顶上去。 -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZungMail.Core\ZungMail.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ZungMail.Tests" />
  </ItemGroup>

</Project>
