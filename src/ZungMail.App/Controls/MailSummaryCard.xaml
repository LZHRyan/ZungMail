<UserControl x:Class="ZungMail.App.Controls.MailSummaryCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">

    <UserControl.Resources>
        <Style x:Key="SummarySectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="Margin" Value="0,8,0,4" />
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource Card}" Margin="0,10,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题行：图标 + 名称 + 引擎徽标 + 耗时 + 收起 -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Style="{StaticResource IconPathSmall}"
                          Data="{StaticResource IcoSummary}"
                          Stroke="{DynamicResource AccentBrush}" />
                    <TextBlock Text="AI 总结"
                               Margin="8,0,0,0"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource InkBrush}" />

                    <Border Margin="8,0,0,0"
                            Padding="7,1"
                            CornerRadius="8"
                            Background="{DynamicResource AccentSoftBrush}"
                            Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock FontSize="10.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Text="{Binding ProviderLabel}" />
                    </Border>

                    <TextBlock Margin="8,0,0,0"
                               FontSize="11.5"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedBrush}"
                               Text="{Binding ElapsedText}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource IconBtn}"
                            Width="26"
                            Height="26"
                            Command="{Binding CollapseCommand}"
                            ToolTip="收起摘要">
                        <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IcoClose}" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 降级 / 截断提示 -->
            <Border Grid.Row="1"
                    Margin="0,8,0,0"
                    Padding="9,6"
                    CornerRadius="6"
                    Background="{DynamicResource WarningSoftBrush}"
                    Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibility}}">
                <TextBlock FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource WarningBrush}"
                           Text="{Binding NoticeText}" />
            </Border>

            <!-- 正文区：生成中 / 结果 / 失败 三态 -->
            <Grid Grid.Row="2" Margin="0,6,0,0">
                <!-- 生成中 -->
                <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                    <ProgressBar Height="3"
                                 IsIndeterminate="True"
                                 Background="{DynamicResource AccentSoftBrush}"
                                 Foreground="{DynamicResource AccentBrush}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center"
                                   Text="{Binding StatusText}" />
                        <Button Style="{StaticResource Btn}"
                                Margin="10,0,0,0"
                                Content="取消"
                                Command="{Binding CollapseCommand}" />
                    </StackPanel>
                </StackPanel>

                <!-- 结果 -->
                <ScrollViewer MaxHeight="200"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SummarySectionTitle}" Text="要点" />
                        <!-- 只读 TextBox：支持拖选局部文本 + Ctrl+C，右键还有「复制 / 全选」 -->
                        <TextBox Style="{StaticResource SelectableText}"
                                 FontSize="12.5"
                                 Foreground="{DynamicResource InkBrush}"
                                 Text="{Binding BulletsText, Mode=OneWay}"
                                 ToolTip="可以拖选任意部分，Ctrl+C 复制" />

                        <TextBlock Style="{StaticResource SummarySectionTitle}" Text="待处理" />
                        <TextBox Style="{StaticResource SelectableText}"
                                 FontSize="12.5"
                                 Foreground="{DynamicResource InkBrush}"
                                 Text="{Binding ActionsText, Mode=OneWay}"
                                 ToolTip="可以拖选任意部分，Ctrl+C 复制" />

                        <TextBlock Style="{StaticResource SummarySectionTitle}" Text="单号" />
                        <TextBox Style="{StaticResource SelectableText}"
                                 FontSize="12.5"
                                 Foreground="{DynamicResource InkBrush}"
                                 Text="{Binding ReferencesText, Mode=OneWay}"
                                 ToolTip="可以拖选任意部分，Ctrl+C 复制" />
                    </StackPanel>
                </ScrollViewer>

                <!-- 失败 -->
                <StackPanel Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock FontSize="12.5"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource CriticalBrush}"
                               Text="{Binding ErrorText}" />
                    <Button Style="{StaticResource Btn}"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Left"
                            Content="重试"
                            Command="{Binding SummarizeCommand}" />
                </StackPanel>
            </Grid>

            <!-- 底部操作 -->
            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        Margin="0,8,0,0"
                        Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                <Button Style="{StaticResource Btn}" Click="OnCopyClick" ToolTip="把三段摘要复制到剪贴板">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IcoCopy}" />
                        <TextBlock Text="复制摘要" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Btn}"
                        Margin="8,0,0,0"
                        Command="{Binding RegenerateCommand}"
                        ToolTip="忽略缓存重新推理（约 5–15 秒）">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IcoRefresh}" />
                        <TextBlock Text="重新生成" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
