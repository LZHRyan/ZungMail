<UserControl x:Class="ZungMail.App.Controls.ColorPickerBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="32">
    <Button x:Name="PickerButton"
            Style="{StaticResource Btn}"
            HorizontalAlignment="Left"
            Padding="8,0"
            Click="OnPickClick"
            ToolTip="点击打开拾色器">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border x:Name="Swatch" Width="16" Height="16" CornerRadius="4" VerticalAlignment="Center" />
            <Grid Width="18" Height="18" Margin="8,0,0,0" VerticalAlignment="Center">
                <Ellipse Width="18" Height="18" Stroke="#94a3b8" StrokeThickness="1.3" />
                <Ellipse Width="5" Height="5" Fill="#2563eb" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3,3,0,0" />
                <Ellipse Width="5" Height="5" Fill="#0d9488" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0" />
                <Ellipse Width="5" Height="5" Fill="#d97706" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="3,0,0,3" />
                <Ellipse Width="5" Height="5" Fill="#dc2626" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,3,3" />
            </Grid>
        </StackPanel>
    </Button>
</UserControl>
