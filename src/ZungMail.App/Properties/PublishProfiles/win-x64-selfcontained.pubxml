<?xml version="1.0" encoding="utf-8"?>
<!--
  Visual Studio「发布」向导配置：与 packaging\build-installer.ps1 的默认参数一致
  （win-x64 / 自包含 / 非单文件 / 不带调试符号），便于在 IDE 里直接发布。
  命令行等价写法：
    dotnet publish src\MailClient.App\MailClient.App.csproj -c Release -r win-x64 ^
      --self-contained true -p:PublishSingleFile=false -o <输出目录>
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>..\..\..\packaging\obj\publish\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <DeleteExistingFiles>true</DeleteExistingFiles>
  </PropertyGroup>
</Project>
