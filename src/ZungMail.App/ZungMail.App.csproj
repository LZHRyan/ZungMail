<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>ZungMail.App</RootNamespace>
    <AssemblyName>ZungMail</AssemblyName>
    <ApplicationIcon>Assets\Brand\ZungMail.ico</ApplicationIcon>
    <!-- 自带应用清单：真实 assemblyIdentity + supportedOS + longPathAware，
         替代 .NET apphost 默认的 MyApplication.app 通用清单（安全软件的启发式会看这些） -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- 启用 WinForms 仅为托盘图标（WPF 无内置 NotifyIcon）。
         移除其隐式 using，避免 MessageBox / Application 等类型与 System.Windows 冲突。 -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.8.5" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <!-- 正文 HTML 渲染：本机已缓存 1.0.3179.45，可离线还原 -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3179.45" />
    <!-- Fluent 设计系统：窗口外壳、ContentDialog、Snackbar、ProgressRing 与基础控件样式 -->
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZungMail.Application\ZungMail.Application.csproj" />
    <ProjectReference Include="..\ZungMail.Core\ZungMail.Core.csproj" />
    <ProjectReference Include="..\ZungMail.Infrastructure\ZungMail.Infrastructure.csproj" />
    <ProjectReference Include="..\ZungMail.Mail\ZungMail.Mail.csproj" />
    <!-- 摘要引擎插件（LLamaSharp + CPU 原生库）：只保证程序集与原生库随包发布，
         代码里通过反射注册（见 SummaryModuleCatalog），App 不直接依赖它的类型。 -->
    <ProjectReference Include="..\ZungMail.Summary.LocalModel\ZungMail.Summary.LocalModel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 品牌资源：ApplicationIcon 同时写入可执行文件，供任务栏、Alt+Tab 与资源管理器使用；
         两档 PNG 供界面内直接显示（22px 标题栏用 64、44px 关于页用 256），避免缩放 256 帧发虚。 -->
    <Resource Include="Assets\Brand\ZungMail.ico" />
    <Resource Include="Assets\Brand\ZungMailMark64.png" />
    <Resource Include="Assets\Brand\ZungMailMark.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- 富文本编辑器静态资源：运行时通过虚拟主机 zungmail.editor 加载 -->
    <None Remove="Assets\editor\**" />
    <Content Include="Assets\editor\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>

    <!-- 离线 HTML 使用教程：随程序发布，设置 → 关于直接打开，不依赖网络 -->
    <None Remove="Assets\help\**" />
    <Content Include="Assets\help\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- 把摘要引擎选中的原生库变体（avx2）摊平到输出/publish 根目录：
       LLamaSharp 按名字在程序目录找 llama.dll，依赖 ggml*.dll / mtmd.dll 也必须在同一目录。 -->
  <Target Name="FlattenLlamaNatives" AfterTargets="Build">
    <ItemGroup>
      <LlamaNativeBuild Include="$(OutDir)runtimes\win-x64\native\avx2\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(LlamaNativeBuild)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" ContinueOnError="true" />
  </Target>

  <Target Name="FlattenLlamaNativesPublish" AfterTargets="Publish">
    <ItemGroup>
      <LlamaNativePublish Include="$(PublishDir)runtimes\win-x64\native\avx2\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(LlamaNativePublish)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" ContinueOnError="true" />
    <!-- 摊平后删掉 runtimes 下的指令集子目录：内容与根目录重复，留着只会让安装包多几 MB
         （这些目录里只有 llama / ggml / mtmd，其他原生库如 e_sqlite3 在 runtimes\win-x64\native 根上）。 -->
    <RemoveDir Directories="$(PublishDir)runtimes\win-x64\native\avx;$(PublishDir)runtimes\win-x64\native\avx2;$(PublishDir)runtimes\win-x64\native\avx512;$(PublishDir)runtimes\win-x64\native\noavx"
               ContinueOnError="true" />
  </Target>
  <!-- 摘要引擎插件的原生库只保留 Windows x64：LLamaSharp 包内带 linux / macOS 各 RID，
       发布时会一起拷出来（约 66 MB），安装包不该为用不到的平台付这份体积。 -->
  <Target Name="TrimForeignLlamaNatives" AfterTargets="Publish">
    <ItemGroup>
      <ForeignNative Include="$(PublishDir)runtimes\linux-*\**\*" />
      <ForeignNative Include="$(PublishDir)runtimes\osx-*\**\*" />
      <ForeignNative Include="$(PublishDir)runtimes\win-arm64\**\*" />
    </ItemGroup>
    <Delete Files="@(ForeignNative)" ContinueOnError="true" />
    <RemoveDir Directories="$(PublishDir)runtimes\linux-arm64;$(PublishDir)runtimes\linux-musl-x64;$(PublishDir)runtimes\linux-x64;$(PublishDir)runtimes\osx-arm64;$(PublishDir)runtimes\osx-x64;$(PublishDir)runtimes\win-arm64"
               ContinueOnError="true" />
  </Target>

</Project>

