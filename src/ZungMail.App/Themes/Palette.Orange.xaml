<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 淡橙主题：暖黄浅底 + 焦糖橙主色。键名与默认亮色完全一致。 -->

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FCF1E7" />
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FCF1E7" />
    <SolidColorBrush x:Key="ChromeBrush" Color="#FCF1E7" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#FCF1E7" />
    <SolidColorBrush x:Key="ListBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ReaderBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="HoverBrush" Color="#F8E2CE" />
    <SolidColorBrush x:Key="SelectedBrush" Color="#F9D5B9" />

    <SolidColorBrush x:Key="SelectedLineBrush" Color="#B4681F" />
    <SolidColorBrush x:Key="InkBrush" Color="#1F1B16" />
    <SolidColorBrush x:Key="Ink2Brush" Color="#4A423A" />
    <SolidColorBrush x:Key="MutedBrush" Color="#7A6C5E" />
    <SolidColorBrush x:Key="RuleBrush" Color="#F2E5D6" />
    <SolidColorBrush x:Key="RuleStrongBrush" Color="#E6D3BF" />

    <SolidColorBrush x:Key="AccentBrush" Color="#B4681F" />
    <SolidColorBrush x:Key="Accent2Brush" Color="#0F7B6C" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1AB4681F" />
    <SolidColorBrush x:Key="Accent2SoftBrush" Color="#1A0F7B6C" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="OkDotBrush" Color="#0F7B6C" />
    <SolidColorBrush x:Key="WarnDotBrush" Color="#9D5D00" />
    <SolidColorBrush x:Key="ErrorDotBrush" Color="#C42B1C" />

    <!-- 存储空间分级预警 -->
    <SolidColorBrush x:Key="NoticeBrush" Color="#B4681F" />
    <SolidColorBrush x:Key="NoticeSoftBrush" Color="#1AB4681F" />
    <SolidColorBrush x:Key="WarningBrush" Color="#9D5D00" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#1A9D5D00" />
    <SolidColorBrush x:Key="CriticalBrush" Color="#C42B1C" />
    <SolidColorBrush x:Key="CriticalSoftBrush" Color="#1AC42B1C" />

    <SolidColorBrush x:Key="BadgeGrayBrush" Color="#7A6C5E" />
    <SolidColorBrush x:Key="BadgeGrayBackgroundBrush" Color="#1F7A6C5E" />

    <LinearGradientBrush x:Key="BrandMarkBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#B4681F" Offset="0" />
        <GradientStop Color="#F3C08A" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
