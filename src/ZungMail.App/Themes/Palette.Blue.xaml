<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 淡蓝主题：冷调浅底 + 蓝主色。键名与默认亮色完全一致，界面里的 DynamicResource 不用改。 -->

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#E9F1FB" />
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#E9F1FB" />
    <SolidColorBrush x:Key="ChromeBrush" Color="#E9F1FB" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#E9F1FB" />
    <SolidColorBrush x:Key="ListBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ReaderBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="HoverBrush" Color="#DCE9F8" />
    <SolidColorBrush x:Key="SelectedBrush" Color="#CEE1F7" />

    <SolidColorBrush x:Key="SelectedLineBrush" Color="#2C6FD1" />
    <SolidColorBrush x:Key="InkBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="Ink2Brush" Color="#424242" />
    <SolidColorBrush x:Key="MutedBrush" Color="#5F6C7B" />
    <SolidColorBrush x:Key="RuleBrush" Color="#E3EAF2" />
    <SolidColorBrush x:Key="RuleStrongBrush" Color="#D3DEEB" />

    <SolidColorBrush x:Key="AccentBrush" Color="#2C6FD1" />
    <SolidColorBrush x:Key="Accent2Brush" Color="#0F7B6C" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1A2C6FD1" />
    <SolidColorBrush x:Key="Accent2SoftBrush" Color="#1A0F7B6C" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="OkDotBrush" Color="#0F7B6C" />
    <SolidColorBrush x:Key="WarnDotBrush" Color="#9D5D00" />
    <SolidColorBrush x:Key="ErrorDotBrush" Color="#C42B1C" />

    <!-- 存储空间分级预警 -->
    <SolidColorBrush x:Key="NoticeBrush" Color="#2C6FD1" />
    <SolidColorBrush x:Key="NoticeSoftBrush" Color="#1A2C6FD1" />
    <SolidColorBrush x:Key="WarningBrush" Color="#9D5D00" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#1A9D5D00" />
    <SolidColorBrush x:Key="CriticalBrush" Color="#C42B1C" />
    <SolidColorBrush x:Key="CriticalSoftBrush" Color="#1AC42B1C" />

    <SolidColorBrush x:Key="BadgeGrayBrush" Color="#5F6C7B" />
    <SolidColorBrush x:Key="BadgeGrayBackgroundBrush" Color="#1F5F6C7B" />

    <LinearGradientBrush x:Key="BrandMarkBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2C6FD1" Offset="0" />
        <GradientStop Color="#7FB2F0" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
