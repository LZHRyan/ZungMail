<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 淡粉主题：暖调浅底 + 玫红主色。键名与默认亮色完全一致。 -->

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FCEFF4" />
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FCEFF4" />
    <SolidColorBrush x:Key="ChromeBrush" Color="#FCEFF4" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#FCEFF4" />
    <SolidColorBrush x:Key="ListBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ReaderBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="HoverBrush" Color="#F8DEE8" />
    <SolidColorBrush x:Key="SelectedBrush" Color="#F6D2E0" />

    <SolidColorBrush x:Key="SelectedLineBrush" Color="#C24E7D" />
    <SolidColorBrush x:Key="InkBrush" Color="#1F1A1C" />
    <SolidColorBrush x:Key="Ink2Brush" Color="#4A4145" />
    <SolidColorBrush x:Key="MutedBrush" Color="#7A6A70" />
    <SolidColorBrush x:Key="RuleBrush" Color="#F0E2E8" />
    <SolidColorBrush x:Key="RuleStrongBrush" Color="#E3CDD7" />

    <SolidColorBrush x:Key="AccentBrush" Color="#C24E7D" />
    <SolidColorBrush x:Key="Accent2Brush" Color="#0F7B6C" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1AC24E7D" />
    <SolidColorBrush x:Key="Accent2SoftBrush" Color="#1A0F7B6C" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="OkDotBrush" Color="#0F7B6C" />
    <SolidColorBrush x:Key="WarnDotBrush" Color="#9D5D00" />
    <SolidColorBrush x:Key="ErrorDotBrush" Color="#C42B1C" />

    <!-- 存储空间分级预警 -->
    <SolidColorBrush x:Key="NoticeBrush" Color="#C24E7D" />
    <SolidColorBrush x:Key="NoticeSoftBrush" Color="#1AC24E7D" />
    <SolidColorBrush x:Key="WarningBrush" Color="#9D5D00" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#1A9D5D00" />
    <SolidColorBrush x:Key="CriticalBrush" Color="#C42B1C" />
    <SolidColorBrush x:Key="CriticalSoftBrush" Color="#1AC42B1C" />

    <SolidColorBrush x:Key="BadgeGrayBrush" Color="#7A6A70" />
    <SolidColorBrush x:Key="BadgeGrayBackgroundBrush" Color="#1F7A6A70" />

    <LinearGradientBrush x:Key="BrandMarkBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#C24E7D" Offset="0" />
        <GradientStop Color="#F0A6C1" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
