<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 亮色调色板：取值对齐 Windows 11 Fluent 2 默认浅色（中性灰面 + 系统蓝 #005FB8）。
         键名保持不变，界面里成百上千处 DynamicResource 无需改写。 -->

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="ChromeBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="ListBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ReaderBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="HoverBrush" Color="#EDEDED" />
    <SolidColorBrush x:Key="SelectedBrush" Color="#E5F1FB" />

    <SolidColorBrush x:Key="SelectedLineBrush" Color="#005FB8" />
    <SolidColorBrush x:Key="InkBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="Ink2Brush" Color="#424242" />
    <SolidColorBrush x:Key="MutedBrush" Color="#616161" />
    <SolidColorBrush x:Key="RuleBrush" Color="#E5E5E5" />
    <SolidColorBrush x:Key="RuleStrongBrush" Color="#D6D6D6" />

    <SolidColorBrush x:Key="AccentBrush" Color="#005FB8" />
    <SolidColorBrush x:Key="Accent2Brush" Color="#0F7B6C" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1A005FB8" />
    <SolidColorBrush x:Key="Accent2SoftBrush" Color="#1A0F7B6C" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="OkDotBrush" Color="#0F7B6C" />
    <SolidColorBrush x:Key="WarnDotBrush" Color="#9D5D00" />
    <SolidColorBrush x:Key="ErrorDotBrush" Color="#C42B1C" />

    <!-- 存储空间分级预警 -->
    <SolidColorBrush x:Key="NoticeBrush" Color="#005FB8" />
    <SolidColorBrush x:Key="NoticeSoftBrush" Color="#1A005FB8" />
    <SolidColorBrush x:Key="WarningBrush" Color="#9D5D00" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#1A9D5D00" />
    <SolidColorBrush x:Key="CriticalBrush" Color="#C42B1C" />
    <SolidColorBrush x:Key="CriticalSoftBrush" Color="#1AC42B1C" />

    <SolidColorBrush x:Key="BadgeGrayBrush" Color="#616161" />
    <SolidColorBrush x:Key="BadgeGrayBackgroundBrush" Color="#1F616161" />

    <LinearGradientBrush x:Key="BrandMarkBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#005FB8" Offset="0" />
        <GradientStop Color="#0F7B6C" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
