<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <!--
    应用程序清单：主流安全软件（360 / 火绒 / 腾讯管家）与 SmartScreen 都会看这里的元数据，
    .NET 默认清单里 assemblyIdentity 只是通用的 MyApplication.app、也没有 supportedOS，
    看起来像"来路不明的新程序"；这里改成真实标识并声明支持的系统版本。

    注意：不要在这里加 dpiAware / perMonitorV2。WPF 现在按系统 DPI 感知渲染，
    改了会动到布局与字体缩放，属于另一个独立验证项。
  -->
  <assemblyIdentity version="1.0.0.0" name="ZungMail.exe" type="win32" />
  <description>ZungMail 货代邮件客户端</description>

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <!-- 客户端全程不需要管理员权限：数据写 %APPDATA%，安装/升级由安装器提权 -->
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 / Windows 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <!-- 邮件正文的 eml / 附件目录层级较深，开启长路径避免 260 字符限制 -->
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>
</assembly>
