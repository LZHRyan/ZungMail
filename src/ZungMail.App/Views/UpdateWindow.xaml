<views:DialogWindow x:Class="ZungMail.App.Views.UpdateWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:ZungMail.App.Views"
                    Title="软件升级"
                    Width="560"
                    Height="620"
                    MinWidth="480"
                    MinHeight="520"
                    ResizeMode="CanResize"
                    Background="{DynamicResource WindowBackgroundBrush}"
                    FontFamily="{StaticResource AppFont}"
                    FontSize="13">

    <views:DialogWindow.Resources>
        <!-- 设置页的 CardTitle 是窗口局部资源，新窗口不能引用，这里按同一套字号自带一份 -->
        <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource PageTitle}">
            <Setter Property="FontSize" Value="13.5" />
        </Style>
    </views:DialogWindow.Resources>

    <Border BorderBrush="{DynamicResource RuleStrongBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0"
                    Background="{DynamicResource ChromeBrush}"
                    BorderBrush="{DynamicResource RuleBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="OnTitleBarMouseDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                        <Border Width="22" Height="22" CornerRadius="6" Background="{DynamicResource AccentSoftBrush}">
                            <Path Style="{StaticResource IconPathSmall}"
                                  Data="{StaticResource IcoRefresh}"
                                  Stroke="{DynamicResource AccentBrush}" />
                        </Border>
                        <TextBlock Text="软件升级"
                                   FontWeight="SemiBold"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource InkBrush}" />
                    </StackPanel>

                    <Button Style="{StaticResource WinBtnClose}"
                            HorizontalAlignment="Right"
                            Command="{Binding LaterCommand}"
                            ToolTip="关闭">
                        <Path Style="{StaticResource IconPathSmall}"
                              Data="{StaticResource IcoClose}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </Grid>
            </Border>

            <!-- 正文 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,18,20,16">

                    <!-- 版本概览 -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <StackPanel>
                                    <TextBlock FontSize="12"
                                               Foreground="{DynamicResource MutedBrush}"
                                               Text="可用新版本" />
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock FontSize="24"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource InkBrush}"
                                                   Text="{Binding VersionText}" />
                                        <Border Margin="10,4,0,0"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource WarningSoftBrush}"
                                                CornerRadius="8"
                                                Padding="8,2"
                                                Visibility="{Binding Mandatory, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock FontSize="11"
                                                       Foreground="{DynamicResource WarningBrush}"
                                                       Text="必须更新" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource MutedText}"
                                               Margin="0,6,0,0"
                                               Text="{Binding MetaText}" />
                                </StackPanel>

                                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <TextBlock Style="{StaticResource MutedText}"
                                               HorizontalAlignment="Right"
                                               Text="{Binding LocalVersionText}" />
                                    <TextBlock Style="{StaticResource MutedText}"
                                               Margin="0,4,0,0"
                                               HorizontalAlignment="Right"
                                               Foreground="{DynamicResource AccentBrush}"
                                               Text="{Binding StatusText}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Style="{StaticResource MutedText}"
                                       Margin="0,12,0,0"
                                       TextWrapping="Wrap"
                                       Text="{Binding AddressText}" />
                        </StackPanel>
                    </Border>

                    <!-- 更新说明 -->
                    <Border Style="{StaticResource Card}"
                            Margin="0,14,0,0"
                            Visibility="{Binding HasRelease, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="更新说明" />
                            <Border Margin="0,10,0,0"
                                    Background="{DynamicResource ReaderBrush}"
                                    BorderBrush="{DynamicResource RuleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12,10">
                                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                    <TextBlock Foreground="{DynamicResource Ink2Brush}"
                                               TextWrapping="Wrap"
                                               Text="{Binding Notes}" />
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 便携版说明：检测到 zip 就提前讲清楚「不能自动安装」，避免下载完才失望 -->
                    <Border Style="{StaticResource Card}"
                            Margin="0,14,0,0"
                            Background="{DynamicResource AccentSoftBrush}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1"
                            Visibility="{Binding ShowPortableHint, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="这是便携版，需要手动解压" />
                            <TextBlock Margin="0,8,0,0"
                                       Foreground="{DynamicResource Ink2Brush}"
                                       TextWrapping="Wrap"
                                       Text="{Binding PortableHintText}" />
                        </StackPanel>
                    </Border>

                    <!-- 错误 / 未配置提示 -->
                    <Border Margin="0,14,0,0"
                            Background="{DynamicResource CriticalSoftBrush}"
                            BorderBrush="{DynamicResource ErrorDotBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,10"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold"
                                       Foreground="{DynamicResource CriticalBrush}"
                                       Text="升级服务暂时不可用" />
                            <TextBlock Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource Ink2Brush}"
                                       Text="{Binding ErrorText}" />
                            <Button Style="{StaticResource BtnGhost}"
                                    Margin="0,6,0,0"
                                    Padding="0"
                                    HorizontalAlignment="Left"
                                    Command="{Binding OpenSettingsCommand}"
                                    Content="打开升级设置" />
                        </StackPanel>
                    </Border>

                    <!-- 下载进度 -->
                    <StackPanel Margin="0,16,0,0"
                                Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVisibility}}">
                        <ProgressBar Height="6"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding DownloadPercent}"
                                     Foreground="{DynamicResource AccentBrush}"
                                     Background="{DynamicResource RuleBrush}"
                                     BorderThickness="0" />
                        <TextBlock Style="{StaticResource MutedText}"
                                   Margin="0,6,0,0"
                                   Text="{Binding StatusText}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- 操作栏 -->
            <Border Grid.Row="2"
                    Background="{DynamicResource ChromeBrush}"
                    BorderBrush="{DynamicResource RuleBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="16,12">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Style="{StaticResource BtnGhost}"
                                Content="检查更新"
                                Command="{Binding CheckCommand}"
                                IsEnabled="{Binding CanCheck}" />
                        <Button Style="{StaticResource BtnGhost}"
                                Margin="6,0,0,0"
                                Content="取消下载"
                                Command="{Binding CancelDownloadCommand}"
                                Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}" />
                        <Button Style="{StaticResource BtnGhost}"
                                Margin="6,0,0,0"
                                Content="打开所在文件夹"
                                Command="{Binding OpenFolderCommand}"
                                Visibility="{Binding ShowOpenFolderSecondary, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource Btn}"
                                Content="稍后"
                                Command="{Binding LaterCommand}" />
                        <Button Style="{StaticResource BtnPrimary}"
                                Margin="8,0,0,0"
                                Content="{Binding DownloadButtonText}"
                                Command="{Binding DownloadCommand}"
                                Visibility="{Binding CanDownload, Converter={StaticResource BoolToVisibility}}" />
                        <Button Style="{StaticResource BtnPrimary}"
                                Margin="8,0,0,0"
                                Content="立即安装"
                                Command="{Binding InstallCommand}"
                                Visibility="{Binding ShowInstallButton, Converter={StaticResource BoolToVisibility}}" />
                        <!-- 便携版没有安装步骤：主按钮直接打开文件夹 -->
                        <Button Style="{StaticResource BtnPrimary}"
                                Margin="8,0,0,0"
                                Content="打开所在文件夹"
                                Command="{Binding OpenFolderCommand}"
                                Visibility="{Binding ShowOpenFolderPrimary, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</views:DialogWindow>
