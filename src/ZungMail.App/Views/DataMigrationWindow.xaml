<views:DialogWindow x:Class="ZungMail.App.Views.DataMigrationWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:ZungMail.App.Views"
                    Title="数据迁移"
                    Width="560"
                    Height="268"
                    ResizeMode="NoResize"
                    Background="{DynamicResource WindowBackgroundBrush}"
                    FontFamily="{StaticResource AppFont}"
                    FontSize="13">

    <Border BorderBrush="{DynamicResource RuleStrongBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 标题栏：迁移期间不允许关闭 -->
            <Border Grid.Row="0"
                    Background="{DynamicResource ChromeBrush}"
                    BorderBrush="{DynamicResource RuleBrush}"
                    BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <Border Width="20" Height="20" CornerRadius="6" Background="{DynamicResource BrandMarkBrush}">
                        <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IcoDatabase}" Stroke="White" />
                    </Border>
                    <TextBlock Text="正在迁移数据目录"
                               FontWeight="SemiBold"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource InkBrush}" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="1" Margin="20,16,20,16">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource LabelText}"
                               Width="44"
                               Text="从" />
                    <TextBlock x:Name="SourceText"
                               Style="{StaticResource MutedText}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Style="{StaticResource LabelText}"
                               Width="44"
                               Text="到" />
                    <TextBlock x:Name="TargetText"
                               Style="{StaticResource MutedText}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Grid Margin="0,16,0,0">
                    <TextBlock x:Name="StageText"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource InkBrush}"
                               Text="准备中…" />
                    <TextBlock x:Name="PercentText"
                               HorizontalAlignment="Right"
                               Style="{StaticResource MutedText}"
                               Text="0%" />
                </Grid>

                <ProgressBar x:Name="Progress" Height="8" Margin="0,8,0,0" Minimum="0" Maximum="100" Value="0" />

                <TextBlock x:Name="DetailText"
                           Style="{StaticResource MutedText}"
                           Margin="0,10,0,0"
                           TextWrapping="Wrap"
                           Height="34"
                           Text="正在检查目标目录…" />

                <TextBlock Style="{StaticResource MutedText}"
                           Margin="0,8,0,0"
                           FontSize="11.5"
                           TextWrapping="Wrap"
                           Text="迁移只复制数据，原目录会完整保留。期间请勿关闭客户端或拔出磁盘。" />

                <TextBlock Style="{StaticResource MutedText}"
                           Margin="0,2,0,0"
                           FontSize="11.5"
                           TextWrapping="Wrap"
                           Text="首次迁移数据较多时可能需要几十秒。" />
            </StackPanel>
        </Grid>
    </Border>
</views:DialogWindow>
