<views:DialogWindow x:Class="ZungMail.App.Views.AddressBookWindow"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:views="clr-namespace:ZungMail.App.Views"
                     Title="通讯录"
                     Width="900"
                     Height="640"
                     MinWidth="760"
                     MinHeight="520"
                     ResizeMode="CanResize"
                     Background="{DynamicResource WindowBackgroundBrush}"
                     FontFamily="{StaticResource AppFont}"
                     FontSize="13">

    <!-- CardTitle / RowCheckBox 在 SettingsWindow 中是窗口局部资源；地址簿单独定义，避免跨窗口 StaticResource 解析崩溃。 -->
    <views:DialogWindow.Resources>
        <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource PageTitle}">
            <Setter Property="FontSize" Value="13.5" />
        </Style>
        <Style x:Key="RowCheckBox" TargetType="CheckBox" BasedOn="{StaticResource AppCheckBox}">
            <Setter Property="Margin" Value="0,7,0,0" />
        </Style>
    </views:DialogWindow.Resources>

    <Border BorderBrush="{DynamicResource RuleStrongBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0"
                    Background="{DynamicResource ChromeBrush}"
                    BorderBrush="{DynamicResource RuleBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="OnTitleBarMouseDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                        <Border Width="20" Height="20" CornerRadius="6" Background="{DynamicResource BrandMarkBrush}">
                            <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IcoUsers}" Stroke="White" />
                        </Border>
                        <TextBlock Text="通讯录"
                                   FontWeight="SemiBold"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource InkBrush}" />
                    </StackPanel>
                    <Button Style="{StaticResource WinBtnClose}"
                            HorizontalAlignment="Right"
                            Command="{x:Static SystemCommands.CloseWindowCommand}"
                            CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                            ToolTip="关闭">
                        <Path Style="{StaticResource IconPathSmall}"
                              Data="{StaticResource IcoClose}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </Grid>
            </Border>

            <!-- 内容：左列表 + 右编辑 -->
            <Grid Grid.Row="1" Margin="14,12,14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{DynamicResource ReaderBrush}"
                        BorderBrush="{DynamicResource RuleBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 搜索框：放大镜 + 水印 + 一键清空，和主界面搜索保持一致的观感 -->
                        <Border Grid.Row="0"
                                Height="38"
                                CornerRadius="9"
                                Background="{DynamicResource ListBrush}"
                                BorderBrush="{DynamicResource RuleStrongBrush}"
                                BorderThickness="1">
                            <Grid>
                                <TextBox x:Name="ContactSearchBox"
                                         Style="{StaticResource AppTextBox}"
                                         Height="36"
                                         Padding="32,0,30,0"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         VerticalContentAlignment="Center"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="按姓名或邮箱搜索联系人">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Escape" Command="{Binding ClearSearchCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>

                                <Path Style="{StaticResource IconPathSmall}"
                                      Data="{StaticResource IcoSearch}"
                                      Stroke="{DynamicResource MutedBrush}"
                                      HorizontalAlignment="Left"
                                      Margin="11,0,0,0"
                                      VerticalAlignment="Center"
                                      IsHitTestVisible="False" />

                                <TextBlock Text="搜索姓名或邮箱"
                                           IsHitTestVisible="False"
                                           Margin="32,0,30,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedBrush}">
                                    <TextBlock.Style>
                                        <!-- 只在「无内容且未聚焦」时显示水印：聚焦后让位给光标 -->
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Text, ElementName=ContactSearchBox}" Value="" />
                                                        <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=ContactSearchBox}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <Button Style="{StaticResource IconBtn}"
                                        Width="20"
                                        Height="20"
                                        HorizontalAlignment="Right"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        Command="{Binding ClearSearchCommand}"
                                        ToolTip="清除搜索"
                                        Visibility="{Binding Text, ElementName=ContactSearchBox, Converter={StaticResource NotEmptyToVisibility}}">
                                    <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IcoClose}" />
                                </Button>
                            </Grid>
                        </Border>

                        <ListBox Grid.Row="1"
                                 Margin="0,8,0,0"
                                 Style="{StaticResource AppListBox}"
                                 ItemContainerStyle="{StaticResource PanelListItem}"
                                 ItemsSource="{Binding Contacts}"
                                 SelectedItem="{Binding Selected, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Width="30"
                                                Height="30"
                                                CornerRadius="15"
                                                Background="{Binding AvatarColor, Converter={StaticResource HexToBrush}}">
                                            <TextBlock Text="{Binding Initial}"
                                                       Foreground="White"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Display}"
                                                       Foreground="{DynamicResource InkBrush}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Style="{StaticResource MutedText}"
                                                       Margin="0,2,0,0"
                                                       Text="{Binding Email}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <Path Grid.Column="2"
                                              Width="14"
                                              Height="14"
                                              VerticalAlignment="Center"
                                              Style="{StaticResource IconPathSmall}"
                                              Data="{StaticResource IcoCheck}"
                                              Stroke="{DynamicResource OkDotBrush}"
                                              Visibility="{Binding IsWhitelisted, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- 分页：联系人多时按 50 条一页，只有一页时整条收起 -->
                        <Grid Grid.Row="2"
                              Margin="0,8,0,0"
                              Visibility="{Binding ShowPager, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource MutedText}"
                                       VerticalAlignment="Center"
                                       Text="{Binding PageInfo}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource Btn}"
                                        MinWidth="64"
                                        Content="上一页"
                                        Command="{Binding PreviousPageCommand}"
                                        IsEnabled="{Binding CanGoPrevious}" />
                                <Button Style="{StaticResource Btn}"
                                        MinWidth="64"
                                        Margin="8,0,0,0"
                                        Content="下一页"
                                        Command="{Binding NextPageCommand}"
                                        IsEnabled="{Binding CanGoNext}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="联系人信息" />

                            <TextBlock Style="{StaticResource LabelText}" Margin="0,12,0,0" Text="姓名" />
                            <TextBox Style="{StaticResource AppTextBox}"
                                     Margin="0,5,0,0"
                                     Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Style="{StaticResource LabelText}" Margin="0,10,0,0" Text="邮箱" />
                            <TextBox Style="{StaticResource AppTextBox}"
                                     Margin="0,5,0,0"
                                     Text="{Binding EditEmail, UpdateSourceTrigger=PropertyChanged}" />

                            <CheckBox Style="{StaticResource RowCheckBox}"
                                      Margin="0,12,0,0"
                                      Content="加入白名单（永不判为垃圾邮件）"
                                      IsChecked="{Binding EditWhitelisted}" />

                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Style="{StaticResource BtnPrimary}"
                                        Content="保存联系人"
                                        Command="{Binding SaveCommand}" />
                                <Button Style="{StaticResource Btn}"
                                        Margin="8,0,0,0"
                                        Content="新建"
                                        Command="{Binding NewContactCommand}" />
                                <Button Style="{StaticResource Btn}"
                                        Margin="8,0,0,0"
                                        Content="删除"
                                        Command="{Binding DeleteCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="操作" />
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Style="{StaticResource Btn}"
                                        Content="写邮件给该联系人"
                                        Command="{Binding ComposeToCommand}" />
                                <Button Style="{StaticResource Btn}"
                                        Margin="8,0,0,0"
                                        Content="切换白名单"
                                        Command="{Binding ToggleWhitelistCommand}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Style="{StaticResource Btn}"
                                        Content="导入联系人…"
                                        Command="{Binding ImportCommand}" />
                                <Button Style="{StaticResource Btn}"
                                        Margin="8,0,0,0"
                                        Content="导出联系人…"
                                        Command="{Binding ExportCommand}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource MutedText}"
                                       Margin="0,12,0,0"
                                       TextWrapping="Wrap"
                                       Text="提示：白名单只影响本地垃圾邮件判定；导入只刷新姓名，不计入往来次数。" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- 状态栏 -->
            <Border Grid.Row="2"
                    Background="{DynamicResource ChromeBrush}"
                    BorderBrush="{DynamicResource RuleBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="14,8">
                <Grid>
                    <TextBlock Style="{StaticResource MutedText}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding StatusText}" />
                    <Button Style="{StaticResource Btn}"
                            HorizontalAlignment="Right"
                            Content="关闭"
                            Click="OnCloseClick" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</views:DialogWindow>
