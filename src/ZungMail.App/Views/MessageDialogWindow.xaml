<views:DialogWindow x:Class="ZungMail.App.Views.MessageDialogWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:ZungMail.App.Views"
                    Title="ZungMail"
                    Width="476"
                    SizeToContent="Height"
                    ResizeMode="NoResize"
                    Background="{DynamicResource WindowBackgroundBrush}"
                    FontFamily="{StaticResource AppFont}"
                    FontSize="13"
                    PreviewKeyDown="OnWindowPreviewKeyDown">

    <Border BorderBrush="{DynamicResource RuleStrongBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题栏：与其它自绘窗口一致，46px + 右侧关闭按钮 -->
            <Border Grid.Row="0"
                    Background="{DynamicResource ChromeBrush}"
                    BorderBrush="{DynamicResource RuleBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="OnTitleBarMouseDown">
                <Grid>
                    <TextBlock x:Name="HeaderText"
                               Margin="16,0,52,0"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource InkBrush}"
                               TextTrimming="CharacterEllipsis" />

                    <Button Style="{StaticResource WinBtnClose}"
                            HorizontalAlignment="Right"
                            Click="OnDismissClick"
                            ToolTip="关闭">
                        <Path Style="{StaticResource IconPathSmall}"
                              Data="{StaticResource IcoClose}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </Grid>
            </Border>

            <!-- 正文：左侧色块图标 + 文案；detail 作为次级说明放在灰底块里 -->
            <Grid Grid.Row="1" Margin="24,22,24,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="IconHost"
                        Width="42"
                        Height="42"
                        CornerRadius="12"
                        VerticalAlignment="Top"
                        Background="{DynamicResource AccentSoftBrush}">
                    <Path x:Name="IconGlyph"
                          Width="20"
                          Height="20"
                          Stretch="Uniform"
                          StrokeThickness="1.7"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Data="{StaticResource IcoQuestion}"
                          Stroke="{DynamicResource AccentBrush}" />
                </Border>

                <StackPanel x:Name="MessageStack" Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="MessageText"
                               FontSize="13.5"
                               LineHeight="21"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource InkBrush}" />

                    <Border x:Name="DetailHost"
                            Margin="0,12,0,0"
                            Padding="10,8"
                            CornerRadius="6"
                            Background="{DynamicResource HoverBrush}"
                            Visibility="Collapsed">
                        <TextBlock x:Name="DetailText"
                                   LineHeight="18"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedBrush}" />
                    </Border>
                </StackPanel>
            </Grid>

            <!-- 按钮区：右侧对齐，主操作最右，Esc = 取消 -->
            <Border Grid.Row="2"
                    Padding="16,10"
                    BorderBrush="{DynamicResource RuleBrush}"
                    BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton"
                            Style="{StaticResource Btn}"
                            Margin="0,0,8,0"
                            Visibility="Collapsed"
                            Click="OnCancelClick" />
                    <Button x:Name="SecondaryButton"
                            Style="{StaticResource Btn}"
                            Margin="0,0,8,0"
                            Visibility="Collapsed"
                            Click="OnSecondaryClick" />
                    <Button x:Name="PrimaryButton"
                            Style="{StaticResource BtnPrimary}"
                            MinWidth="76"
                            IsDefault="True"
                            Click="OnPrimaryClick" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</views:DialogWindow>
