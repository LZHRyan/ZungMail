<Window x:Class="ZungMail.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:ZungMail.App.ViewModels"
        xmlns:views="clr-namespace:ZungMail.App.Views"
        xmlns:ct="clr-namespace:ZungMail.App.Controls"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="ZungMail"
         Icon="pack://application:,,,/Assets/Brand/ZungMail.ico"
        Width="1400"
        Height="880"
        MinWidth="1080"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        FocusManager.FocusedElement="{Binding ElementName=MailList}"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{StaticResource AppFont}"
        FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="OnWindowPreviewKeyDown">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0,0,0,1"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Find" Executed="OnFindExecuted" />
    </Window.CommandBindings>

    <Window.InputBindings>
        <KeyBinding Command="{Binding ComposeCommand}" Key="N" Modifiers="Control" />
        <KeyBinding Command="{Binding RefreshCommand}" Key="R" Modifiers="Control" />
        <KeyBinding Command="{Binding RefreshCommand}" Key="F5" />
        <KeyBinding Command="ApplicationCommands.Find" Key="F" Modifiers="Control" />
    </Window.InputBindings>

    <Window.Resources>

        <!-- 邮件行右键菜单：使用与主界面一致的紧凑卡片样式，避免 WPF 默认菜单的宽左侧留白。 -->
        <Style x:Key="MailContextMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource RuleStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MailContextMenuItem" TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="MenuItemBackground"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- 勾选列：只有 IsCheckable 的菜单项才占位（如「+」里的搜索条件），其它菜单不受影响 -->
                                <Grid x:Name="CheckSlot"
                                      Grid.Column="0"
                                      Width="16"
                                      Margin="0,0,6,0"
                                      VerticalAlignment="Center"
                                      Visibility="Collapsed">
                                    <Path x:Name="CheckMark"
                                          Style="{StaticResource IconPathSmall}"
                                          Width="12"
                                          Height="12"
                                          Data="{StaticResource IcoCheck}"
                                          Stroke="{DynamicResource AccentBrush}"
                                          StrokeThickness="2.2"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Visibility="Collapsed" />
                                </Grid>

                                <ContentPresenter Grid.Column="1"
                                                  Content="{TemplateBinding Header}"
                                                  ContentTemplate="{TemplateBinding HeaderTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="MenuItemBackground" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                            <Trigger Property="IsCheckable" Value="True">
                                <Setter TargetName="CheckSlot" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MailContextMenuDangerItem" TargetType="MenuItem" BasedOn="{StaticResource MailContextMenuItem}">
            <Setter Property="Foreground" Value="{DynamicResource ErrorDotBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="MenuItemBackground"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Content="{TemplateBinding Header}"
                                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                                              ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="MenuItemBackground" Property="Background" Value="{DynamicResource CriticalSoftBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MailContextMenuSeparator" TargetType="Separator">
            <Setter Property="Margin" Value="8,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="{DynamicResource RuleBrush}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 侧栏分区卡片：圆角 + 1px 描边 + 比侧栏略亮的底色，让「快捷视图 / 标签」成为有边界的独立区块 -->
        <Style x:Key="SidebarCard" TargetType="Border">
            <Setter Property="Margin" Value="8,0,8,8" />
            <Setter Property="Padding" Value="0,4,0,6" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource RuleBrush}" />
            <Setter Property="Background" Value="{DynamicResource ListBrush}" />
        </Style>

        <!-- 快捷视图条目 -->
        <DataTemplate x:Key="QuickViewTemplate" DataType="{x:Type vm:QuickViewItem}">
            <Button Style="{StaticResource SidebarRowButton}"
                    Command="{Binding DataContext.SelectQuickViewCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}">
                <Grid>
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="6" />
                    <StackPanel Orientation="Horizontal" Margin="14,0,12,0" VerticalAlignment="Center">
                        <Path x:Name="Ico"
                              Style="{StaticResource IconPathSmall}"
                              Stroke="{DynamicResource Ink2Brush}"
                              Data="{Binding IconKey, Converter={StaticResource ResourceKey}}" />
                        <TextBlock x:Name="Txt"
                                   Text="{Binding Title}"
                                   Margin="9,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Ink2Brush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SelectedBrush}" />
                    <Setter TargetName="Ico" Property="Stroke" Value="{DynamicResource AccentBrush}" />
                    <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                    <Setter TargetName="Txt" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 文件夹条目 -->
        <DataTemplate x:Key="FolderTemplate" DataType="{x:Type vm:FolderNode}">
            <Grid x:Name="FolderDropTarget"
                  AllowDrop="{Binding CanReceiveMailDrop}"
                  Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                  DragOver="OnFolderDragOver"
                  DragLeave="OnFolderDragLeave"
                  Drop="OnFolderDrop">
                <Border x:Name="DropHighlight"
                        Background="{DynamicResource AccentSoftBrush}"
                        BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Visibility="Collapsed" />
                <Button Style="{StaticResource SidebarRowButton}"
                        Command="{Binding DataContext.SelectFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}">
                    <Button.ContextMenu>
                        <ContextMenu Style="{StaticResource MailContextMenu}"
                                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Style="{StaticResource MailContextMenuItem}"
                                      Header="新建子文件夹"
                                      Command="{Binding PlacementTarget.Tag.CreateFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding}" />
                            <MenuItem Style="{StaticResource MailContextMenuItem}"
                                      Header="整理此文件夹…"
                                      ToolTip="打开历史邮件清理，范围默认限定为这个文件夹"
                                      Command="{Binding PlacementTarget.Tag.OpenCleanupForFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding}" />
                            <Separator Style="{StaticResource MailContextMenuSeparator}"
                                       Visibility="{Binding IsUserFolder, Converter={StaticResource BoolToVisibility}}" />
                            <MenuItem Style="{StaticResource MailContextMenuItem}"
                                      Header="重命名"
                                      Command="{Binding PlacementTarget.Tag.RenameFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding}"
                                      Visibility="{Binding IsUserFolder, Converter={StaticResource BoolToVisibility}}" />
                            <MenuItem Style="{StaticResource MailContextMenuDangerItem}"
                                      Header="删除文件夹"
                                      Command="{Binding PlacementTarget.Tag.DeleteFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding}"
                                      Visibility="{Binding IsUserFolder, Converter={StaticResource BoolToVisibility}}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                    <Grid>
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="6" />
                        <Grid Margin="{Binding IndentMargin}" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Path x:Name="Ico"
                                      Style="{StaticResource IconPathSmall}"
                                      Stroke="{DynamicResource Ink2Brush}"
                                      Data="{Binding IconKey, Converter={StaticResource ResourceKey}}" />
                                <TextBlock x:Name="Txt"
                                           Text="{Binding Title}"
                                           Margin="9,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource Ink2Brush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Background="{DynamicResource AccentSoftBrush}"
                                    CornerRadius="8"
                                    Padding="6,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding UnreadCount, Converter={StaticResource NotEmptyToVisibility}}">
                                <TextBlock Text="{Binding UnreadCount}"
                                           FontSize="11"
                                           Foreground="{DynamicResource AccentBrush}" />
                            </Border>
                        </Grid>
                    </Grid>
                </Button>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SelectedBrush}" />
                    <Setter TargetName="Ico" Property="Stroke" Value="{DynamicResource AccentBrush}" />
                    <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                    <Setter TargetName="Txt" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 账户分组 -->
        <DataTemplate x:Key="AccountTemplate" DataType="{x:Type vm:AccountNode}">
            <StackPanel Margin="0,6,0,2" Opacity="{Binding NodeOpacity}">
                <Button Style="{StaticResource SidebarRowButton}"
                        Command="{Binding ToggleExpandCommand}"
                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                    <Button.ContextMenu>
                        <ContextMenu Style="{StaticResource MailContextMenu}"
                                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Style="{StaticResource MailContextMenuItem}"
                                      Header="收取(_G)"
                                      ToolTip="{Binding SyncHint}"
                                      Command="{Binding PlacementTarget.Tag.SyncAccountCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding}" />
                            <MenuItem Style="{StaticResource MailContextMenuItem}"
                                      Header="新建文件夹(_T)…"
                                      Command="{Binding PlacementTarget.Tag.CreateFolderForAccountCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding}" />
                            <Separator Style="{StaticResource MailContextMenuSeparator}" />
                            <MenuItem Style="{StaticResource MailContextMenuItem}"
                                      Header="整理文件夹(_I)…"
                                      ToolTip="打开历史邮件清理，范围默认限定为这个账户"
                                      Command="{Binding PlacementTarget.Tag.OpenCleanupForAccountCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding}" />
                            <MenuItem Style="{StaticResource MailContextMenuItem}"
                                      Header="导入邮件(_E)…"
                                      ToolTip="把 Foxmail / Outlook 导出的 .eml 导入这个账户"
                                      Command="{Binding PlacementTarget.Tag.ImportEmlForAccountCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding}" />
                            <Separator Style="{StaticResource MailContextMenuSeparator}" />
                            <MenuItem Style="{StaticResource MailContextMenuItem}"
                                      Header="设置(_P)…"
                                      Command="{Binding PlacementTarget.Tag.OpenAccountSettingsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                    <Grid Margin="14,0,8,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Border Width="18"
                                    Height="18"
                                    CornerRadius="6"
                                    Background="{Binding Color, Converter={StaticResource HexToBrush}}">
                                <TextBlock Text="{Binding Initials}"
                                           Foreground="White"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding HasAvatar, Converter={StaticResource InverseBoolToVisibility}}" />
                            </Border>
                            <!-- 头像（Gravatar 命中才有）：圆角由 Border 的 Background 裁剪，图像不会溢出 -->
                            <Border Width="18"
                                    Height="18"
                                    CornerRadius="6"
                                    Background="{Binding AvatarBrush}"
                                    Visibility="{Binding HasAvatar, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="9,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource InkBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <!-- 主账户角标：同步与列表都优先它 -->
                            <Border Margin="5,0,0,0"
                                    Padding="5,0"
                                    CornerRadius="7"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource AccentSoftBrush}"
                                    Visibility="{Binding IsPrimary, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="主"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}" />
                            </Border>
                            <TextBlock Text="{Binding StatusSuffix}"
                                       FontSize="11"
                                       Margin="4,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource MutedBrush}"
                                       Visibility="{Binding IsEnabled, Converter={StaticResource InverseBoolToVisibility}}" />
                        </StackPanel>
                        <!-- 单个账户立即同步：多账户时不必等整轮全量同步 -->
                        <Button Grid.Column="2"
                                Style="{StaticResource IconBtn}"
                                Width="22"
                                Height="22"
                                Margin="2,0"
                                IsEnabled="{Binding DataContext.IsSyncing, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBool}}"
                                Command="{Binding DataContext.SyncAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                ToolTip="立即同步此账户">
                            <Path Style="{StaticResource IconPathSmall}"
                                  Data="{StaticResource IcoRefresh}"
                                  Stroke="{DynamicResource MutedBrush}" />
                        </Button>
                        <Path x:Name="Chev"
                              Grid.Column="3"
                              Style="{StaticResource IconPathSmall}"
                              Data="{StaticResource IcoChevron}"
                              Stroke="{DynamicResource MutedBrush}"
                              RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <RotateTransform Angle="-90" />
                            </Path.RenderTransform>
                        </Path>
                    </Grid>
                </Button>
                <ItemsControl ItemsSource="{Binding Folders}"
                              ItemTemplate="{StaticResource FolderTemplate}"
                              Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter TargetName="Chev" Property="RenderTransform">
                        <Setter.Value>
                            <RotateTransform Angle="0" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 邮件列表行 -->
        <DataTemplate x:Key="MailRowTemplate" DataType="{x:Type vm:MailRow}">
            <!-- 整行一个悬停提示：内容由 MailRow.RowTooltip 一次算好，行内不再各挂 ToolTip -->
            <Grid ToolTip="{Binding RowTooltip}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Ellipse Grid.Column="0"
                         Width="7"
                         Height="7"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"
                         Fill="{DynamicResource AccentBrush}"
                         Visibility="{Binding IsUnread, Converter={StaticResource BoolToVisibility}}" />

                <StackPanel Grid.Column="1" Margin="6,0,10,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock x:Name="FromText"
                                       Text="{Binding From}"
                                       MaxWidth="176"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Ink2Brush}"
                                       TextTrimming="CharacterEllipsis" />
                            <Border Background="{DynamicResource BadgeGrayBackgroundBrush}"
                                    CornerRadius="8"
                                    Padding="5,0"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsThread, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding ThreadCountDisplay}"
                                           FontSize="11"
                                           Foreground="{DynamicResource BadgeGrayBrush}" />
                            </Border>
                            <!-- 疑似钓鱼：发件人域名与本机企业域名高度相似，红底白字，比「陌生」的琥珀更强 -->
                            <Border Background="{DynamicResource CriticalBrush}"
                                    CornerRadius="4"
                                    Padding="4,0"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding PhishingBadgeVisible, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="疑似钓鱼"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="White" />
                            </Border>
                            <!-- 退信：投递失败退回，红框标出（比「陌生」更紧急，排在它前面） -->
                            <Border Background="{DynamicResource CriticalSoftBrush}"
                                    BorderBrush="{DynamicResource CriticalBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="4,0"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding BounceBadgeVisible, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="退信"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource CriticalBrush}" />
                            </Border>
                            <!-- 陌生发件人：首次收到该地址来信，用警告色（琥珀）与「异常邮件」的红色角标区分 -->
                            <Border Background="{DynamicResource WarningSoftBrush}"
                                    BorderBrush="{DynamicResource WarningBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="4,0"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding StrangerBadgeVisible, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="陌生"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource WarningBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="DateText"
                                   Grid.Column="1"
                                   Text="{Binding Date}"
                                   Style="{StaticResource MutedText}"
                                   Margin="6,0,0,0" />
                    </Grid>
                    <Grid Margin="0,3,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- 异常邮件（查验 / 甩柜 / 延误）红色角标：这类必须第一眼看到 -->
                            <Border Grid.Column="0"
                                    Background="{Binding IndustryTypeColor, Converter={StaticResource HexToBrush}}"
                                    CornerRadius="4"
                                    Padding="4,0"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding ShowExceptionBadge, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding IndustryTypeShort}"
                                           FontSize="9.5"
                                           FontWeight="Bold"
                                           Foreground="White" />
                            </Border>
                            <TextBlock x:Name="SubjectText"
                                       Grid.Column="1"
                                       Text="{Binding Subject}"
                                       FontSize="13"
                                       Foreground="{DynamicResource InkBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>

                        <!-- 箱型箱量：询价/订舱邮件最先要看的量（1×40HC） -->
                        <Border Grid.Column="1"
                                Margin="6,0,0,0"
                                Padding="5,0"
                                CornerRadius="5"
                                VerticalAlignment="Center"
                                Background="{DynamicResource SidebarBrush}"
                                BorderBrush="{DynamicResource RuleBrush}"
                                BorderThickness="1"
                                Visibility="{Binding HasBoxes, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding BoxesText}"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource InkBrush}" />
                        </Border>

                        <!-- 货代业务单号：一票货的主键（Job / SO / B/L / 箱号），比主题更可靠 -->
                        <Grid Grid.Column="2"
                              Margin="6,0,0,0"
                              MaxWidth="118"
                              VerticalAlignment="Center"
                              Visibility="{Binding HasReference, Converter={StaticResource BoolToVisibility}}">
                            <Border CornerRadius="6"
                                    Opacity="0.16"
                                    Background="{Binding ReferenceColor, Converter={StaticResource HexToBrush}}" />
                            <Border CornerRadius="6"
                                    BorderThickness="1"
                                    Opacity="0.32"
                                    BorderBrush="{Binding ReferenceColor, Converter={StaticResource HexToBrush}}" />
                            <TextBlock Text="{Binding ReferenceDisplay}"
                                       Margin="6,1"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{Binding ReferenceColor, Converter={StaticResource HexToBrush}}" />
                        </Grid>
                    </Grid>
                    <TextBlock Text="{Binding Preview}"
                               Style="{StaticResource MutedText}"
                               Margin="0,3,0,0"
                               TextTrimming="CharacterEllipsis" />

                    <!-- 单个标签：沿用原胶囊（实心标签色底 + 白字） -->
                    <Border Style="{StaticResource TagChip}"
                            HorizontalAlignment="Left"
                            Background="{Binding SingleTagColor, Converter={StaticResource HexToBrush}}"
                            Visibility="{Binding HasSingleTag, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource TagChipText}" Text="{Binding SingleTagName}" />
                    </Border>

                    <!-- 多个标签：一粒胶囊按标签个数分段着色，每段实心标签色 + 白字（首末段各带半圆角） -->
                    <Border Height="26"
                            CornerRadius="13"
                            HorizontalAlignment="Left"
                            Visibility="{Binding HasMultipleTags, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl ItemsSource="{Binding TagPieces}" VerticalAlignment="Stretch" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Color, Converter={StaticResource HexToBrush}}"
                                            CornerRadius="{Binding Corner}"
                                            Padding="9,0"
                                            VerticalAlignment="Stretch">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   Foreground="White"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>

                <Grid Grid.Column="2" Width="34" VerticalAlignment="Center">
                    <Path Style="{StaticResource IconPathSmall}"
                          Data="{StaticResource IcoPaperclip}"
                          Stroke="{DynamicResource MutedBrush}"
                          HorizontalAlignment="Left"
                          Visibility="{Binding HasAttachment, Converter={StaticResource BoolToVisibility}}" />
                    <Path Style="{StaticResource IconPathSmall}"
                          Data="{StaticResource IcoStar}"
                          Stroke="{DynamicResource WarnDotBrush}"
                          Fill="{DynamicResource WarnDotBrush}"
                          HorizontalAlignment="Right"
                          Visibility="{Binding IsStarred, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsUnread}" Value="True">
                    <Setter TargetName="FromText" Property="Foreground" Value="{DynamicResource InkBrush}" />
                    <!-- 发件人基线已是 SemiBold，未读再进一档才看得出差别 -->
                    <Setter TargetName="FromText" Property="FontWeight" Value="Bold" />
                    <Setter TargetName="SubjectText" Property="FontWeight" Value="SemiBold" />
                    <Setter TargetName="DateText" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 附件卡片：类型图标 + 文件名 + 大小；双击打开（单击只选中），右键下载 / 预览 / 复制 / 另存为 / 定位文件 -->
        <DataTemplate x:Key="AttachmentTemplate">
            <Button Style="{StaticResource AttachmentCard}"
                    Margin="0,0,8,8"
                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                    ToolTip="{Binding LocalPath}">
                <Button.InputBindings>
                    <!-- 双击才打开预览：单击留给选中，避免误触把文件弹出去 -->
                    <MouseBinding MouseAction="LeftDoubleClick"
                                  Command="{Binding DataContext.PreviewAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}" />
                    <KeyBinding Key="Enter"
                                Command="{Binding DataContext.PreviewAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                    <KeyBinding Key="C"
                                Modifiers="Ctrl"
                                Command="{Binding DataContext.CopyAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                </Button.InputBindings>
                <Button.ContextMenu>
                    <ContextMenu Style="{StaticResource MailContextMenu}"
                                 DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <!-- 「仅收取正文」账户的附件没落盘，需要单独下载 -->
                        <MenuItem Style="{StaticResource MailContextMenuItem}"
                                  Header="下载附件"
                                  Command="{Binding PlacementTarget.Tag.DownloadAttachmentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}"
                                  Visibility="{Binding IsDownloaded, Converter={StaticResource InverseBoolToVisibility}}" />
                        <MenuItem Style="{StaticResource MailContextMenuItem}"
                                  Header="预览"
                                  Command="{Binding PlacementTarget.Tag.PreviewAttachmentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}" />
                        <MenuItem Style="{StaticResource MailContextMenuItem}"
                                  Header="用本机程序打开"
                                  Command="{Binding PlacementTarget.Tag.OpenAttachmentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding LocalPath}" />
                        <MenuItem Style="{StaticResource MailContextMenuItem}"
                                  Header="另存为…"
                                  Command="{Binding PlacementTarget.Tag.SaveAttachmentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}" />
                        <!-- 等价于 Ctrl+C：把附件文件放进剪贴板，可直接粘到资源管理器 / 微信 / 邮件里 -->
                        <MenuItem Style="{StaticResource MailContextMenuItem}"
                                  Header="复制"
                                  InputGestureText="Ctrl+C"
                                  Command="{Binding PlacementTarget.Tag.CopyAttachmentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}" />
                        <Separator Style="{StaticResource MailContextMenuSeparator}" />
                        <MenuItem Style="{StaticResource MailContextMenuItem}"
                                  Header="打开所在文件夹"
                                  Command="{Binding PlacementTarget.Tag.RevealAttachmentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}" />
                    </ContextMenu>
                </Button.ContextMenu>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ct:AttachmentIcon FileName="{Binding FileName}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding FileName}"
                                   FontSize="12.5"
                                   Foreground="{DynamicResource InkBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Style="{StaticResource MutedText}"
                                   Text="{Binding SizeDisplay}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>

        <!-- 邮件列表行：右键菜单，右键时自动选中该行 -->
        <Style x:Key="MailListItemInteractive"
               TargetType="ListBoxItem"
               BasedOn="{StaticResource MailListItem}">
            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu Style="{StaticResource MailContextMenu}"
                                 DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                        <MenuItem Style="{StaticResource MailContextMenuItem}"
                                  Command="{Binding ReplyCommand}"
                                  IsEnabled="{Binding CanReplyOrForward}">
                            <MenuItem.Header><StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IcoReply}" /><TextBlock Text="回复" Margin="10,0,0,0" /></StackPanel></MenuItem.Header>
                        </MenuItem>
                        <MenuItem Style="{StaticResource MailContextMenuItem}"
                                  Command="{Binding ReplyAllCommand}"
                                  IsEnabled="{Binding CanReplyOrForward}">
                            <MenuItem.Header><StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IcoUsers}" /><TextBlock Text="回复全部" Margin="10,0,0,0" /></StackPanel></MenuItem.Header>
                        </MenuItem>
                        <MenuItem Style="{StaticResource MailContextMenuItem}"
                                  Command="{Binding ForwardCommand}"
                                  IsEnabled="{Binding CanReplyOrForward}">
                            <MenuItem.Header><StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IcoForward}" /><TextBlock Text="转发" Margin="10,0,0,0" /></StackPanel></MenuItem.Header>
                        </MenuItem>
                        <MenuItem Style="{StaticResource MailContextMenuItem}"
                                  Command="{Binding ForwardAsAttachmentCommand}"
                                  IsEnabled="{Binding CanReplyOrForward}"
                                  ToolTip="把整封原邮件作为 .eml 附件发出去，正文不带引用">
                            <MenuItem.Header><StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IcoPaperclip}" /><TextBlock Text="作为附件转发" Margin="10,0,0,0" /></StackPanel></MenuItem.Header>
                        </MenuItem>
                        <Separator Style="{StaticResource MailContextMenuSeparator}" />
                        <MenuItem Style="{StaticResource MailContextMenuItem}" Command="{Binding ToggleReadCommand}">
                            <MenuItem.Header><StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IcoMail}" /><TextBlock Text="切换已读 / 未读" Margin="10,0,0,0" /></StackPanel></MenuItem.Header>
                        </MenuItem>
                        <MenuItem Style="{StaticResource MailContextMenuItem}" Command="{Binding ToggleStarCommand}">
                            <MenuItem.Header><StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IcoStar}" /><TextBlock Text="切换星标" Margin="10,0,0,0" /></StackPanel></MenuItem.Header>
                        </MenuItem>
                        <MenuItem Style="{StaticResource MailContextMenuItem}" Command="{Binding ArchiveCommand}">
                            <MenuItem.Header><StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IcoArchive}" /><TextBlock Text="归档" Margin="10,0,0,0" /></StackPanel></MenuItem.Header>
                        </MenuItem>
                        <MenuItem Style="{StaticResource MailContextMenuItem}" Command="{Binding MoveToFolderCommand}">
                            <MenuItem.Header><StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IcoFolder}" /><TextBlock Text="移动到文件夹…" Margin="10,0,0,0" /></StackPanel></MenuItem.Header>
                        </MenuItem>
                        <MenuItem Style="{StaticResource MailContextMenuItem}" Command="{Binding TagSelectedCommand}">
                            <MenuItem.Header><StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IcoArchive}" /><TextBlock Text="打标签…" Margin="10,0,0,0" /></StackPanel></MenuItem.Header>
                        </MenuItem>
                        <MenuItem Style="{StaticResource MailContextMenuItem}" Command="{Binding ToggleTodoCommand}">
                            <MenuItem.Header><StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IcoCheck}" /><TextBlock Text="标记待办…" Margin="10,0,0,0" /></StackPanel></MenuItem.Header>
                        </MenuItem>
                        <MenuItem Style="{StaticResource MailContextMenuItem}"
                                  Command="{Binding CreateFollowUpCommand}"
                                  Visibility="{Binding ShowFreightFollowUps, Converter={StaticResource BoolToVisibility}}">
                            <MenuItem.Header><StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IcoClock}" /><TextBlock Text="等待回复…" Margin="10,0,0,0" /></StackPanel></MenuItem.Header>
                        </MenuItem>                        <MenuItem Style="{StaticResource MailContextMenuItem}" Command="{Binding MarkAsJunkCommand}">
                            <MenuItem.Header><StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IcoJunk}" /><TextBlock Text="标记为垃圾邮件" Margin="10,0,0,0" /></StackPanel></MenuItem.Header>
                        </MenuItem>
                        <MenuItem Style="{StaticResource MailContextMenuItem}" Command="{Binding RestoreToInboxCommand}">
                            <MenuItem.Header><StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IcoInbox}" /><TextBlock Text="恢复到收件箱" Margin="10,0,0,0" /></StackPanel></MenuItem.Header>
                        </MenuItem>
                        <Separator Style="{StaticResource MailContextMenuSeparator}" />
                        <MenuItem Style="{StaticResource MailContextMenuItem}"
                                  Command="{Binding ViewMailSourceCommand}"
                                  ToolTip="查看这封邮件的原始 MIME 源码（离线时显示本地重建版本）">
                            <MenuItem.Header><StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IcoTemplate}" /><TextBlock Text="查看邮件源码" Margin="10,0,0,0" /></StackPanel></MenuItem.Header>
                        </MenuItem>
                        <Separator Style="{StaticResource MailContextMenuSeparator}" />
                        <MenuItem Style="{StaticResource MailContextMenuItem}" Command="{Binding BlockSenderCommand}">
                            <MenuItem.Header><StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IcoJunk}" /><TextBlock Text="将发件人加入黑名单" Margin="10,0,0,0" /></StackPanel></MenuItem.Header>
                        </MenuItem>
                        <MenuItem Style="{StaticResource MailContextMenuItem}" Command="{Binding AllowSenderCommand}">
                            <MenuItem.Header><StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IcoCheck}" /><TextBlock Text="将发件人加入白名单" Margin="10,0,0,0" /></StackPanel></MenuItem.Header>
                        </MenuItem>
                        <Separator Style="{StaticResource MailContextMenuSeparator}" />
                        <MenuItem Style="{StaticResource MailContextMenuDangerItem}" Command="{Binding DeleteMessageCommand}">
                            <MenuItem.Header><StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IcoTrash}" Stroke="{DynamicResource ErrorDotBrush}" /><TextBlock Text="删除" Margin="10,0,0,0" /></StackPanel></MenuItem.Header>
                        </MenuItem>
                    </ContextMenu>
                </Setter.Value>
            </Setter>
            <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnMailItemRightButtonDown" />
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnMailItemMouseDown" />
            <EventSetter Event="MouseMove" Handler="OnMailItemMouseMove" />
        </Style>

        <!-- 右侧上下文侧栏的小卡片条目：浅底 + 浅描边 + 圆角，悬停加深、选中用强调色 -->
        <Style x:Key="SidebarCardItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card"
                                Background="{DynamicResource ListBrush}"
                                BorderBrush="{DynamicResource RuleBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource HoverBrush}" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource RuleStrongBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnMailItemRightButtonDown" />
        </Style>

        <!-- 往来邮件卡片：右键可打开该封邮件；内边距由模板自己排（左栏留给未读竖标） -->
        <Style x:Key="CorrespondenceCardItem" TargetType="ListBoxItem" BasedOn="{StaticResource SidebarCardItem}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu Style="{StaticResource MailContextMenu}"
                                 DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Style="{StaticResource MailContextMenuItem}"
                                  Header="打开邮件"
                                  Command="{Binding PlacementTarget.Tag.ShowCorrespondenceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}" />
                        <Separator Style="{StaticResource MailContextMenuSeparator}" />
                        <MenuItem Style="{StaticResource MailContextMenuDangerItem}"
                                  Header="删除"
                                  Command="{Binding PlacementTarget.Tag.DeleteCorrespondenceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}" />
                    </ContextMenu>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 发件人附件卡片：右键操作对齐 Foxmail（打开 / 打开方式 / 另存 / 定位） -->
        <Style x:Key="SenderAttachmentCardItem" TargetType="ListBoxItem" BasedOn="{StaticResource SidebarCardItem}">
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu Style="{StaticResource MailContextMenu}"
                                 DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Style="{StaticResource MailContextMenuItem}"
                                  Header="打开附件"
                                  Command="{Binding PlacementTarget.Tag.OpenSenderAttachmentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}" />
                        <MenuItem Style="{StaticResource MailContextMenuItem}"
                                  Header="打开邮件"
                                  Command="{Binding PlacementTarget.Tag.OpenSenderAttachmentMailCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}" />
                        <MenuItem Style="{StaticResource MailContextMenuItem}"
                                  Header="打开方式…"
                                  Command="{Binding PlacementTarget.Tag.OpenPathWithCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding LocalPath}" />
                        <MenuItem Style="{StaticResource MailContextMenuItem}"
                                  Header="另存为…"
                                  Command="{Binding PlacementTarget.Tag.SavePathAsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding LocalPath}" />
                        <Separator Style="{StaticResource MailContextMenuSeparator}" />
                        <MenuItem Style="{StaticResource MailContextMenuItem}"
                                  Header="打开所在文件夹"
                                  Command="{Binding PlacementTarget.Tag.RevealPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding LocalPath}" />
                    </ContextMenu>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            地址单元（收件人 / 抄送 / 密送共用）：悬停高亮、左键弹出联系人卡片、
            右键「写邮件 / 复制地址 / 查看往来邮件 / 在通讯录中查看」。
            三个地址行都用它，避免抄送退化成不可点的纯文本。
        -->
        <DataTemplate x:Key="AddressChipTemplate">
            <Grid>
                <Border x:Name="Chip" Padding="4,2" Margin="0,0,2,0" CornerRadius="6" Cursor="Hand"
                        VerticalAlignment="Center"
                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                        MouseLeftButtonUp="OnAddressChipClick">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border.ContextMenu>
                        <ContextMenu Style="{StaticResource MailContextMenu}"
                                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Style="{StaticResource MailContextMenuItem}" Header="写邮件"
                                      Command="{Binding PlacementTarget.Tag.ComposeToAddressCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding Address}" />
                            <MenuItem Style="{StaticResource MailContextMenuItem}" Header="复制地址"
                                      Command="{Binding PlacementTarget.Tag.CopyAddressCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding Address}" />
                            <MenuItem Style="{StaticResource MailContextMenuItem}" Header="查看往来邮件"
                                      Command="{Binding PlacementTarget.Tag.SearchBySenderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding Address}" />
                            <Separator Style="{StaticResource MailContextMenuSeparator}" />
                            <MenuItem Style="{StaticResource MailContextMenuItem}" Header="在通讯录中查看"
                                      Command="{Binding PlacementTarget.Tag.OpenAddressBookCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        </ContextMenu>
                    </Border.ContextMenu>
                    <TextBlock Text="{Binding Display}" FontSize="12.5" Foreground="{DynamicResource Ink2Brush}" TextTrimming="CharacterEllipsis" MaxWidth="260" />
                </Border>
                <Popup PlacementTarget="{Binding ElementName=Chip}" Placement="Bottom" StaysOpen="False"
                       AllowsTransparency="True" IsOpen="{Binding IsCardOpen, Mode=TwoWay}">
                    <Border Margin="0,6,0,0" Width="280" Padding="14" CornerRadius="8"
                            Background="{DynamicResource WindowBackgroundBrush}"
                            BorderBrush="{DynamicResource RuleStrongBrush}" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.18" Color="#0F172A" />
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="{Binding GroupLabel}" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                            <TextBlock Text="{Binding Display}" FontSize="13.5" FontWeight="SemiBold" Margin="0,4,0,0"
                                       Foreground="{DynamicResource InkBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Address}" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Style="{StaticResource BtnPrimary}" Padding="12,0" Content="写邮件"
                                        Command="{Binding PlacementTarget.Tag.ComposeToAddressCommand, RelativeSource={RelativeSource AncestorType=Popup}}" CommandParameter="{Binding Address}" />
                                <Button Style="{StaticResource BtnGhost}" Padding="12,0" Margin="6,0,0,0" Content="相关邮件"
                                        Command="{Binding PlacementTarget.Tag.SearchBySenderCommand, RelativeSource={RelativeSource AncestorType=Popup}}" CommandParameter="{Binding Address}" />
                                <Button Style="{StaticResource BtnGhost}" Padding="12,0" Margin="6,0,0,0" Content="复制地址"
                                        Command="{Binding PlacementTarget.Tag.CopyAddressCommand, RelativeSource={RelativeSource AncestorType=Popup}}" CommandParameter="{Binding Address}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </DataTemplate>

    </Window.Resources>

    <Border x:Name="RootBorder"
            Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource RuleStrongBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <!-- 标题栏高度由下面 Border 的 Height 决定（搜索框下移后从 46 收到 38），不再写死行高 -->
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ============ 标题栏（只留品牌与窗口按钮，搜索框已下移到工具栏） ============ -->
            <Border Grid.Row="0"
                    Height="32"
                    Background="{DynamicResource ChromeBrush}"
                    BorderBrush="{DynamicResource RuleBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="OnTitleBarMouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                        <!-- 品牌徽标：新 Z 图标本体自带圆角与渐变底板，不再额外套一层色块 -->
                        <Image Width="22"
                               Height="22"
                               Source="pack://application:,,,/Assets/Brand/ZungMailMark64.png"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               SnapsToDevicePixels="True" />
                        <!-- 标题栏版本标识：版本号与「关于」页共用 AppVersionInfo -->
                        <TextBlock Text="ZungMail"
                                   FontWeight="SemiBold"
                                   Margin="9,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource InkBrush}" />
                        <TextBlock Text="{Binding AppVersion}"
                                   FontSize="12"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedBrush}"
                                   ToolTip="当前客户端版本" />
                    </StackPanel>

                    <!--
                        搜索框已移到下方工具栏（SearchBox 仍在同一名字域，这里的 @ 语法弹层按名字找它即可）。
                        这个 Grid 只作为弹层宿主，本身不占位。
                    -->
                    <Grid Grid.Column="1" MaxWidth="520" Margin="16,0" Visibility="Collapsed">

                        <!-- 输入 @ / ＠ 后弹出：与微信 @ 选择类似，↑↓ 移动、Enter/Tab 插入、Esc 关闭 -->
                        <Popup x:Name="SearchSyntaxPopup"
                               PlacementTarget="{Binding ElementName=SearchBox}"
                               Placement="Bottom"
                               VerticalOffset="6"
                               StaysOpen="True"
                               AllowsTransparency="True"
                               PopupAnimation="Fade">
                            <Border Width="{Binding ActualWidth, ElementName=SearchBox}"
                                    MinWidth="430"
                                    MaxWidth="560"
                                    Background="{DynamicResource ReaderBrush}"
                                    BorderBrush="{DynamicResource RuleStrongBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="8">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18"
                                                      ShadowDepth="4"
                                                      Direction="270"
                                                      Opacity="0.20"
                                                      Color="#0F172A" />
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="6,2,6,6">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="7" Height="7"
                                                     Fill="{DynamicResource AccentBrush}"
                                                     VerticalAlignment="Center" />
                                            <TextBlock Text="搜索语法"
                                                       Margin="7,0,0,0"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource InkBrush}" />
                                        </StackPanel>
                                        <TextBlock HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource MutedText}"
                                                   FontSize="10.5"
                                                   Text="方向键选择 · Enter 插入 · Esc 关闭" />
                                    </Grid>

                                    <ListBox x:Name="SearchSyntaxList"
                                             Grid.Row="1"
                                             Style="{StaticResource AppListBox}"
                                             Focusable="False"
                                             IsTabStop="False"
                                             MaxHeight="330"
                                             HorizontalContentAlignment="Stretch"
                                             PreviewMouseMove="OnSearchSyntaxMouseMove"
                                             PreviewMouseLeftButtonUp="OnSearchSyntaxClick">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource PanelListItem}">
                                                <Setter Property="Focusable" Value="False" />
                                                <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ToolTip="{Binding Example}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0"
                                                            Background="{DynamicResource AccentSoftBrush}"
                                                            CornerRadius="5"
                                                            Padding="6,2"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Token}"
                                                                   FontFamily="Consolas"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource AccentBrush}" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="10,0,8,0">
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource InkBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Description}"
                                                                   Style="{StaticResource MutedText}"
                                                                   FontSize="11"
                                                                   Margin="0,2,0,0"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding Group}"
                                                               Style="{StaticResource MutedText}"
                                                               FontSize="10.5"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <Border Grid.Row="2"
                                            Margin="6,6,6,0"
                                            Padding="0,6,0,0"
                                            BorderBrush="{DynamicResource RuleBrush}"
                                            BorderThickness="0,1,0,0">
                                        <TextBlock Style="{StaticResource MutedText}"
                                                   FontSize="10.5"
                                                   Text="选择后继续输入值；has:attachment 等完整语法插入即生效" />
                                    </Border>
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource WinBtn}"
                                Command="{x:Static SystemCommands.MinimizeWindowCommand}"
                                CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                                ToolTip="最小化">
                            <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IcoMin}" />
                        </Button>
                        <Button Style="{StaticResource WinBtn}"
                                Command="{x:Static SystemCommands.MaximizeWindowCommand}"
                                CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                                ToolTip="最大化 / 还原">
                            <Path>
                                <Path.Style>
                                    <Style TargetType="Path" BasedOn="{StaticResource IconPathSmall}">
                                        <Setter Property="Data" Value="{StaticResource IcoMax}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                                         Value="Maximized">
                                                <Setter Property="Data" Value="{StaticResource IcoRestore}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Button>
                        <Button Style="{StaticResource WinBtnClose}"
                                Command="{x:Static SystemCommands.CloseWindowCommand}"
                                CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                                ToolTip="关闭">
                            <Path Style="{StaticResource IconPathSmall}"
                                  Data="{StaticResource IcoClose}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ 工具栏 ============ -->
            <Border Grid.Row="1"
                    Background="{DynamicResource WindowBackgroundBrush}"
                    BorderBrush="{DynamicResource RuleBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="12,8">
                <StackPanel>
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <!-- 左：操作按钮（窄窗口时整体裁剪，不会把右侧入口挤出去） -->
                        <ColumnDefinition Width="*" />
                        <!-- 中：搜索框固定宽度，窄窗口也保住可用宽度 -->
                        <ColumnDefinition Width="Auto" />
                        <!-- 右：发件箱 / 通讯录 / 设置，永远贴住右边 -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                ClipToBounds="True">
                    <Button Style="{StaticResource BtnPrimary}"
                            Command="{Binding ComposeCommand}"
                            ToolTip="写邮件">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPathSmall}"
                                  Data="{StaticResource IcoCompose}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Text="写邮件" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>

                    <Rectangle Style="{StaticResource VDivider}" Margin="10,0" />

                    <Button Style="{StaticResource Btn}"
                            Command="{Binding ToggleStarCommand}"
                            IsEnabled="{Binding HasSelection}"
                            ToolTip="为选中邮件加 / 取消星标">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IcoStar}" />
                            <TextBlock Text="星标" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Btn}"
                            Margin="6,0,0,0"
                            Command="{Binding DeleteMessageCommand}"
                            IsEnabled="{Binding HasSelection}"
                            ToolTip="删除选中邮件">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IcoTrash}" />
                            <TextBlock Text="删除" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BtnGhost}"
                            Margin="6,0,0,0"
                            Command="{Binding MarkAllReadCommand}"
                            ToolTip="将当前列表中的未读邮件全部标为已读">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IcoMail}" />
                            <TextBlock Text="全部已读" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>

                    <Rectangle Style="{StaticResource VDivider}" Margin="10,0" />

                    <Border Background="{DynamicResource SidebarBrush}"
                            BorderBrush="{DynamicResource RuleStrongBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="2">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource SegmentRadio}"
                                         GroupName="MailFilter"
                                         Content="全部"
                                         IsChecked="{Binding Filter, Converter={StaticResource EnumToBoolean}, ConverterParameter=All, Mode=TwoWay}" />
                            <RadioButton Style="{StaticResource SegmentRadio}"
                                         GroupName="MailFilter"
                                         Content="未读"
                                         IsChecked="{Binding Filter, Converter={StaticResource EnumToBoolean}, ConverterParameter=Unread, Mode=TwoWay}" />
                            <RadioButton Style="{StaticResource SegmentRadio}"
                                         GroupName="MailFilter"
                                         Content="星标"
                                         IsChecked="{Binding Filter, Converter={StaticResource EnumToBoolean}, ConverterParameter=Starred, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>

                    <Rectangle Style="{StaticResource VDivider}" Margin="10,0" />

                    <ToggleButton Style="{StaticResource ToggleChip}"
                                  IsChecked="{Binding ConversationMode}"
                                  ToolTip="按主题聚合会话（FR-05）">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IcoUsers}" />
                            <TextBlock Text="会话模式" Margin="6,0,0,0" />
                        </StackPanel>
                    </ToggleButton>

                    <Button Style="{StaticResource IconBtn}"
                            Margin="8,0,0,0"
                            Command="{Binding RefreshCommand}"
                            ToolTip="{Binding RefreshToolTip}">
                        <!-- 同步中：刷新图标换成转圈弧，按钮仍可点（内部会忽略重复点击） -->
                        <Grid Width="18" Height="18">
                            <Path Style="{StaticResource IconPathSmall}"
                                  Data="{StaticResource IcoRefresh}"
                                  Visibility="{Binding IsSyncing, Converter={StaticResource InverseBoolToVisibility}}" />
                            <Path Data="{StaticResource IcoSpinner}" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform />
                                </Path.RenderTransform>
                                <Path.Style>
                                    <Style TargetType="Path" BasedOn="{StaticResource IconPathSmall}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSyncing}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="SpinRefreshStory">
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                             From="0" To="360"
                                                                             Duration="0:0:0.9"
                                                                             RepeatBehavior="Forever" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="SpinRefreshStory" />
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Grid>
                    </Button>

                    <ToggleButton Style="{StaticResource IconToggleBtn}"
                                  Margin="8,0,0,0"
                                  IsChecked="{Binding IsContextSidebarVisible, Mode=OneWay}"
                                  Command="{Binding ToggleContextSidebarCommand}"
                                  ToolTip="{Binding ContextSidebarToggleHint}">
                        <Path Data="{StaticResource IcoPanelRight}">
                            <Path.Style>
                                <Style TargetType="Path" BasedOn="{StaticResource IconPathSmall}">
                                    <Setter Property="Stroke" Value="{DynamicResource MutedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsContextSidebarVisible}" Value="True">
                                            <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </ToggleButton>

                    </StackPanel>

                    <!-- 搜索框：从标题栏移到工具栏里，和操作按钮同一行（标题栏只留品牌与窗口按钮） -->
                    <Grid Grid.Column="1" Width="420" Margin="14,0" VerticalAlignment="Center">
                        <TextBox x:Name="SearchBox"
                                 Style="{StaticResource AppTextBox}"
                                 Padding="21,0,58,0"
                                 VerticalAlignment="Center"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 TextChanged="OnSearchBoxTextChanged"
                                 PreviewKeyDown="OnSearchBoxPreviewKeyDown"
                                 LostKeyboardFocus="OnSearchBoxLostKeyboardFocus">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Path Style="{StaticResource IconPathSmall}"
                              Data="{StaticResource IcoSearch}"
                              Stroke="{DynamicResource MutedBrush}"
                              HorizontalAlignment="Left"
                              Margin="10,0,0,0"
                              VerticalAlignment="Center" />
                        <!-- 水印：右侧留出「清空 ×」和「筛选箭头」的位置，超长时省略号收尾，绝不压到按钮上 -->
                        <TextBlock Text="搜索邮件，输入 @ 选择语法"
                                   IsHitTestVisible="False"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="31,0,58,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedBrush}">
                            <TextBlock.Style>
                                <!-- 只在「无内容且未聚焦」时显示水印：聚焦后让出位置给光标 -->
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Text, ElementName=SearchBox}" Value="" />
                                                <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchBox}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Style="{StaticResource IconBtn}"
                                Width="20"
                                Height="20"
                                HorizontalAlignment="Right"
                                Margin="0,0,5,0"
                                VerticalAlignment="Center"
                                Command="{Binding ClearSearchCommand}"
                                ToolTip="清除搜索"
                                Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource NotEmptyToVisibility}}">
                            <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IcoClose}" />
                        </Button>
                        <!-- 高级筛选：展开工具栏下方的内联筛选条（不再用悬浮框，方便从正文复制条件后粘贴） -->
                        <ToggleButton x:Name="SearchFilterToggle"
                                      Style="{StaticResource IconBtn}"
                                      Width="22"
                                      Height="22"
                                      HorizontalAlignment="Right"
                                      Margin="0,0,26,0"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding IsSearchFilterOpen, Mode=TwoWay}"
                                      ToolTip="全部搜索条件：展开 / 收起筛选面板（发件人 / 收件人 / 主题 / 全文 / 附件 / 标签 / 提醒 / 备注 / 时间）">
                            <!-- 箭头方向跟着筛选条状态走：收起时朝下、展开时朝上，同时变成主色 -->
                            <Path Data="{StaticResource IcoChevron}">
                                <Path.Style>
                                    <Style TargetType="Path" BasedOn="{StaticResource IconPathSmall}">
                                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, ElementName=SearchFilterToggle}" Value="True">
                                                <Setter Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="180" />
                                                    </Setter.Value>
                                                </Setter>
                                                <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </ToggleButton>
                    </Grid>

                    <!-- 右侧固定入口：始终贴住右边，窄窗口也不会被挤掉 -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="10,0,0,0">
                    <Rectangle Style="{StaticResource VDivider}" Margin="0,0,10,0" />

                    <Button Style="{StaticResource Btn}"
                            Command="{Binding OpenOutboxCommand}"
                            ToolTip="查看发件箱与定时发送队列">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IcoSend}" />
                            <TextBlock Text="发件箱" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Btn}"
                            Margin="6,0,0,0"
                            Command="{Binding OpenAddressBookCommand}"
                            ToolTip="通讯录：联系人搜索、编辑与导入导出">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IcoUsers}" />
                            <TextBlock Text="通讯录" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Btn}"
                            Margin="6,0,0,0"
                            Command="{Binding OpenSettingsCommand}"
                            ToolTip="设置与账户配置">
                        <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IcoGear}" />
                    </Button>
                    </StackPanel>
                </Grid>

                <!-- 高级筛选条：常驻内联（不再是悬浮框）。开着的状态下点阅读区、复制正文再回来粘贴都不会消失，
                     填完点「筛选」把条件拼回搜索框里的结构化语法。
                     视觉上用「主色浅底 + 主色描边 + 左侧主色竖条」把它和普通工具栏区分开，
                     配色全部走调色板，四套主题（默认 / 淡蓝 / 淡粉 / 淡橙）自动跟随。 -->
                <Border Margin="0,10,0,0"
                        CornerRadius="8"
                        Background="{DynamicResource SelectedBrush}"
                        BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="1"
                        Visibility="{Binding IsSearchFilterOpen, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 左侧主色竖条：一眼看出这是「正在生效的筛选条件」 -->
                        <Border Grid.Column="0"
                                Width="4"
                                Background="{DynamicResource AccentBrush}"
                                CornerRadius="7,0,0,7" />

                        <StackPanel Grid.Column="1" Margin="12,8,10,8">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Path Style="{StaticResource IconPathSmall}"
                                      Data="{StaticResource IcoSearch}"
                                      Stroke="{DynamicResource AccentBrush}"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="全部搜索条件"
                                           Margin="6,0,0,0"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Style="{StaticResource MutedText}"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource Ink2Brush}"
                                           TextTrimming="CharacterEllipsis"
                                           Text="条件之间是「与」关系；Enter 应用、Esc 收起，右侧「+」可配置显示哪些条件" />
                                </StackPanel>

                                <!-- 「+」：像 Foxmail 一样勾选要显示哪些搜索条件（隐藏的记在设置里） -->
                                <Button x:Name="SearchFilterFieldsMenuButton"
                                        Grid.Column="1"
                                        Style="{StaticResource IconBtn}"
                                        Width="24"
                                        Height="24"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Click="OnSearchFilterFieldsMenuClick"
                                        ToolTip="配置显示哪些搜索条件">
                                    <Button.ContextMenu>
                                        <ContextMenu Style="{StaticResource MailContextMenu}">
                                            <MenuItem Style="{StaticResource MailContextMenuItem}" IsCheckable="True" IsChecked="{Binding ShowFilterFrom, Mode=TwoWay}" Header="发件人" />
                                            <MenuItem Style="{StaticResource MailContextMenuItem}" IsCheckable="True" IsChecked="{Binding ShowFilterTo, Mode=TwoWay}" Header="收件人" />
                                            <MenuItem Style="{StaticResource MailContextMenuItem}" IsCheckable="True" IsChecked="{Binding ShowFilterSubject, Mode=TwoWay}" Header="主题" />
                                            <MenuItem Style="{StaticResource MailContextMenuItem}" IsCheckable="True" IsChecked="{Binding ShowFilterBody, Mode=TwoWay}" Header="全文" />
                                            <MenuItem Style="{StaticResource MailContextMenuItem}" IsCheckable="True" IsChecked="{Binding ShowFilterAttachment, Mode=TwoWay}" Header="附件" />
                                            <MenuItem Style="{StaticResource MailContextMenuItem}" IsCheckable="True" IsChecked="{Binding ShowFilterTag, Mode=TwoWay}" Header="标签" />
                                            <MenuItem Style="{StaticResource MailContextMenuItem}" IsCheckable="True" IsChecked="{Binding ShowFilterReminder, Mode=TwoWay}" Header="提醒" />
                                            <MenuItem Style="{StaticResource MailContextMenuItem}" IsCheckable="True" IsChecked="{Binding ShowFilterNote, Mode=TwoWay}" Header="备注" />
                                            <MenuItem Style="{StaticResource MailContextMenuItem}" IsCheckable="True" IsChecked="{Binding ShowFilterTime, Mode=TwoWay}" Header="时间" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IcoPlus}" />
                                </Button>
                            </Grid>

                            <!-- Foxmail 式「全部搜索条件」：条件单元自动换行（在「+」里隐藏某项后自动重排），时间与按钮单独一行 -->
                            <WrapPanel Orientation="Horizontal">

                                <!-- 第 1 行：发件人 / 收件人 / 主题 / 全文 -->
                                <Grid Width="318" Margin="0,0,10,8" Visibility="{Binding ShowFilterFrom, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource LabelText}"
                                               Foreground="{DynamicResource Ink2Brush}"
                                               VerticalAlignment="Center"
                                               Text="发件人：" />
                                    <TextBox x:Name="SearchFilterFromBox"
                                             Grid.Column="1"
                                             Style="{StaticResource AppTextBox}"
                                             ToolTip="支持从邮件正文直接复制的公司名、域名或完整地址"
                                             Text="{Binding SearchFilterFrom, UpdateSourceTrigger=PropertyChanged}">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding ApplySearchFilterCommand}" />
                                            <KeyBinding Key="Escape" Command="{Binding HideSearchFilterCommand}" />
                                        </TextBox.InputBindings>
                                    </TextBox>
                                </Grid>

                                <Grid Width="318" Margin="0,0,10,8" Visibility="{Binding ShowFilterTo, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource LabelText}"
                                               Foreground="{DynamicResource Ink2Brush}"
                                               VerticalAlignment="Center"
                                               Text="收件人：" />
                                    <TextBox Grid.Column="1"
                                             Style="{StaticResource AppTextBox}"
                                             ToolTip="含抄送与密送"
                                             Text="{Binding SearchFilterTo, UpdateSourceTrigger=PropertyChanged}">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding ApplySearchFilterCommand}" />
                                            <KeyBinding Key="Escape" Command="{Binding HideSearchFilterCommand}" />
                                        </TextBox.InputBindings>
                                    </TextBox>
                                </Grid>

                                <Grid Width="318" Margin="0,0,10,8" Visibility="{Binding ShowFilterSubject, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource LabelText}"
                                               Foreground="{DynamicResource Ink2Brush}"
                                               VerticalAlignment="Center"
                                               Text="主题：" />
                                    <TextBox Grid.Column="1"
                                             Style="{StaticResource AppTextBox}"
                                             Text="{Binding SearchFilterSubject, UpdateSourceTrigger=PropertyChanged}">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding ApplySearchFilterCommand}" />
                                            <KeyBinding Key="Escape" Command="{Binding HideSearchFilterCommand}" />
                                        </TextBox.InputBindings>
                                    </TextBox>
                                </Grid>

                                <Grid Width="318" Margin="0,0,10,8" Visibility="{Binding ShowFilterBody, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource LabelText}"
                                               Foreground="{DynamicResource Ink2Brush}"
                                               VerticalAlignment="Center"
                                               Text="全文：" />
                                    <TextBox Grid.Column="1"
                                             Style="{StaticResource AppTextBox}"
                                             ToolTip="在正文纯文本里查找"
                                             Text="{Binding SearchFilterBody, UpdateSourceTrigger=PropertyChanged}">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding ApplySearchFilterCommand}" />
                                            <KeyBinding Key="Escape" Command="{Binding HideSearchFilterCommand}" />
                                        </TextBox.InputBindings>
                                    </TextBox>
                                </Grid>

                                <!-- 第 2 行：附件（有/无 + 关键词） / 标签 / 提醒 / 备注 -->
                                <Grid Width="470" Margin="0,0,10,8" Visibility="{Binding ShowFilterAttachment, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource LabelText}"
                                               Foreground="{DynamicResource Ink2Brush}"
                                               VerticalAlignment="Center"
                                               Text="附件：" />
                                    <ComboBox Grid.Column="1"
                                              Style="{StaticResource AppComboBox}"
                                              Margin="0,0,6,0"
                                              SelectedIndex="{Binding SearchFilterAttachmentIndex, Mode=TwoWay}">
                                        <ComboBoxItem Content="不限" />
                                        <ComboBoxItem Content="有附件" />
                                        <ComboBoxItem Content="无附件" />
                                    </ComboBox>
                                    <TextBox Grid.Column="2"
                                             Style="{StaticResource AppTextBox}"
                                             ToolTip="附件名关键词（可留空）"
                                             Text="{Binding SearchFilterFileName, UpdateSourceTrigger=PropertyChanged}">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding ApplySearchFilterCommand}" />
                                            <KeyBinding Key="Escape" Command="{Binding HideSearchFilterCommand}" />
                                        </TextBox.InputBindings>
                                    </TextBox>
                                </Grid>

                                <Grid Width="318" Margin="0,0,10,8" Visibility="{Binding ShowFilterTag, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource LabelText}"
                                               Foreground="{DynamicResource Ink2Brush}"
                                               VerticalAlignment="Center"
                                               Text="标签：" />
                                    <ComboBox Grid.Column="1"
                                              Style="{StaticResource AppComboBox}"
                                              ItemsSource="{Binding SearchFilterTagOptions}"
                                              SelectedIndex="{Binding SearchFilterTagIndex, Mode=TwoWay}" />
                                </Grid>

                                <Grid Width="318" Margin="0,0,10,8" Visibility="{Binding ShowFilterReminder, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource LabelText}"
                                               Foreground="{DynamicResource Ink2Brush}"
                                               VerticalAlignment="Center"
                                               Text="提醒：" />
                                    <ComboBox Grid.Column="1"
                                              Style="{StaticResource AppComboBox}"
                                              SelectedIndex="{Binding SearchFilterReminderIndex, Mode=TwoWay}">
                                        <ComboBoxItem Content="不限" />
                                        <ComboBoxItem Content="有提醒" />
                                        <ComboBoxItem Content="无提醒" />
                                    </ComboBox>
                                </Grid>

                                <Grid Width="318" Margin="0,0,10,8" Visibility="{Binding ShowFilterNote, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource LabelText}"
                                               Foreground="{DynamicResource Ink2Brush}"
                                               VerticalAlignment="Center"
                                               Text="备注：" />
                                    <TextBox Grid.Column="1"
                                             Style="{StaticResource AppTextBox}"
                                             ToolTip="在本地备注里查找"
                                             Text="{Binding SearchFilterNote, UpdateSourceTrigger=PropertyChanged}">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding ApplySearchFilterCommand}" />
                                            <KeyBinding Key="Escape" Command="{Binding HideSearchFilterCommand}" />
                                        </TextBox.InputBindings>
                                    </TextBox>
                                </Grid>

                            </WrapPanel>

                            <!-- 时间（可隐藏）+ 按钮：单独一行，始终贴底 -->
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0"
                                      Margin="0,0,10,0"
                                      Visibility="{Binding ShowFilterTime, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="130" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource LabelText}"
                                               Foreground="{DynamicResource Ink2Brush}"
                                               VerticalAlignment="Center"
                                               Text="时间：" />
                                    <ComboBox Grid.Column="1"
                                              Style="{StaticResource AppComboBox}"
                                              SelectedIndex="{Binding SearchFilterTimeIndex, Mode=TwoWay}">
                                        <ComboBoxItem Content="时间不限" />
                                        <ComboBoxItem Content="今天" />
                                        <ComboBoxItem Content="三天内" />
                                        <ComboBoxItem Content="一周内" />
                                        <ComboBoxItem Content="一个月内" />
                                        <ComboBoxItem Content="一年内" />
                                        <ComboBoxItem Content="自定义" />
                                    </ComboBox>
                                    <TextBlock Grid.Column="2"
                                               Style="{StaticResource LabelText}"
                                               Foreground="{DynamicResource Ink2Brush}"
                                               Margin="10,0,6,0"
                                               VerticalAlignment="Center"
                                               Text="从"
                                               Visibility="{Binding IsSearchFilterCustomRange, Converter={StaticResource BoolToVisibility}}" />
                                    <DatePicker Grid.Column="3"
                                                SelectedDate="{Binding SearchFilterDateFrom, Mode=TwoWay}"
                                                Visibility="{Binding IsSearchFilterCustomRange, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Grid.Column="4"
                                               Style="{StaticResource LabelText}"
                                               Foreground="{DynamicResource Ink2Brush}"
                                               Margin="10,0,6,0"
                                               VerticalAlignment="Center"
                                               Text="到"
                                               Visibility="{Binding IsSearchFilterCustomRange, Converter={StaticResource BoolToVisibility}}" />
                                    <DatePicker Grid.Column="5"
                                                SelectedDate="{Binding SearchFilterDateTo, Mode=TwoWay}"
                                                Visibility="{Binding IsSearchFilterCustomRange, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>

                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <Button Style="{StaticResource BtnGhost}" Content="重置"
                                            Command="{Binding ResetSearchFilterCommand}" />
                                    <Button Style="{StaticResource BtnPrimary}" Margin="8,0,0,0" Content="筛选"
                                            Command="{Binding ApplySearchFilterCommand}" />
                                    <Button Style="{StaticResource BtnGhost}" Margin="8,0,0,0" Content="收起"
                                            ToolTip="收起筛选条（已生效的条件保留）"
                                            Command="{Binding HideSearchFilterCommand}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
                </StackPanel>
            </Border>

            <!-- ============ 存储空间预警 ============ -->
            <Border Grid.Row="2"
                    Padding="14,8"
                    BorderThickness="0,0,0,1"
                    Visibility="{Binding HasStorageAlert, Converter={StaticResource BoolToVisibility}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource NoticeSoftBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource NoticeBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Storage.Level}" Value="Warning">
                                <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Storage.Level}" Value="Critical">
                                <Setter Property="Background" Value="{DynamicResource CriticalSoftBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource CriticalBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Path Grid.Column="0"
                          Style="{StaticResource IconPathSmall}"
                          Data="{StaticResource IcoDatabase}"
                          Stroke="{DynamicResource WarnDotBrush}"
                          VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Margin="9,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StorageAlertText}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource InkBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Style="{StaticResource MutedText}" Text="{Binding StorageStatus}" />
                            <TextBlock Style="{StaticResource MutedText}"
                                       Margin="10,0,0,0"
                                       Text="{Binding StorageReclaimableText}" />
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Style="{StaticResource BtnPrimary}"
                            VerticalAlignment="Center"
                            Command="{Binding OpenCleanupCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPathSmall}"
                                  Data="{StaticResource IcoTrash}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Text="查看占用 / 清理" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- ============ 三栏工作区 ============ -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="226" />
                    <ColumnDefinition Width="344" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左：文件夹树 -->
                <Border Grid.Column="0"
                        Background="{DynamicResource SidebarBrush}"
                        BorderBrush="{DynamicResource RuleBrush}"
                        BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 快捷视图 / 等待回复 / 标签 / 时效节点 / 业务单号 / 文件夹合成一个滚动区：
                             侧栏内容变多时整体滚动，不会把文件夹列表压到看不见 -->
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,12,0,4">
                            <!-- 快捷视图：可折叠卡片（有边界 + 头部折展按钮），折叠状态记在设置里 -->
                            <Border Style="{StaticResource SidebarCard}">
                                <StackPanel>
                                    <Button Style="{StaticResource SidebarRowButton}"
                                            Command="{Binding ToggleQuickViewsCommand}"
                                            ToolTip="折叠 / 展开快捷视图">
                                        <Grid Margin="10,0,8,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="0"
                                                  Data="{StaticResource IcoChevron}"
                                                  Stroke="{DynamicResource MutedBrush}"
                                                  VerticalAlignment="Center"
                                                  RenderTransformOrigin="0.5,0.5">
                                                <Path.Style>
                                                    <Style TargetType="Path" BasedOn="{StaticResource IconPathSmall}">
                                                        <Setter Property="RenderTransform">
                                                            <Setter.Value>
                                                                <RotateTransform Angle="-90" />
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsQuickViewsExpanded}" Value="True">
                                                                <Setter Property="RenderTransform">
                                                                    <Setter.Value>
                                                                        <RotateTransform Angle="0" />
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                            <TextBlock Grid.Column="1"
                                                       Margin="6,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource LabelText}"
                                                       Text="快捷视图" />
                                        </Grid>
                                    </Button>
                                    <StackPanel Visibility="{Binding IsQuickViewsExpanded, Converter={StaticResource BoolToVisibility}}">
                                        <ItemsControl ItemsSource="{Binding QuickViews}" ItemTemplate="{StaticResource QuickViewTemplate}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 等待回复：任务入口（不是邮件筛选），点开看谁还没回；设置里关掉货代功能后隐藏 -->
                            <Button Style="{StaticResource SidebarRowButton}"
                                    Command="{Binding OpenFollowUpsCommand}"
                                    Visibility="{Binding ShowFreightFollowUps, Converter={StaticResource BoolToVisibility}}"
                                    ToolTip="{Binding FollowUpButtonText, StringFormat={}{0}：谁还没回、什么时候该催}">
                                <Grid Margin="14,0,12,0" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0"
                                          Style="{StaticResource IconPathSmall}"
                                          Stroke="{DynamicResource Ink2Brush}"
                                          Data="{StaticResource IcoClock}" />
                                    <TextBlock Grid.Column="1"
                                               Text="等待回复"
                                               Margin="9,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource Ink2Brush}" />
                                    <Border Grid.Column="2"
                                            Background="{DynamicResource AccentSoftBrush}"
                                            CornerRadius="8"
                                            Padding="6,0"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding ActiveFollowUpCount, Converter={StaticResource NotEmptyToVisibility}}">
                                        <TextBlock Text="{Binding ActiveFollowUpCount}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                    </Border>
                                </Grid>
                            </Button>

                            <!-- 标签：可折叠卡片（点击标签按标签跨文件夹聚合，Ctrl+数字 可直达）；没有标签时整块隐藏 -->
                            <Border Style="{StaticResource SidebarCard}"
                                    Visibility="{Binding SidebarTags.Count, Converter={StaticResource NotEmptyToVisibility}}">
                                <StackPanel>
                                    <Button Style="{StaticResource SidebarRowButton}"
                                            Command="{Binding ToggleTagsCommand}"
                                            ToolTip="折叠 / 展开标签">
                                        <Grid Margin="10,0,8,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="0"
                                                  Data="{StaticResource IcoChevron}"
                                                  Stroke="{DynamicResource MutedBrush}"
                                                  VerticalAlignment="Center"
                                                  RenderTransformOrigin="0.5,0.5">
                                                <Path.Style>
                                                    <Style TargetType="Path" BasedOn="{StaticResource IconPathSmall}">
                                                        <Setter Property="RenderTransform">
                                                            <Setter.Value>
                                                                <RotateTransform Angle="-90" />
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsTagsExpanded}" Value="True">
                                                                <Setter Property="RenderTransform">
                                                                    <Setter.Value>
                                                                        <RotateTransform Angle="0" />
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                            <TextBlock Grid.Column="1"
                                                       Margin="6,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource LabelText}"
                                                       Text="标签" />
                                        </Grid>
                                    </Button>
                                    <ItemsControl ItemsSource="{Binding SidebarTags}"
                                                  Visibility="{Binding IsTagsExpanded, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource SidebarRowButton}"
                                                Command="{Binding DataContext.SelectTagCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="{Binding ShortcutDisplay}">
                                            <StackPanel Orientation="Horizontal" Margin="14,0,12,0" VerticalAlignment="Center">
                                                <Border Width="10" Height="10" CornerRadius="3" VerticalAlignment="Center"
                                                        Background="{Binding Color, Converter={StaticResource HexToBrush}}" />
                                                <TextBlock Text="{Binding Name}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Ink2Brush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding ShortcutDisplay}" Margin="8,0,0,0" FontSize="10.5"
                                                           VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- 时效节点：截关 / 截补料 / VGM / ETD / ETA 倒计时，点击进入一票货；设置里关掉后整块隐藏 -->
                            <StackPanel Visibility="{Binding ShowFreightDeadlines, Converter={StaticResource BoolToVisibility}}">
                            <Grid Margin="16,8,10,4" ToolTip="{Binding DeadlineSummary}">
                                <TextBlock Style="{StaticResource LabelText}" Text="时效节点" VerticalAlignment="Center" />
                                <Button Style="{StaticResource IconBtn}"
                                        Width="20"
                                        Height="20"
                                        HorizontalAlignment="Right"
                                        Command="{Binding RefreshDeadlinesCommand}"
                                        ToolTip="重新计算截关 / 开船 / 到港倒计时">
                                    <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IcoClock}" />
                                </Button>
                            </Grid>
                            <ScrollViewer MaxHeight="170"
                                          VerticalScrollBarVisibility="Auto"
                                          Visibility="{Binding Deadlines.Count, Converter={StaticResource NotEmptyToVisibility}}">
                                <ItemsControl ItemsSource="{Binding Deadlines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource SidebarRowButton}"
                                                    Command="{Binding DataContext.OpenCaseCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding CaseId}"
                                                    ToolTip="{Binding Tooltip}">
                                                <Grid Margin="14,0,10,0" VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="34" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding KindShort}"
                                                               FontSize="9.5"
                                                               FontWeight="Bold"
                                                               VerticalAlignment="Center"
                                                               Foreground="{Binding KindColor, Converter={StaticResource HexToBrush}}" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding HeaderText}"
                                                                   FontSize="12"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource Ink2Brush}" />
                                                        <TextBlock Text="{Binding DueDayDisplay}"
                                                                   FontSize="10.5"
                                                                   Foreground="{DynamicResource MutedBrush}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding CountdownText}"
                                                               FontSize="10.5"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"
                                                               Foreground="{Binding UrgencyColor, Converter={StaticResource HexToBrush}}" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock Text="暂无近期节点"
                                       Style="{StaticResource MutedText}"
                                       Margin="16,0,0,4"
                                       Visibility="{Binding Deadlines.Count, Converter={StaticResource EmptyToVisibility}}" />
                            </StackPanel>

                            <!-- 业务单号：一票货聚合入口（Job / SO / B/L / 箱号），点击跨文件夹聚合往来邮件 -->
                            <Grid Margin="16,8,10,4"
                                  ToolTip="{Binding BusinessRefsSummary}"
                                  Visibility="{Binding BusinessRefs.Count, Converter={StaticResource NotEmptyToVisibility}}">
                                <TextBlock Style="{StaticResource LabelText}" Text="业务单号" VerticalAlignment="Center" />
                                <Button Style="{StaticResource IconBtn}"
                                        Width="20"
                                        Height="20"
                                        HorizontalAlignment="Right"
                                        Command="{Binding RefreshBusinessRefsCommand}"
                                        ToolTip="重新扫描邮件中的业务单号">
                                    <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IcoRefresh}" />
                                </Button>
                            </Grid>
                            <ScrollViewer MaxHeight="180"
                                          VerticalScrollBarVisibility="Auto"
                                          Visibility="{Binding BusinessRefs.Count, Converter={StaticResource NotEmptyToVisibility}}">
                                <ItemsControl ItemsSource="{Binding BusinessRefs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource SidebarRowButton}"
                                                    Command="{Binding DataContext.SelectBusinessRefCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="{Binding SearchText}">
                                                <Grid Margin="14,0,10,0" VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="30" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding KindShort}"
                                                               FontSize="9.5"
                                                               FontWeight="Bold"
                                                               VerticalAlignment="Center"
                                                               Foreground="{Binding KindColor, Converter={StaticResource HexToBrush}}" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Value}"
                                                               FontSize="12"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource Ink2Brush}" />
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding CountDisplay}"
                                                               FontSize="10.5"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource MutedBrush}" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <Grid Margin="10,6,10,0">
                                <TextBlock Style="{StaticResource LabelText}" Text="文件夹" Margin="6,0,0,6" VerticalAlignment="Center" />
                                <Button Style="{StaticResource IconBtn}"
                                        Width="22"
                                        Height="22"
                                        HorizontalAlignment="Right"
                                        Command="{Binding CreateFolderCommand}"
                                        ToolTip="新建文件夹">
                                    <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IcoPlus}" />
                                </Button>
                            </Grid>

                            <!-- 首次加载：先给一条轻量进度，不让文件夹区域空着像卡死 -->
                            <StackPanel Orientation="Horizontal"
                                        Margin="16,2,12,8"
                                        Visibility="{Binding IsAccountsLoading, Converter={StaticResource BoolToVisibility}}">
                                <ProgressBar Width="64"
                                             Height="3"
                                             IsIndeterminate="True"
                                             VerticalAlignment="Center"
                                             Foreground="{DynamicResource AccentBrush}"
                                             Background="{DynamicResource RuleBrush}"
                                             BorderThickness="0" />
                                <TextBlock Style="{StaticResource MutedText}"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="正在加载账户与文件夹…" />
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding Accounts}" ItemTemplate="{StaticResource AccountTemplate}" />
                            <Border Height="10" />
                        </StackPanel>
                        </ScrollViewer>

                        <Border Grid.Row="1"
                                Padding="14,8"
                                BorderBrush="{DynamicResource RuleBrush}"
                                BorderThickness="0,1,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource OkDotBrush}" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource MutedText}"
                                           Margin="8,0,0,0"
                                           Text="{Binding AccountSummary}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- 中：邮件列表 -->
                <Border Grid.Column="1"
                        Background="{DynamicResource ListBrush}"
                        BorderBrush="{DynamicResource RuleBrush}"
                        BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 三栏表头统一高度（列表 / 阅读工具条 / 邮件上下文）：单行 + MinHeight=44，
                             正常态三块底线对齐；只有搜索结果多出「搜索范围 / 条件 chip」时列表头才自然长高 -->
                        <Border Grid.Row="0"
                                MinHeight="44"
                                Padding="14,4"
                                BorderBrush="{DynamicResource RuleBrush}"
                                BorderThickness="0,0,0,1">
                            <StackPanel VerticalAlignment="Center">
                                <!-- 标题与副标题同一行，省掉一行高度；副标题过长时省略号截断 -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Style="{StaticResource PageTitle}"
                                               Text="{Binding ListTitle}" />
                                    <TextBlock Grid.Column="1"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource MutedText}"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{Binding ListSubtitle}" />
                                </Grid>
                                <!-- 搜索结果：当前文件夹 / 所有邮件两个独立范围 -->
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,8,0,0"
                                            Visibility="{Binding IsSearchResults, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource MutedText}"
                                               VerticalAlignment="Center"
                                               Text="搜索范围" />
                                    <Border Margin="8,0,0,0"
                                            Background="{DynamicResource SidebarBrush}"
                                            BorderBrush="{DynamicResource RuleStrongBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="2">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource SegmentRadio}"
                                                         GroupName="SearchScope"
                                                         Content="当前文件夹"
                                                         IsChecked="{Binding IsSearchScopeCurrentView, Mode=TwoWay}" />
                                            <RadioButton Style="{StaticResource SegmentRadio}"
                                                         GroupName="SearchScope"
                                                         Content="所有邮件"
                                                         IsChecked="{Binding IsSearchScopeAllMail, Mode=TwoWay}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <!-- 当前生效的搜索条件：点 × 单独摘掉某个运算符 -->
                                <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding SearchChips}"
                                              Visibility="{Binding ShowSearchChips, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,6,4" Padding="8,2" CornerRadius="6"
                                                    Background="{DynamicResource AccentSoftBrush}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Label}" FontSize="11.5"
                                                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                                    <Button Style="{StaticResource IconBtn}" Width="16" Height="16" Margin="4,0,0,0"
                                                            Command="{Binding DataContext.RemoveSearchChipCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" ToolTip="移除该条件">
                                                        <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IcoClose}" />
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <ListBox x:Name="MailList"
                                 Grid.Row="1"
                                 Style="{StaticResource AppListBox}"
                                 FocusVisualStyle="{x:Null}"
                                 ItemContainerStyle="{StaticResource MailListItemInteractive}"
                                 ItemTemplate="{StaticResource MailRowTemplate}"
                                 ItemsSource="{Binding Messages}"
                                 SelectedItem="{Binding SelectedRow}"
                                 SelectionMode="Extended"
                                 MouseDoubleClick="OnMailListDoubleClick"
                                 SelectionChanged="OnMailSelectionChanged" />

                        <StackPanel Grid.Row="1"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                            <Path Style="{StaticResource IconPath}"
                                  Width="30"
                                  Height="30"
                                  HorizontalAlignment="Center"
                                  Data="{StaticResource IcoMail}"
                                  Stroke="{DynamicResource RuleStrongBrush}" />
                            <TextBlock Text="没有匹配的邮件"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Margin="0,10,0,0"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource MutedBrush}" />
                            <TextBlock Text="试试其它关键词，或切换文件夹"
                                       Style="{StaticResource MutedText}"
                                       Margin="0,6,0,0"
                                       HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- 首次加载邮件列表：盖住空白列表，列出进度而不是让用户以为没邮件 -->
                        <Border Grid.Row="1"
                                Background="{DynamicResource ListBrush}"
                                Visibility="{Binding IsListLoading, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <ProgressBar Width="120"
                                             Height="4"
                                             IsIndeterminate="True"
                                             HorizontalAlignment="Center"
                                             Foreground="{DynamicResource AccentBrush}"
                                             Background="{DynamicResource RuleBrush}"
                                             BorderThickness="0" />
                                <TextBlock Text="正在加载邮件列表…"
                                           Style="{StaticResource MutedText}"
                                           Margin="0,10,0,0"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- 底部操作行：默认是分页；勾选邮件后换成批量处置条（同一位置，不挤动其它区域） -->
                        <Grid Grid.Row="2">
                            <Border Padding="8,6"
                                    BorderBrush="{DynamicResource RuleBrush}"
                                    BorderThickness="0,1,0,0"
                                    Visibility="{Binding ShowPagination, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Style="{StaticResource BtnGhost}" MinWidth="52" Content="首页"
                                            Command="{Binding FirstPageCommand}" IsEnabled="{Binding CanGoPrevious}" />
                                    <Button Style="{StaticResource BtnGhost}" MinWidth="52" Margin="4,0,0,0" Content="上一页"
                                            Command="{Binding PreviousPageCommand}" IsEnabled="{Binding CanGoPrevious}" />
                                    <TextBlock Style="{StaticResource MutedText}"
                                               Margin="10,0"
                                               VerticalAlignment="Center"
                                               Text="{Binding PageInfo}" />
                                    <Button Style="{StaticResource BtnGhost}" MinWidth="52" Content="下一页"
                                            Command="{Binding NextPageCommand}" IsEnabled="{Binding CanGoNext}" />
                                    <Button Style="{StaticResource BtnGhost}" MinWidth="52" Margin="4,0,0,0" Content="末页"
                                            Command="{Binding LastPageCommand}" IsEnabled="{Binding CanGoNext}" />
                                </StackPanel>
                            </Border>

                            <Border Padding="8,5"
                                    Background="{DynamicResource AccentSoftBrush}"
                                    BorderBrush="{DynamicResource RuleBrush}"
                                    BorderThickness="0,1,0,0"
                                    Visibility="{Binding ShowBatchBar, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding BatchSelectionText}"
                                               Margin="4,0,0,0"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource AccentBrush}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Style="{StaticResource IconBtn}"
                                                Command="{Binding BatchMarkReadCommand}" ToolTip="标为已读">
                                            <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IcoMail}" />
                                        </Button>
                                        <Button Style="{StaticResource IconBtn}" Margin="2,0,0,0"
                                                Command="{Binding BatchToggleStarCommand}" ToolTip="星标">
                                            <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IcoStar}" />
                                        </Button>
                                        <Button Style="{StaticResource IconBtn}" Margin="2,0,0,0"
                                                Command="{Binding ArchiveCommand}" ToolTip="归档到「邮件归档」">
                                            <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IcoArchive}" />
                                        </Button>
                                        <Button Style="{StaticResource IconBtn}" Margin="2,0,0,0"
                                                Command="{Binding DeleteMessageCommand}" ToolTip="移到垃圾箱">
                                            <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IcoTrash}" />
                                        </Button>
                                        <Rectangle Style="{StaticResource VDivider}" Height="14" Margin="6,0" />
                                        <Button Style="{StaticResource BtnGhost}" Padding="6,0"
                                                Content="取消" Command="{Binding ClearBatchSelectionCommand}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 右：阅读窗格 -->
                <Grid Grid.Column="2" Background="{DynamicResource ReaderBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 右侧上下文侧边栏：往来邮件 / 同发件人附件 -->
                    <Border Grid.Column="1" Grid.RowSpan="2" Width="290"
                            BorderBrush="{DynamicResource RuleBrush}" BorderThickness="1,0,0,0"
                            Background="{DynamicResource SidebarBrush}"
                            Visibility="{Binding IsContextSidebarVisible, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 头部只留标题：往来 / 附件数量已在下方的「往来邮件」卡片标题行显示，避免重复 -->
                            <Border Grid.Row="0" MinHeight="44" Padding="12,4" BorderBrush="{DynamicResource RuleBrush}" BorderThickness="0,0,0,1">
                                <TextBlock Style="{StaticResource PageTitle}"
                                           VerticalAlignment="Center"
                                           Text="邮件上下文" />
                            </Border>

                            <Border Grid.Row="1" Margin="10,10,10,5" Padding="9,8,9,8" CornerRadius="8"
                                    Background="{DynamicResource ReaderBrush}"
                                    BorderBrush="{DynamicResource RuleBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <TextBlock Style="{StaticResource LabelText}" Text="往来邮件" />
                                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Style="{StaticResource MutedText}" FontSize="11"
                                                   Text="{Binding ContextSidebarSummary}" />
                                    </Grid>
                                    <ListBox Grid.Row="1" Style="{StaticResource AppListBox}" Margin="0,6,0,0" VerticalAlignment="Stretch"
                                             Background="Transparent" BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ItemContainerStyle="{StaticResource CorrespondenceCardItem}"
                                             ItemsSource="{Binding Correspondence}"
                                             SelectedItem="{Binding SelectedCorrespondence, Mode=TwoWay}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <!-- 卡片三层：主题 / 正文摘要 / 时间（+附件标记）；未读时左侧留一道主色竖标 -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="10" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Width="3"
                                                            Margin="0,9"
                                                            CornerRadius="1.5"
                                                            HorizontalAlignment="Center"
                                                            Background="{DynamicResource AccentBrush}"
                                                            Visibility="{Binding IsUnread, Converter={StaticResource BoolToVisibility}}" />

                                                    <StackPanel Grid.Column="1" Margin="0,7,9,7">
                                                        <TextBlock Text="{Binding SubjectDisplay}"
                                                                   FontSize="12.5"
                                                                   TextTrimming="CharacterEllipsis">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="FontWeight" Value="Normal" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource Ink2Brush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsUnread}" Value="True">
                                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                                            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>

                                                        <TextBlock Style="{StaticResource MutedText}"
                                                                   FontSize="11.5"
                                                                   Margin="0,3,0,0"
                                                                   Text="{Binding PreviewDisplay}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibility}}" />

                                                        <Grid Margin="0,5,0,0">
                                                            <TextBlock Style="{StaticResource MutedText}"
                                                                       FontSize="11"
                                                                       Text="{Binding DateDetailDisplay}" />
                                                            <Path Style="{StaticResource IconPathSmall}"
                                                                  Width="12"
                                                                  Height="12"
                                                                  Data="{StaticResource IcoPaperclip}"
                                                                  Stroke="{DynamicResource MutedBrush}"
                                                                  HorizontalAlignment="Right"
                                                                  ToolTip="这封邮件带附件"
                                                                  Visibility="{Binding HasAttachment, Converter={StaticResource BoolToVisibility}}" />
                                                        </Grid>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Grid.Row="2" Style="{StaticResource MutedText}" Margin="2,6,0,0" Text="暂无往来邮件"
                                               Visibility="{Binding HasCorrespondence, Converter={StaticResource InverseBoolToVisibility}}" />
                                </Grid>
                            </Border>

                            <Border Grid.Row="2" Margin="10,5,10,10" Padding="9,8,9,8" CornerRadius="8"
                                    Background="{DynamicResource ReaderBrush}"
                                    BorderBrush="{DynamicResource RuleBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Style="{StaticResource LabelText}" Text="该发件人的附件" />
                                    <ListBox Grid.Row="1" Style="{StaticResource AppListBox}" Margin="0,6,0,0" VerticalAlignment="Stretch"
                                             Background="Transparent" BorderThickness="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ItemContainerStyle="{StaticResource SenderAttachmentCardItem}"
                                             ItemsSource="{Binding SenderAttachments}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding FileName}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource InkBrush}" />
                                                    <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="0,3,0,0" Text="{Binding SizeDisplay}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Grid.Row="2" Style="{StaticResource MutedText}" Margin="2,6,0,0" Text="暂无附件"
                                               Visibility="{Binding HasSenderAttachments, Converter={StaticResource InverseBoolToVisibility}}" />
                                </Grid>
                            </Border>

                            <!-- 邮件备注：仅本地保存，适合交接与随手记录 -->
                            <Border Grid.Row="3" Margin="10,5,10,10" Padding="9,8,9,8" CornerRadius="8"
                                    Background="{DynamicResource ReaderBrush}"
                                    BorderBrush="{DynamicResource RuleBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource LabelText}" Text="邮件备注（仅本地）" />
                                    <TextBox x:Name="NoteBox"
                                             Style="{StaticResource AppTextBox}"
                                             Margin="0,6,0,0"
                                             MinHeight="64"
                                             MaxHeight="120"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             Text="{Binding NoteText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Style="{StaticResource BtnPrimary}" Content="保存备注" Command="{Binding SaveNoteCommand}" />
                                        <TextBlock Style="{StaticResource MutedText}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                   Text="不会发送给收件人" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- 阅读工具条：与列表头 / 邮件上下文头同高（MinHeight=44），单行按钮垂直居中 -->
                    <Border Grid.Row="0"
                            MinHeight="44"
                            Padding="12,4"
                            BorderBrush="{DynamicResource RuleBrush}"
                            BorderThickness="0,0,0,1">
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource Btn}"
                                    Command="{Binding ReplyCommand}"
                                    IsEnabled="{Binding CanReplyOrForward}"
                                    ToolTip="回复发件人（草稿邮件不能回复）">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IcoReply}" />
                                    <TextBlock Text="回复" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Btn}"
                                    Margin="4,0,0,0"
                                    Command="{Binding ReplyAllCommand}"
                                    IsEnabled="{Binding CanReplyOrForward}"
                                    ToolTip="回复发件人及全部收件人（草稿邮件不能回复）">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IcoUsers}" />
                                    <TextBlock Text="回复全部" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Btn}"
                                    Margin="4,0,0,0"
                                    Command="{Binding ForwardCommand}"
                                    IsEnabled="{Binding CanReplyOrForward}"
                                    ToolTip="转发（草稿邮件不能转发）">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IcoForward}" />
                                    <TextBlock Text="转发" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource IconBtn}"
                                    Width="32"
                                    Height="32"
                                    Margin="4,0,0,0"
                                    Command="{Binding ForwardAsAttachmentCommand}"
                                    IsEnabled="{Binding CanReplyOrForward}"
                                    ToolTip="作为附件转发：把整封原邮件作为 .eml 附件发出去">
                                <Path Style="{StaticResource IconPathSmall}"
                                      Width="16"
                                      Height="16"
                                      Data="{StaticResource IcoPaperclip}" />
                            </Button>

                            <Rectangle Style="{StaticResource VDivider}" Margin="8,0" />

                            <!-- 次要操作：32px 图标按钮（图标 18px），图标本身说明动作：
                                 未读 → 对勾（标为已读）；已读 → 信封（标为未读）；已加星标 → 金色加粗；打印 → 打印机 -->
                            <Button Style="{StaticResource IconBtn}"
                                    Width="32"
                                    Height="32"
                                    Command="{Binding ToggleReadCommand}"
                                    ToolTip="{Binding ReadToggleText}"
                                    IsEnabled="{Binding HasSelection}">
                                <!-- 容器按图标自适应（图标 18px），不能再固定成 16×16：那会把 18px 的描边图标压小、看上去缺一块 -->
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Style="{StaticResource IconPathButton}"
                                          Data="{StaticResource IcoCheck}"
                                          Visibility="{Binding IsSelectedUnread, Converter={StaticResource BoolToVisibility}}" />
                                    <Path Style="{StaticResource IconPathButton}"
                                          Data="{StaticResource IcoMail}"
                                          Visibility="{Binding IsSelectedUnread, Converter={StaticResource InverseBoolToVisibility}}" />
                                    <!-- 未读点：信封右上角的小圆点，一眼看出「点了会标为未读」 -->
                                    <Ellipse Width="5"
                                             Height="5"
                                             Fill="{DynamicResource AccentBrush}"
                                             Stroke="{DynamicResource WindowBackgroundBrush}"
                                             StrokeThickness="1"
                                             HorizontalAlignment="Right"
                                             VerticalAlignment="Top"
                                             Margin="0,-1,-1,0"
                                             Visibility="{Binding IsSelectedUnread, Converter={StaticResource InverseBoolToVisibility}}" />
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource IconBtn}"
                                    Width="32"
                                    Height="32"
                                    Margin="4,0,0,0"
                                    Command="{Binding ToggleStarCommand}"
                                    IsEnabled="{Binding HasSelection}"
                                    ToolTip="星标 / 取消星标">
                                <Path Data="{StaticResource IcoStar}">
                                    <Path.Style>
                                        <Style TargetType="Path" BasedOn="{StaticResource IconPathButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelectedStarred}" Value="True">
                                                    <Setter Property="Stroke" Value="{DynamicResource WarnDotBrush}" />
                                                    <Setter Property="StrokeThickness" Value="2.2" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Button>
                            <Button Style="{StaticResource IconBtn}"
                                    Width="32"
                                    Height="32"
                                    Margin="4,0,0,0"
                                    Command="{Binding DeleteMessageCommand}"
                                    IsEnabled="{Binding HasSelection}"
                                    ToolTip="删除（移到垃圾箱）">
                                <Path Style="{StaticResource IconPathButton}" Data="{StaticResource IcoTrash}" />
                            </Button>
                            <Button Style="{StaticResource IconBtn}"
                                    Width="32"
                                    Height="32"
                                    Margin="4,0,0,0"
                                    Click="OnPrintMailClick"
                                    IsEnabled="{Binding HasSelection}"
                                    ToolTip="打印当前邮件（保留正文排版）">
                                <Path Style="{StaticResource IconPathButton}" Data="{StaticResource IcoPrint}" />
                            </Button>
                            <Button Style="{StaticResource IconBtn}"
                                    Width="32"
                                    Height="32"
                                    Margin="4,0,0,0"
                                    Command="{Binding SummarizeCommand}"
                                    IsEnabled="{Binding HasSelection}"
                                    ToolTip="AI 总结当前邮件（本机生成，不联网）">
                                <Path Style="{StaticResource IconPathButton}" Data="{StaticResource IcoSummary}" />
                            </Button>
                        </WrapPanel>
                    </Border>

                    <!-- 阅读区四段式：0 邮件头 / 1 AI 摘要卡 / 2 正文 / 3 提示条。
                         正文区必须独立滚动：WebView2 为 HWND 承载，不能放进外层 ScrollViewer。 -->
                    <Grid Grid.Row="1"
                          Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 区段 0：邮件头（固定；附件多时自身滚动，不挤压正文） -->
                        <Border Grid.Row="0"
                                BorderBrush="{DynamicResource RuleBrush}"
                                BorderThickness="0,0,0,1">
                            <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="22,18,22,14">
                                    <TextBox Style="{StaticResource SelectableText}"
                                             FontSize="18"
                                             FontWeight="SemiBold"
                                             Foreground="{DynamicResource InkBrush}"
                                             Text="{Binding Detail.SubjectDisplay, Mode=OneWay}" />

                                    <!-- 退信：投递失败退回，红色提示条排在钓鱼 / 陌生之前（最需要立刻处理） -->
                                    <Border Margin="0,10,0,0"
                                            Padding="10,8"
                                            CornerRadius="6"
                                            Background="{DynamicResource CriticalSoftBrush}"
                                            BorderBrush="{DynamicResource CriticalBrush}"
                                            BorderThickness="1"
                                            Visibility="{Binding ShowDetailBounce, Converter={StaticResource BoolToVisibility}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="0"
                                                  Style="{StaticResource IconPathSmall}"
                                                  VerticalAlignment="Center"
                                                  Stroke="{DynamicResource CriticalBrush}"
                                                  Data="{StaticResource IcoAlert}" />
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="投递失败 · 这封是退信"
                                                           FontSize="12.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource CriticalBrush}" />
                                                <TextBlock Text="{Binding DetailBounceLine}"
                                                           Margin="0,2,0,0"
                                                           FontSize="11.5"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource Ink2Brush}" />
                                                <TextBlock Text="这封邮件没有送达收件人，请换地址重发或电话确认，不要当成已送出。"
                                                           Margin="0,2,0,0"
                                                           FontSize="11.5"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource MutedBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- 疑似钓鱼：发件人域名与本机企业域名高度相似，红色警示排在陌生提示之前 -->
                                    <Border Margin="0,10,0,0"
                                            Padding="10,8"
                                            CornerRadius="6"
                                            Background="{DynamicResource CriticalSoftBrush}"
                                            BorderBrush="{DynamicResource CriticalBrush}"
                                            BorderThickness="1"
                                            Visibility="{Binding ShowDetailPhishing, Converter={StaticResource BoolToVisibility}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="0"
                                                  Style="{StaticResource IconPathSmall}"
                                                  VerticalAlignment="Center"
                                                  Stroke="{DynamicResource CriticalBrush}"
                                                  Data="{StaticResource IcoAlert}" />
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="警惕钓鱼 · 发件人域名与你自己的域名高度相似"
                                                           FontSize="12.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource CriticalBrush}" />
                                                <TextBlock Text="{Binding DetailPhishingHint}"
                                                           Margin="0,2,0,0"
                                                           FontSize="11.5"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource Ink2Brush}" />
                                                <TextBlock Text="在核实发件人身份之前，不要按邮件里的账号付款或变更收款信息。"
                                                           Margin="0,2,0,0"
                                                           FontSize="11.5"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource MutedBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- 陌生发件人：首次收到该地址来信，警告色提示 + 一键加入通讯录 -->
                                    <Border Margin="0,10,0,0"
                                            Padding="10,8"
                                            CornerRadius="6"
                                            Background="{DynamicResource WarningSoftBrush}"
                                            BorderBrush="{DynamicResource WarningBrush}"
                                            BorderThickness="1"
                                            Visibility="{Binding ShowDetailStranger, Converter={StaticResource BoolToVisibility}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="0"
                                                  Style="{StaticResource IconPathSmall}"
                                                  VerticalAlignment="Center"
                                                  Stroke="{DynamicResource WarningBrush}"
                                                  Data="{StaticResource IcoAlert}" />
                                            <StackPanel Grid.Column="1" Margin="8,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Text="陌生发件人 · 首次收到该地址来信"
                                                           FontSize="12.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource WarningBrush}" />
                                                <TextBlock Text="{Binding Detail.StrangerHint}"
                                                           Margin="0,2,0,0"
                                                           FontSize="11.5"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource Ink2Brush}" />
                                            </StackPanel>
                                            <Button Grid.Column="2"
                                                    Style="{StaticResource Btn}"
                                                    Height="26"
                                                    Padding="10,0"
                                                    VerticalAlignment="Center"
                                                    Content="加入通讯录"
                                                    ToolTip="把这个地址写进本地通讯录，以后的来信不再标为陌生（当前这封的标识保留）"
                                                    Command="{Binding JoinStrangerContactsCommand}"
                                                    Visibility="{Binding StrangerJoined, Converter={StaticResource InverseBoolToVisibility}}" />
                                            <TextBlock Grid.Column="2"
                                                       Margin="4,0,0,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="11.5"
                                                       Foreground="{DynamicResource WarningBrush}"
                                                       Text="已加入通讯录"
                                                       Visibility="{Binding StrangerJoined, Converter={StaticResource BoolToVisibility}}" />
                                        </Grid>
                                    </Border>

                                    <!-- 行业邮件类型：订舱确认 / SI / VGM / 提单草稿 / AN / 账单 / 查验 / 甩柜 / 延误 -->
                                    <Border Margin="0,10,0,0"
                                            Padding="10,7"
                                            CornerRadius="6"
                                            Background="{DynamicResource SidebarBrush}"
                                            BorderBrush="{DynamicResource RuleBrush}"
                                            BorderThickness="1"
                                            ToolTip="{Binding Detail.IndustryTypeHint}"
                                            Visibility="{Binding ShowDetailIndustryType, Converter={StaticResource BoolToVisibility}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0"
                                                    Width="8"
                                                    Height="8"
                                                    CornerRadius="4"
                                                    VerticalAlignment="Center"
                                                    Background="{Binding Detail.IndustryTypeColor, Converter={StaticResource HexToBrush}}" />
                                            <TextBlock Grid.Column="1"
                                                       Margin="7,0,0,0"
                                                       Style="{StaticResource LabelText}"
                                                       Text="邮件类型"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2"
                                                       Margin="6,0,0,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding Detail.IndustryTypeColor, Converter={StaticResource HexToBrush}}"
                                                       Text="{Binding Detail.IndustryTypeLabel}" />
                                        </Grid>
                                    </Border>

                                    <!-- 运输字段：箱型箱量 / 航线 / 贸易条款 / 金额（规则抽取，数字不改写） -->
                                    <Border Margin="0,10,0,0"
                                            Padding="10,7"
                                            CornerRadius="6"
                                            Background="{DynamicResource SidebarBrush}"
                                            BorderBrush="{DynamicResource RuleBrush}"
                                            BorderThickness="1"
                                            ToolTip="从主题与正文按规则抽取，原始数字不做改写"
                                            Visibility="{Binding Detail.HasShipmentFields, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource LabelText}"
                                                       Text="运输"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Margin="8,0,0,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Text="{Binding Detail.ShipmentSummary}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- 货代业务信息：主题 / 正文抽取的单号，点击按该单号聚合全库往来邮件 -->
                                    <Border Margin="0,10,0,0"
                                            Padding="10,9"
                                            CornerRadius="6"
                                            Background="{DynamicResource SidebarBrush}"
                                            BorderBrush="{DynamicResource RuleBrush}"
                                            BorderThickness="1"
                                            Visibility="{Binding HasDetailReferences, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Style="{StaticResource LabelText}" Text="业务信息" VerticalAlignment="Center" />
                                                <TextBlock HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           Text="点击单号聚合往来邮件" />
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding DetailReferences}" Margin="0,8,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource BtnGhost}"
                                                                Height="26"
                                                                Padding="8,0"
                                                                Margin="0,0,6,6"
                                                                Command="{Binding DataContext.FilterByReferenceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip="{Binding SearchText}">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Border Width="6"
                                                                        Height="6"
                                                                        CornerRadius="3"
                                                                        VerticalAlignment="Center"
                                                                        Background="{Binding KindColor, Converter={StaticResource HexToBrush}}" />
                                                                <TextBlock Text="{Binding KindLabel}"
                                                                           Margin="6,0,0,0"
                                                                           FontSize="11"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource MutedBrush}" />
                                                                <TextBlock Text="{Binding Value}"
                                                                           Margin="5,0,0,0"
                                                                           FontSize="11.5"
                                                                           FontWeight="SemiBold"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource InkBrush}" />
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- 时效节点：截关 / 补料 / VGM / ETD / ETA，带倒计时 -->
                                    <Border Margin="0,10,0,0"
                                            Padding="10,9"
                                            CornerRadius="6"
                                            Background="{DynamicResource SidebarBrush}"
                                            BorderBrush="{DynamicResource RuleBrush}"
                                            BorderThickness="1"
                                            Visibility="{Binding HasDetailDeadlines, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Style="{StaticResource LabelText}"
                                                           Text="时效节点"
                                                           VerticalAlignment="Center" />
                                                <Button Grid.Column="1"
                                                        Style="{StaticResource BtnGhost}"
                                                        Height="24"
                                                        Padding="8,0"
                                                        Content="查看一票货"
                                                        ToolTip="打开这票货的时间轴、节点与资料包"
                                                        Command="{Binding OpenDetailCaseCommand}"
                                                        Visibility="{Binding HasDetailCase, Converter={StaticResource BoolToVisibility}}" />
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding DetailDeadlines}" Margin="0,8,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,0,6,6"
                                                                Padding="8,4"
                                                                CornerRadius="6"
                                                                Background="{DynamicResource WindowBackgroundBrush}"
                                                                BorderBrush="{DynamicResource RuleBrush}"
                                                                BorderThickness="1"
                                                                ToolTip="{Binding Tooltip}">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Border Width="3"
                                                                        Height="16"
                                                                        CornerRadius="2"
                                                                        Margin="0,0,6,0"
                                                                        Background="{Binding KindColor, Converter={StaticResource HexToBrush}}" />
                                                                <TextBlock Text="{Binding KindLabel}"
                                                                           FontSize="11"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource MutedBrush}" />
                                                                <TextBlock Text="{Binding DueDayDisplay}"
                                                                           Margin="5,0,0,0"
                                                                           FontSize="11.5"
                                                                           FontWeight="SemiBold"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource InkBrush}" />
                                                                <TextBlock Text="{Binding CountdownText}"
                                                                           Margin="6,0,0,0"
                                                                           FontSize="11"
                                                                           FontWeight="SemiBold"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{Binding UrgencyColor, Converter={StaticResource HexToBrush}}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- 阅读收条请求：发件人要求回执时出现，发送后不再显示 -->
                                    <Border Margin="0,10,0,0" Padding="10,8" CornerRadius="6"
                                            Background="{DynamicResource AccentSoftBrush}"
                                            Visibility="{Binding CanSendReadReceipt, Converter={StaticResource BoolToVisibility}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource InkBrush}"
                                                       Text="发件人请求阅读收条，回复后会告知对方您已阅读这封邮件。" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource BtnGhost}" Content="忽略"
                                                        Command="{Binding DismissReadReceiptCommand}" />
                                                <Button Style="{StaticResource BtnPrimary}" Margin="6,0,0,0" Content="发送回执"
                                                        Command="{Binding SendReadReceiptCommand}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                            <Grid VerticalAlignment="Top">
                                                <Border Width="34"
                                                        Height="34"
                                                        CornerRadius="17"
                                                        Background="{Binding Detail.AvatarColor, Converter={StaticResource HexToBrush}}">
                                                    <TextBlock Text="{Binding Detail.Initial}"
                                                               Foreground="White"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Visibility="{Binding HasDetailAvatar, Converter={StaticResource InverseBoolToVisibility}}" />
                                                </Border>
                                                <!-- 发件人头像（Gravatar 命中才有） -->
                                                <Border Width="34"
                                                        Height="34"
                                                        CornerRadius="17"
                                                        Background="{Binding DetailAvatarBrush}"
                                                        Visibility="{Binding HasDetailAvatar, Converter={StaticResource BoolToVisibility}}" />
                                            </Grid>
                                        <Border x:Name="SenderBlock" Margin="6,-2,0,-2" VerticalAlignment="Center"
                                                    Cursor="Hand" MouseLeftButtonUp="OnContactCardClick">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="Transparent" />
                                                            <Setter Property="CornerRadius" Value="6" />
                                                            <Setter Property="Padding" Value="4,2" />
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>

                                            <StackPanel.ContextMenu>
                                                <ContextMenu Style="{StaticResource MailContextMenu}">
                                                    <MenuItem Style="{StaticResource MailContextMenuItem}" Header="写邮件"
                                                              Command="{Binding ComposeToAddressCommand}" CommandParameter="{Binding Detail.FromEmail}" />
                                                    <MenuItem Style="{StaticResource MailContextMenuItem}" Header="复制地址"
                                                              Command="{Binding CopyAddressCommand}" CommandParameter="{Binding Detail.FromEmail}" />
                                                    <MenuItem Style="{StaticResource MailContextMenuItem}" Header="查看往来邮件"
                                                              Command="{Binding SearchBySenderCommand}" CommandParameter="{Binding Detail.FromEmail}" />
                                                    <Separator Style="{StaticResource MailContextMenuSeparator}" />
                                                    <MenuItem Style="{StaticResource MailContextMenuItem}" Header="在通讯录中查看"
                                                              Command="{Binding OpenAddressBookCommand}" />
                                                </ContextMenu>
                                            </StackPanel.ContextMenu>
                                            <TextBox Style="{StaticResource SelectableText}"
                                                     FontSize="13"
                                                     FontWeight="SemiBold"
                                                     Foreground="{DynamicResource InkBrush}"
                                                     TextWrapping="NoWrap"
                                                     Text="{Binding Detail.FromDisplay, Mode=OneWay}" IsHitTestVisible="False" />
                                            <TextBox Style="{StaticResource SelectableText}"
                                                     TextWrapping="NoWrap"
                                                     Text="{Binding Detail.FromEmail, Mode=OneWay}" IsHitTestVisible="False" />

                                            <!-- 单击发件人弹出的联系人卡片（单击触发，非 hover） -->
                                            <Popup PlacementTarget="{Binding ElementName=SenderBlock}"
                                                   Placement="Bottom"
                                                   StaysOpen="False"
                                                   AllowsTransparency="True"
                                                   IsOpen="{Binding IsContactCardOpen, Mode=TwoWay}">
                                                <Border Margin="0,6,0,0" Width="280" Padding="14" CornerRadius="8"
                                                        Background="{DynamicResource WindowBackgroundBrush}"
                                                        BorderBrush="{DynamicResource RuleStrongBrush}"
                                                        BorderThickness="1">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.18" Color="#0F172A" />
                                                    </Border.Effect>
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Grid VerticalAlignment="Top">
                                                                <Border Width="40" Height="40" CornerRadius="20"
                                                                        Background="{Binding Detail.AvatarColor, Converter={StaticResource HexToBrush}}">
                                                                    <TextBlock Text="{Binding Detail.Initial}" Foreground="White" FontWeight="SemiBold"
                                                                               FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                               Visibility="{Binding HasDetailAvatar, Converter={StaticResource InverseBoolToVisibility}}" />
                                                                </Border>
                                                                <!-- 发件人头像（Gravatar 命中才有） -->
                                                                <Border Width="40" Height="40" CornerRadius="20"
                                                                        Background="{Binding DetailAvatarBrush}"
                                                                        Visibility="{Binding HasDetailAvatar, Converter={StaticResource BoolToVisibility}}" />
                                                            </Grid>
                                                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Detail.FromDisplay}" FontSize="13.5" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource InkBrush}" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding Detail.FromEmail}" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                                            <Button Style="{StaticResource BtnPrimary}" Padding="12,0" Content="写邮件"
                                                                    Command="{Binding ComposeToAddressCommand}" CommandParameter="{Binding Detail.FromEmail}" />
                                                            <Button Style="{StaticResource BtnGhost}" Padding="12,0" Margin="6,0,0,0" Content="相关邮件"
                                                                    Command="{Binding SearchBySenderCommand}" CommandParameter="{Binding Detail.FromEmail}" />
                                                            <Button Style="{StaticResource BtnGhost}" Padding="12,0" Margin="6,0,0,0" Content="复制地址"
                                                                    Command="{Binding CopyAddressCommand}" CommandParameter="{Binding Detail.FromEmail}" />
                                                            <Button Style="{StaticResource BtnGhost}" Padding="12,0" Margin="6,0,0,0" Content="详细信息"
                                                                    Command="{Binding OpenAddressBookCommand}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </Popup>
                                        </StackPanel>
                                        </Border>
                                        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                            <TextBox Style="{StaticResource SelectableText}"
                                                     TextWrapping="NoWrap"
                                                     Text="{Binding Detail.FullDateDisplay, Mode=OneWay}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Style="{StaticResource MutedText}" Text="大小：" />
                                                <TextBlock Style="{StaticResource MutedText}"
                                                           Text="{Binding SizeDisplayText,
                                                                  Mode=OneWay,
                                                                  FallbackValue=未知,
                                                                  TargetNullValue=未知}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- 收件地址：逐个地址渲染，hover / 左键卡片 / 右键菜单都作用于单个地址 -->
                                    <WrapPanel Margin="0,8,0,0">
                                        <TextBlock Text="收件人：" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,2,0" />
                                        <ItemsControl ItemsSource="{Binding RecipientAddresses}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Border x:Name="Chip" Padding="4,2" Margin="0,0,2,0" CornerRadius="6" Cursor="Hand"
                                                                VerticalAlignment="Center"
                                                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                MouseLeftButtonUp="OnAddressChipClick">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="Transparent" />
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Border.ContextMenu>
                                                                <ContextMenu Style="{StaticResource MailContextMenu}"
                                                                             DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                                    <MenuItem Style="{StaticResource MailContextMenuItem}" Header="写邮件"
                                                                              Command="{Binding PlacementTarget.Tag.ComposeToAddressCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding Address}" />
                                                                    <MenuItem Style="{StaticResource MailContextMenuItem}" Header="复制地址"
                                                                              Command="{Binding PlacementTarget.Tag.CopyAddressCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding Address}" />
                                                                    <MenuItem Style="{StaticResource MailContextMenuItem}" Header="查看往来邮件"
                                                                              Command="{Binding PlacementTarget.Tag.SearchBySenderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding Address}" />
                                                                    <Separator Style="{StaticResource MailContextMenuSeparator}" />
                                                                    <MenuItem Style="{StaticResource MailContextMenuItem}" Header="在通讯录中查看"
                                                                              Command="{Binding PlacementTarget.Tag.OpenAddressBookCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                                </ContextMenu>
                                                            </Border.ContextMenu>
                                                            <TextBlock Text="{Binding Display}" FontSize="12.5" Foreground="{DynamicResource Ink2Brush}" TextTrimming="CharacterEllipsis" MaxWidth="260" />
                                                        </Border>
                                                        <Popup PlacementTarget="{Binding ElementName=Chip}" Placement="Bottom" StaysOpen="False"
                                                               AllowsTransparency="True" IsOpen="{Binding IsCardOpen, Mode=TwoWay}">
                                                            <Border Margin="0,6,0,0" Width="280" Padding="14" CornerRadius="8"
                                                                    Background="{DynamicResource WindowBackgroundBrush}"
                                                                    BorderBrush="{DynamicResource RuleStrongBrush}" BorderThickness="1">
                                                                <Border.Effect>
                                                                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.18" Color="#0F172A" />
                                                                </Border.Effect>
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding GroupLabel}" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                                                                    <TextBlock Text="{Binding Display}" FontSize="13.5" FontWeight="SemiBold" Margin="0,4,0,0"
                                                                               Foreground="{DynamicResource InkBrush}" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding Address}" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                                                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                                                        <Button Style="{StaticResource BtnPrimary}" Padding="12,0" Content="写邮件"
                                                                                Command="{Binding PlacementTarget.Tag.ComposeToAddressCommand, RelativeSource={RelativeSource AncestorType=Popup}}" CommandParameter="{Binding Address}" />
                                                                        <Button Style="{StaticResource BtnGhost}" Padding="12,0" Margin="6,0,0,0" Content="相关邮件"
                                                                                Command="{Binding PlacementTarget.Tag.SearchBySenderCommand, RelativeSource={RelativeSource AncestorType=Popup}}" CommandParameter="{Binding Address}" />
                                                                        <Button Style="{StaticResource BtnGhost}" Padding="12,0" Margin="6,0,0,0" Content="复制地址"
                                                                                Command="{Binding PlacementTarget.Tag.CopyAddressCommand, RelativeSource={RelativeSource AncestorType=Popup}}" CommandParameter="{Binding Address}" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Border>
                                                        </Popup>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </WrapPanel>
                                    <!-- 抄送 / 密送：和收件人一样逐个地址渲染（悬停高亮 / 左键卡片 / 右键菜单） -->
                                    <WrapPanel Margin="0,4,0,0"
                                               Visibility="{Binding HasCc, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="抄送：" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,2,0" />
                                        <ItemsControl ItemsSource="{Binding CcAddresses}"
                                                      ItemTemplate="{StaticResource AddressChipTemplate}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </WrapPanel>
                                    <WrapPanel Margin="0,4,0,0"
                                               Visibility="{Binding HasBcc, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="密送：" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,2,0" />
                                        <ItemsControl ItemsSource="{Binding BccAddresses}"
                                                      ItemTemplate="{StaticResource AddressChipTemplate}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </WrapPanel>

                                    <StackPanel Margin="0,12,0,0"
                                                Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="附件"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource InkBrush}" />
                                            <TextBlock Style="{StaticResource MutedText}"
                                                       Margin="6,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding VisibleAttachments.Count, StringFormat=（{0} 个）}" />
                                            <Button Style="{StaticResource Btn}"
                                                    Margin="10,0,0,0"
                                                    Height="26"
                                                    Padding="10,0"
                                                    Command="{Binding SaveAllAttachmentsCommand}"
                                                    ToolTip="把所有附件保存到同一目录">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IcoFolder}" />
                                                    <TextBlock Text="全部保存" Margin="6,0,0,0" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>

                                        <ItemsControl Margin="0,8,0,0"
                                                      ItemsSource="{Binding VisibleAttachments}"
                                                      ItemTemplate="{StaticResource AttachmentTemplate}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- 邮件备注：头部只读展示，点击跳到右侧备注框编辑 -->
                                    <Border Margin="0,12,0,0" Padding="10,7" CornerRadius="6"
                                            Background="{DynamicResource AccentSoftBrush}"
                                            BorderBrush="{DynamicResource RuleBrush}" BorderThickness="1"
                                            Cursor="Hand" MouseLeftButtonUp="OnNoteRowClick"
                                            Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="0" Style="{StaticResource IconPathSmall}"
                                                  Data="{StaticResource IcoDraft}" Stroke="{DynamicResource AccentBrush}"
                                                  VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="备注" Margin="6,0,0,0" FontSize="11"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
                                            <TextBlock Grid.Column="2" Text="{Binding NoteText}" Margin="8,0,0,0" FontSize="12"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding NoteText}"
                                                       Foreground="{DynamicResource InkBrush}" />
                                        </Grid>
                                    </Border>
                                    <!-- 标签行：邮件头最底部，作为这封邮件的标注（正文开始前最后一行） -->
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <ItemsControl Grid.Column="0"
                                                      VerticalAlignment="Center"
                                                      ItemsSource="{Binding DetailTags}"
                                                      Visibility="{Binding HasDetailTags, Converter={StaticResource BoolToVisibility}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <!-- 与列表同一套实心标签胶囊 -->
                                                    <Border Style="{StaticResource TagChip}"
                                                            Margin="0,0,6,4"
                                                            Background="{Binding Color, Converter={StaticResource HexToBrush}}">
                                                        <TextBlock Style="{StaticResource TagChipText}" Text="{Binding Name}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Button Grid.Column="1"
                                                Style="{StaticResource Btn}"
                                                Padding="10,0"
                                                Height="26"
                                                Margin="8,0,0,4"
                                                VerticalAlignment="Center"
                                                Command="{Binding TagSelectedCommand}"
                                                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}"
                                                ToolTip="为当前邮件打标签（Ctrl+数字 可跳转标签视图）">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IcoPlus}" />
                                                <TextBlock Text="标签" Margin="6,0,0,0" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- 区段 1：AI 摘要卡（收起时不占位） -->
                        <ct:MailSummaryCard Grid.Row="1" Margin="16,12,16,0" DataContext="{Binding Summary}" />

                        <!-- 区段 2：正文（内部滚动） -->
                        <Grid Grid.Row="2">
                            <!-- 正文下载中 / 需要用户重新获取时整块收起来：邮件头已经可读，正文区让位给占位。
                                 注意：WebView2 是独立 HWND，只要它还在渲染就会盖住同层的 WPF 元素，
                                 所以「重新获取正文」卡片出现时必须把这块连同 WebView2 一起隐藏。 -->
                            <Grid Visibility="{Binding ShowBodyContent, Converter={StaticResource BoolToVisibility}}">
                                <views:MailBodyView x:Name="BodyView"
                                                    UseHtml="{Binding UseHtmlRendering}"
                                                    Document="{Binding BodyHtmlDocument}"
                                                    PlainText="{Binding BodyDisplay}"
                                                    HtmlSource="{Binding BodyHtmlSource}"
                                                    InlineImagePaths="{Binding InlineImagePaths}"
                                                    BodyFontSize="{Binding BodyFontSize}"
                                                    IsDark="{Binding IsDark}"
                                                    EmlDirectory="{Binding EmlDirectory}"
                                                    Visibility="{Binding IsLocked, Converter={StaticResource InverseBoolToVisibility}}" />
                            </Grid>

                            <!-- 正文按需下载中：邮件头已展示，这里只等正文 -->
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding IsBodyLoading, Converter={StaticResource BoolToVisibility}}">
                                <ProgressBar Width="120"
                                             Height="4"
                                             IsIndeterminate="True"
                                             HorizontalAlignment="Center"
                                             Foreground="{DynamicResource AccentBrush}"
                                             Background="{DynamicResource RuleBrush}"
                                             BorderThickness="0" />
                                <TextBlock Text="正在下载正文…"
                                           Style="{StaticResource MutedText}"
                                           Margin="0,10,0,0"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="邮件头已显示，可以先看主题、发件人与附件"
                                           Style="{StaticResource MutedText}"
                                           Margin="0,4,0,0"
                                           HorizontalAlignment="Center" />
                            </StackPanel>

                            <!-- 正文没取到（上次解析失败 / 缓存被清 / 服务器返回空体）：给一个手动补救入口。
                                 这类邮件本地状态是「已下载 + 空正文」，不会再自动重拉，只能由用户点一下。 -->
                            <Border HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    MaxWidth="480"
                                    MinWidth="380"
                                    Padding="30,28"
                                    Background="{DynamicResource AccentSoftBrush}"
                                    BorderBrush="{DynamicResource AccentBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Visibility="{Binding ShowReloadBodyButton, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Path Style="{StaticResource IconPathButton}"
                                              Data="{StaticResource IcoAlert}"
                                              Stroke="{DynamicResource AccentBrush}"
                                              VerticalAlignment="Center" />
                                        <TextBlock Text="没有取到正文内容"
                                                   Margin="8,0,0,0"
                                                   FontSize="16.5"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource InkBrush}" />
                                    </StackPanel>
                                    <TextBlock Margin="0,12,0,0"
                                               MaxWidth="400"
                                               FontSize="12.5"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource Ink2Brush}"
                                               Text="可能是上次下载没完成或解析失败。若这封邮件本来有正文，重新获取会再向服务器拉一次。" />
                                    <Button Style="{StaticResource BtnPrimary}"
                                            Margin="0,20,0,0"
                                            MinWidth="184"
                                            MinHeight="38"
                                            FontSize="13.5"
                                            HorizontalAlignment="Center"
                                            Content="重新获取正文"
                                            Command="{Binding ReloadBodyCommand}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 区段 3：正文提示条（远程图片默认阻止，按需放行） -->
                        <Border Grid.Row="3"
                                Padding="18,8"
                                BorderBrush="{DynamicResource RuleBrush}"
                                BorderThickness="0,1,0,0"
                                Background="{DynamicResource ChromeBrush}"
                                Visibility="{Binding ShowRemoteImagesPrompt, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource MutedText}"
                                           VerticalAlignment="Center"
                                           Text="此邮件包含远程图片，已默认阻止（防追踪像素）。" />
                                <Button Style="{StaticResource BtnGhost}"
                                        Margin="10,0,0,0"
                                        Height="26"
                                        Content="显示图片"
                                        Command="{Binding LoadRemoteImagesCommand}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 详情尚未到达：居中动态加载态 -->
                    <StackPanel Grid.Row="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Visibility="{Binding ShowDetailLoading, Converter={StaticResource BoolToVisibility}}">
                        <ProgressBar Width="150"
                                     Height="4"
                                     IsIndeterminate="True"
                                     Foreground="{DynamicResource AccentBrush}"
                                     Background="{DynamicResource RuleBrush}"
                                     BorderThickness="0"
                                     HorizontalAlignment="Center" />
                        <TextBlock Text="正在加载邮件…"
                                   Style="{StaticResource MutedText}"
                                   Margin="0,12,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- 未选中任何邮件：空态占位 -->
                    <StackPanel Grid.Row="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Visibility="{Binding ShowDetailPlaceholder, Converter={StaticResource BoolToVisibility}}">
                        <Path Style="{StaticResource IconPath}"
                              Width="34"
                              Height="34"
                              Data="{StaticResource IcoMail}"
                              Stroke="{DynamicResource RuleStrongBrush}"
                              HorizontalAlignment="Center" />
                        <TextBlock Text="选择一封邮件开始阅读"
                                   Style="{StaticResource MutedText}"
                                   Margin="0,10,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ============ 状态栏 ============ -->
            <Border Grid.Row="4"
                    Height="32"
                    Background="{DynamicResource ChromeBrush}"
                    BorderBrush="{DynamicResource RuleBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="14,4">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource OkDotBrush}" VerticalAlignment="Center" />
                        <TextBlock Style="{StaticResource MutedText}"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="{Binding StatusText}" />
                        <!-- 同步进度：放在状态栏而不是工具栏，避免同步时把右侧入口挤出窗口 -->
                        <ProgressBar Width="90"
                                     Height="3"
                                     Margin="10,0,0,0"
                                     VerticalAlignment="Center"
                                     Maximum="100"
                                     Value="{Binding SyncPercent}"
                                     IsIndeterminate="{Binding IsSyncIndeterminate}"
                                     Foreground="{DynamicResource AccentBrush}"
                                     Background="{DynamicResource RuleBrush}"
                                     BorderThickness="0"
                                     Visibility="{Binding IsSyncing, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- 升级标识：只在发现新版本 / 下载中 / 待安装时出现，点击打开升级窗口 -->
                        <Button Style="{StaticResource StatusBarButton}"
                                Padding="6,0"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Command="{Binding ShowUpdateWindowCommand}"
                                ToolTip="{Binding UpdateBadgeToolTip}"
                                Visibility="{Binding HasUpdateBadge, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource IconPathSmall}"
                                      Data="{StaticResource IcoRefresh}"
                                      Stroke="{DynamicResource AccentBrush}" />
                                <TextBlock Margin="6,0,0,0"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}"
                                           Text="{Binding UpdateBadgeText}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource StatusBarButton}"
                                Padding="4,0"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Command="{Binding UndoDeleteCommand}"
                                Visibility="{Binding CanUndoDelete, Converter={StaticResource BoolToVisibility}}"
                                ToolTip="撤销最近一次尚未同步到服务器的删除">
                            <TextBlock Style="{StaticResource MutedText}" Text="撤销删除" />
                        </Button>
                        <Button Style="{StaticResource StatusBarButton}"
                                Padding="4,0"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Command="{Binding RetryPendingCommand}"
                                Visibility="{Binding HasPendingSync, Converter={StaticResource BoolToVisibility}}"
                                ToolTip="本地已生效但服务器尚未确认的操作，点击立即重试；右键查看明细">
                            <Button.ContextMenu>
                                <ContextMenu Style="{StaticResource MailContextMenu}">
                                    <MenuItem Style="{StaticResource MailContextMenuItem}"
                                              Header="立即重试"
                                              Command="{Binding RetryPendingCommand}" />
                                    <MenuItem Style="{StaticResource MailContextMenuItem}"
                                              Header="查看待同步明细…"
                                              Command="{Binding ShowPendingSyncCommand}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                            <TextBlock Style="{StaticResource MutedText}"
                                       Text="{Binding PendingSyncText}"
                                       Foreground="{DynamicResource WarningBrush}" />
                        </Button>
                        <TextBlock Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center"
                                   Text="{Binding LocalUnread, StringFormat=未读 {0} 封}" />
                        <Rectangle Style="{StaticResource VDivider}" Height="12" Margin="10,0" />
                        <TextBlock Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center"
                                   Text="{Binding LocalTotal, StringFormat=本地数据库 {0} 封}" />
                        <Rectangle Style="{StaticResource VDivider}" Height="12" Margin="10,0" />
                        <Button Style="{StaticResource StatusBarButton}"
                                Padding="4,0"
                                VerticalAlignment="Center"
                                Command="{Binding OpenCleanupCommand}"
                                ToolTip="查看本地存储占用详情并清理历史邮件">
                            <TextBlock Style="{StaticResource MutedText}" Text="{Binding StorageStatus}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ 客户端锁定遮罩 ============ -->
            <Grid Grid.RowSpan="5"
                  Panel.ZIndex="100"
                  Background="{DynamicResource WindowBackgroundBrush}"
                  Visibility="{Binding IsLocked, Converter={StaticResource BoolToVisibility}}">
                <Border Width="400"
                        Padding="30,28"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{DynamicResource ReaderBrush}"
                        BorderBrush="{DynamicResource RuleStrongBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <StackPanel>
                        <Path Width="34"
                              Height="34"
                              HorizontalAlignment="Center"
                              Style="{StaticResource IconPathSmall}"
                              Data="{StaticResource IcoLock}"
                              Stroke="{DynamicResource AccentBrush}"
                              StrokeThickness="1.6" />
                        <TextBlock Margin="0,14,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource InkBrush}"
                                   Text="客户端已锁定" />
                        <TextBlock Margin="0,8,0,0"
                                   HorizontalAlignment="Center"
                                   Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap"
                                   Text="输入锁定密码后继续查看邮件" />

                        <PasswordBox x:Name="UnlockPasswordBox"
                                     Margin="0,18,0,0"
                                     Style="{StaticResource AppPasswordBox}"
                                     KeyDown="OnUnlockPasswordKeyDown" />

                        <TextBlock Margin="0,8,0,0"
                                   Foreground="{DynamicResource ErrorDotBrush}"
                                   Text="{Binding UnlockError}"
                                   Visibility="{Binding UnlockError, Converter={StaticResource NotEmptyToVisibility}}" />

                        <Button Margin="0,16,0,0"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource BtnPrimary}"
                                Content="解锁"
                                Click="OnUnlockClick" />

                        <Button Margin="0,10,0,0"
                                HorizontalAlignment="Center"
                                Style="{StaticResource BtnGhost}"
                                Content="退出应用"
                                Click="OnLockExitClick" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
