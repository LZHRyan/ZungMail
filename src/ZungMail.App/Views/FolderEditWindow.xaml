<views:DialogWindow x:Class="ZungMail.App.Views.FolderEditWindow"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:views="clr-namespace:ZungMail.App.Views"
                     Title="文件夹"
                     Width="460"
                     Height="330"
                     ResizeMode="NoResize"
                     Background="{DynamicResource WindowBackgroundBrush}"
                     FontFamily="{StaticResource AppFont}"
                     FontSize="13">

    <Border BorderBrush="{DynamicResource RuleStrongBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource ChromeBrush}"
                    BorderBrush="{DynamicResource RuleBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="OnTitleBarMouseDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                        <Border Width="20" Height="20" CornerRadius="6" Background="{DynamicResource BrandMarkBrush}">
                            <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IcoFolder}" Stroke="White" />
                        </Border>
                        <TextBlock Text="{Binding Title}"
                                   FontWeight="SemiBold"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource InkBrush}" />
                    </StackPanel>

                    <Button Style="{StaticResource WinBtnClose}"
                            HorizontalAlignment="Right"
                            Command="{x:Static SystemCommands.CloseWindowCommand}"
                            CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                            ToolTip="关闭">
                        <Path Style="{StaticResource IconPathSmall}"
                              Data="{StaticResource IcoClose}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="20,16,20,12">
                <TextBlock Style="{StaticResource MutedText}" Text="{Binding AccountName, StringFormat=账户：{0}}" />
                <TextBlock Style="{StaticResource MutedText}" Margin="0,3,0,0" Text="{Binding ParentPath, StringFormat=位置：{0}}" />

                <TextBlock Style="{StaticResource LabelText}" Text="文件夹名称" Margin="0,16,0,0" />
                <TextBox x:Name="NameBox"
                         Style="{StaticResource AppTextBox}"
                         Margin="0,5,0,0"
                         KeyDown="OnNameKeyDown"
                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Style="{StaticResource MutedText}"
                           Margin="0,6,0,0"
                           Text="{Binding FullPathPreview, StringFormat=完整路径：{0}}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Style="{StaticResource MutedText}"
                           Margin="0,8,0,0"
                           Foreground="{DynamicResource ErrorDotBrush}"
                           Text="{Binding StatusText}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Border Grid.Row="2"
                    Padding="16,10"
                    BorderBrush="{DynamicResource RuleBrush}"
                    BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource Btn}"
                            Content="取消"
                            IsCancel="True"
                            Command="{Binding CancelCommand}" />
                    <Button Style="{StaticResource BtnPrimary}"
                            Margin="8,0,0,0"
                            Content="保存"
                            Command="{Binding SaveCommand}" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</views:DialogWindow>
