<views:DialogWindow x:Class="ZungMail.App.Views.CleanupWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:ZungMail.App.Views"
                    Title="历史邮件清理"
                    Width="1120"
                    Height="780"
                    MinWidth="900"
                    MinHeight="620"
                    Background="{DynamicResource WindowBackgroundBrush}"
                    FontFamily="{StaticResource AppFont}"
                    FontSize="13">

    <views:DialogWindow.Resources>

        <DataTemplate x:Key="PreviewRowTemplate">
            <Grid Margin="8,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Column="0"
                          VerticalAlignment="Center"
                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                          Click="OnPreviewItemClick" />

                <StackPanel Grid.Column="1" Margin="8,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding SubjectDisplay}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource InkBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <Border Background="{DynamicResource AccentSoftBrush}"
                                CornerRadius="6"
                                Padding="6,0"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="星标"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Visibility="{Binding IsStarred, Converter={StaticResource BoolToVisibility}}" />
                        </Border>
                        <Border Background="{DynamicResource BadgeGrayBackgroundBrush}"
                                CornerRadius="6"
                                Padding="6,0"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="未读"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource BadgeGrayBrush}"
                                       Visibility="{Binding IsUnread, Converter={StaticResource BoolToVisibility}}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Style="{StaticResource MutedText}"
                               Margin="0,3,0,0"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding FromEmail}" />
                </StackPanel>

                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource MutedText}"
                               HorizontalAlignment="Right"
                               Text="{Binding DateDisplay}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,3,0,0">
                        <TextBlock Style="{StaticResource MutedText}" Text="{Binding FolderName}" />
                        <Rectangle Style="{StaticResource VDivider}" Height="11" Margin="6,0" />
                        <TextBlock Style="{StaticResource MutedText}" Text="{Binding SizeDisplay}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="JobRowTemplate">
            <Grid Margin="8,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="24"
                        Height="24"
                        CornerRadius="8"
                        Background="{DynamicResource AccentSoftBrush}"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding Id}"
                               FontSize="10.5"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" Margin="8,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ModeDisplay}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource InkBrush}" />
                        <Rectangle Style="{StaticResource VDivider}" Height="11" Margin="8,0" />
                        <TextBlock Style="{StaticResource MutedText}" Text="{Binding StatusDisplay}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource MutedText}"
                               Margin="0,3,0,0"
                               Text="{Binding SummaryDisplay}" />
                </StackPanel>

                <TextBlock Grid.Column="2"
                           Style="{StaticResource MutedText}"
                           VerticalAlignment="Center"
                           Text="{Binding StartedDisplay}" />
            </Grid>
        </DataTemplate>

        <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource PageTitle}">
            <Setter Property="FontSize" Value="13.5" />
        </Style>

        <Style x:Key="RowCheckBox" TargetType="CheckBox" BasedOn="{StaticResource AppCheckBox}">
            <Setter Property="Margin" Value="0,7,0,0" />
        </Style>

        <Style x:Key="FilterLabel" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>

    </views:DialogWindow.Resources>

    <Border BorderBrush="{DynamicResource RuleStrongBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0"
                    Background="{DynamicResource ChromeBrush}"
                    BorderBrush="{DynamicResource RuleBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="OnTitleBarMouseDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                        <Border Width="20" Height="20" CornerRadius="6" Background="{DynamicResource BrandMarkBrush}">
                            <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IcoTrash}" Stroke="White" />
                        </Border>
                        <TextBlock Text="历史邮件清理"
                                   FontWeight="SemiBold"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource InkBrush}" />
                        <TextBlock Style="{StaticResource MutedText}"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="隔离区可撤销 · 审计记录可追溯" />
                    </StackPanel>

                    <Button Style="{StaticResource WinBtnClose}"
                            HorizontalAlignment="Right"
                            Command="{x:Static SystemCommands.CloseWindowCommand}"
                            CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                            ToolTip="关闭">
                        <Path Style="{StaticResource IconPathSmall}"
                              Data="{StaticResource IcoClose}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </Grid>
            </Border>

            <!-- 主体 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="312" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左：筛选条件 -->
                <Border Grid.Column="0"
                        Background="{DynamicResource SidebarBrush}"
                        BorderBrush="{DynamicResource RuleBrush}"
                        BorderThickness="0,0,1,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16,14,16,16">

                            <TextBlock Style="{StaticResource CardTitle}" Text="文件夹范围" />
                            <CheckBox Style="{StaticResource RowCheckBox}" Content="垃圾箱" IsChecked="{Binding IncludeTrash}" />
                            <CheckBox Style="{StaticResource RowCheckBox}" Content="广告邮件" IsChecked="{Binding IncludeJunk}" />
                            <CheckBox Style="{StaticResource RowCheckBox}" Content="归档邮件" IsChecked="{Binding IncludeArchive}" />
                            <CheckBox Style="{StaticResource RowCheckBox}" Content="收件箱" IsChecked="{Binding IncludeInbox}" />
                            <CheckBox Style="{StaticResource RowCheckBox}" Content="已发送" IsChecked="{Binding IncludeSent}" />

                            <Rectangle Height="1" Fill="{DynamicResource RuleBrush}" Margin="0,14,0,0" />

                            <TextBlock Style="{StaticResource CardTitle}" Margin="0,14,0,0" Text="时间范围" />
                            <TextBlock Style="{StaticResource FilterLabel}" Text="早于" />
                            <DatePicker SelectedDate="{Binding BeforeDate, Mode=TwoWay}" />
                            <TextBlock Style="{StaticResource FilterLabel}" Text="晚于（可选）" />
                            <DatePicker SelectedDate="{Binding AfterDate, Mode=TwoWay}" />

                            <TextBlock Style="{StaticResource CardTitle}" Margin="0,16,0,0" Text="邮件大小" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBox Style="{StaticResource AppTextBox}"
                                         Width="96"
                                         Text="{Binding MinSizeMb, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Style="{StaticResource MutedText}"
                                           Margin="6,0"
                                           VerticalAlignment="Center"
                                           Text="～" />
                                <TextBox Style="{StaticResource AppTextBox}"
                                         Width="96"
                                         Text="{Binding MaxSizeMb, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Style="{StaticResource MutedText}"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="MB" />
                            </StackPanel>

                            <TextBlock Style="{StaticResource CardTitle}" Margin="0,16,0,0" Text="附件类型" />
                            <TextBox Style="{StaticResource AppTextBox}"
                                     Margin="0,8,0,0"
                                     Text="{Binding Extensions, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="逗号分隔，如 pdf,zip,docx；留空表示不限" />
                            <CheckBox Style="{StaticResource RowCheckBox}"
                                      Content="仅清理带附件的邮件"
                                      IsChecked="{Binding OnlyWithAttachments}" />

                            <Rectangle Height="1" Fill="{DynamicResource RuleBrush}" Margin="0,14,0,0" />

                            <TextBlock Style="{StaticResource CardTitle}" Margin="0,14,0,0" Text="误删保护" />
                            <CheckBox Style="{StaticResource RowCheckBox}"
                                      Content="保护星标邮件"
                                      IsChecked="{Binding ProtectStarred}" />
                            <CheckBox Style="{StaticResource RowCheckBox}"
                                      Content="保护未读邮件"
                                      IsChecked="{Binding ProtectUnread}" />
                            <TextBlock Style="{StaticResource MutedText}"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       Text="草稿邮件始终排除，不会被清理。" />

                            <Rectangle Height="1" Fill="{DynamicResource RuleBrush}" Margin="0,14,0,0" />

                            <TextBlock Style="{StaticResource CardTitle}" Margin="0,14,0,0" Text="清理方式" />
                            <CheckBox Style="{StaticResource RowCheckBox}"
                                      Content="仅清理正文和附件（保留邮件头）"
                                      IsChecked="{Binding ClearBodyOnly, Mode=TwoWay}" />
                            <TextBlock Style="{StaticResource MutedText}"
                                       Margin="0,4,0,0"
                                       FontSize="11.5"
                                       TextWrapping="Wrap"
                                       Text="勾选后不删除邮件本身：只清空已下载正文、删除附件文件，邮件头与列表保留，阅读时重新下载。该模式不进入隔离区，不可撤销。" />

                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Style="{StaticResource Btn}"
                                        Content="预览匹配"
                                        Command="{Binding PreviewCommand}"
                                        IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}" />
                                <Button Style="{StaticResource BtnPrimary}"
                                        Margin="8,0,0,0"
                                        Content="{Binding CleanupByFilterText}"
                                        Command="{Binding CleanupByFilterCommand}"
                                        IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- 右：存储概况 + 预览 + 记录 -->
                <Grid Grid.Column="1" Margin="16,14,16,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="186" />
                    </Grid.RowDefinitions>

                    <!-- 存储概况 -->
                    <Border Grid.Row="0" Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource IconPathSmall}"
                                      Data="{StaticResource IcoDatabase}"
                                      Stroke="{DynamicResource AccentBrush}"
                                      VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource CardTitle}"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="本地存储" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource MutedText}"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       Text="{Binding StorageSummary}" />
                            <TextBlock Style="{StaticResource MutedText}"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       Text="{Binding QuarantineHint}" />
                        </StackPanel>
                    </Border>

                    <!-- 预览列表 -->
                    <Border Grid.Row="1"
                            Style="{StaticResource Card}"
                            Margin="0,12,0,0"
                            Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    BorderBrush="{DynamicResource RuleBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="12,9">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <TextBlock Text="匹配邮件"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource InkBrush}" />
                                        <TextBlock Style="{StaticResource MutedText}"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding PreviewCount, StringFormat=共 {0:N0} 封}" />
                                        <TextBlock Style="{StaticResource MutedText}"
                                                   Margin="6,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding PreviewSize, StringFormat=（{0}）}" />
                                        <!-- 作用域：从账户 / 文件夹右键进来时显示，可一键清除 -->
                                        <Border Margin="10,0,0,0"
                                                Padding="8,2"
                                                CornerRadius="8"
                                                Background="{DynamicResource AccentSoftBrush}"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding HasScope, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding ScopeLabel, StringFormat=作用域：{0}}"
                                                           FontSize="11"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource AccentBrush}" />
                                                <Button Style="{StaticResource BtnGhost}"
                                                        Margin="6,0,0,0"
                                                        Height="20"
                                                        Padding="6,0"
                                                        Content="清除"
                                                        FontSize="11"
                                                        ToolTip="清除作用域，改为按全部账户统计"
                                                        Command="{Binding ClearScopeCommand}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Style="{StaticResource MutedText}"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding SelectedRows, StringFormat=已勾选 {0} 封}" />
                                        <Button Style="{StaticResource Btn}"
                                                Margin="10,0,0,0"
                                                Content="{Binding CleanupSelectedText}"
                                                Command="{Binding CleanupSelectedCommand}"
                                                IsEnabled="{Binding CanCleanupSelected}"
                                                ToolTip="清理列表中勾选的邮件（勾选可以跨页）" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="1">
                                <ListBox Style="{StaticResource AppListBox}"
                                         ItemTemplate="{StaticResource PreviewRowTemplate}"
                                         ItemsSource="{Binding PreviewItems}" />

                                <TextBlock Style="{StaticResource MutedText}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Text="点击「预览匹配」按条件筛选邮件"
                                           Visibility="{Binding HasPreview, Converter={StaticResource InverseBoolToVisibility}}" />
                            </Grid>

                            <!-- 底部：勾选（本页 / 全部）与分页 -->
                            <Border Grid.Row="2"
                                    BorderBrush="{DynamicResource RuleBrush}"
                                    BorderThickness="0,1,0,0"
                                    Padding="10,6">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <Button Style="{StaticResource BtnGhost}"
                                                MinWidth="64"
                                                Content="全选本页"
                                                Command="{Binding SelectPageCommand}"
                                                IsEnabled="{Binding CanSelect}" />
                                        <Button Style="{StaticResource BtnGhost}"
                                                MinWidth="64"
                                                Margin="4,0,0,0"
                                                Content="反选本页"
                                                Command="{Binding InvertPageCommand}"
                                                IsEnabled="{Binding CanSelect}" />
                                        <Rectangle Style="{StaticResource VDivider}" Margin="8,0" />
                                        <Button Style="{StaticResource BtnGhost}"
                                                MinWidth="52"
                                                Content="全选"
                                                ToolTip="勾选当前筛选条件下匹配的全部邮件（跨页）"
                                                Command="{Binding SelectAllCommand}"
                                                IsEnabled="{Binding CanSelect}" />
                                        <Button Style="{StaticResource BtnGhost}"
                                                MinWidth="52"
                                                Margin="4,0,0,0"
                                                Content="反选"
                                                ToolTip="勾选与不勾选互换，范围为当前筛选条件下的全部邮件（跨页）"
                                                Command="{Binding InvertAllCommand}"
                                                IsEnabled="{Binding CanSelect}" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource BtnGhost}"
                                                MinWidth="52"
                                                Content="首页"
                                                Command="{Binding FirstPageCommand}"
                                                IsEnabled="{Binding CanGoPrevious}" />
                                        <Button Style="{StaticResource BtnGhost}"
                                                MinWidth="52"
                                                Margin="4,0,0,0"
                                                Content="上一页"
                                                Command="{Binding PreviousPageCommand}"
                                                IsEnabled="{Binding CanGoPrevious}" />
                                        <TextBlock Style="{StaticResource MutedText}"
                                                   Margin="10,0"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding PageInfo}" />
                                        <Button Style="{StaticResource BtnGhost}"
                                                MinWidth="52"
                                                Content="下一页"
                                                Command="{Binding NextPageCommand}"
                                                IsEnabled="{Binding CanGoNext}" />
                                        <Button Style="{StaticResource BtnGhost}"
                                                MinWidth="52"
                                                Margin="4,0,0,0"
                                                Content="末页"
                                                Command="{Binding LastPageCommand}"
                                                IsEnabled="{Binding CanGoNext}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- 进度 -->
                    <Border Grid.Row="2"
                            Margin="0,12,0,0"
                            Background="{DynamicResource ChromeBrush}"
                            BorderBrush="{DynamicResource RuleBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,9"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource MutedText}" Text="{Binding ProgressText}" />
                                <ProgressBar Height="6"
                                             Margin="0,6,0,0"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="{Binding ProgressPercent}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Style="{StaticResource Btn}"
                                    Margin="12,0,0,0"
                                    Content="中断"
                                    Command="{Binding CancelCommand}" />
                        </Grid>
                    </Border>

                    <!-- 清理记录 -->
                    <Border Grid.Row="3"
                            Style="{StaticResource Card}"
                            Margin="0,12,0,0"
                            Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    BorderBrush="{DynamicResource RuleBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="12,7">
                                <Grid>
                                    <TextBlock Text="清理记录（可追溯）"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource InkBrush}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource Btn}"
                                                Content="刷新"
                                                Command="{Binding RefreshJobsCommand}" />
                                        <Button Style="{StaticResource Btn}"
                                                Margin="6,0,0,0"
                                                Content="恢复"
                                                Command="{Binding ResumeCommand}"
                                                ToolTip="继续一次被中断的清理任务，跳过已处理邮件" />
                                        <Button Style="{StaticResource Btn}"
                                                Margin="6,0,0,0"
                                                Content="撤销"
                                                Command="{Binding UndoCommand}"
                                                ToolTip="把该任务清理的邮件与附件恢复到原位置" />
                                        <Button Style="{StaticResource Btn}"
                                                Margin="6,0,0,0"
                                                Content="彻底删除"
                                                Command="{Binding PurgeCommand}"
                                                ToolTip="删除隔离区数据并释放空间，不可撤销" />
                                        <Button Style="{StaticResource Btn}"
                                                Margin="6,0,0,0"
                                                Content="清理超期隔离"
                                                Command="{Binding PurgeExpiredCommand}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <ListBox Grid.Row="1"
                                     Style="{StaticResource AppListBox}"
                                     ItemTemplate="{StaticResource JobRowTemplate}"
                                     ItemsSource="{Binding Jobs}"
                                     SelectedItem="{Binding SelectedJob, Mode=TwoWay}" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- 底部状态 -->
            <Border Grid.Row="2"
                    Background="{DynamicResource ChromeBrush}"
                    BorderBrush="{DynamicResource RuleBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Style="{StaticResource MutedText}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Text="{Binding StatusText}" />

                    <Button Grid.Column="1"
                            Style="{StaticResource Btn}"
                            Content="关闭"
                            Command="{Binding CloseCommand}" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</views:DialogWindow>
