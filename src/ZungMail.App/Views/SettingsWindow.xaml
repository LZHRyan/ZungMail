                                           FontSize="12"
                                           Margin="0,4,0,0"
                                           Foreground="{DynamicResource Ink2Brush}"
                                           Text="GET /api/update/ping" />
                                <TextBlock Style="{StaticResource MutedText}"
                                           Margin="0,10,0,0"
                                           TextWrapping="Wrap"
                                           Text="完整部署与接口说明见仓库 docs/升级服务部署与客户端升级说明.md。" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ 反馈 ============ -->
                <ScrollViewer Grid.Column="1"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding IsFeedbackSection, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Margin="20,18,20,20">

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="问题反馈" />
                                <TextBlock Style="{StaticResource MutedText}"
                                           Margin="0,8,0,0"
                                           TextWrapping="Wrap"
                                           Text="反馈直接提交到升级服务，开发者可在管理页查看。请先选分类，再尽量写清「做了什么、看到什么、期望什么」，越具体越好定位。" />

