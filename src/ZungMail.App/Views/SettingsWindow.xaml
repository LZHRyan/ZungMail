                                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource MutedText}" Margin="0,0,0,6" Text="MIT" />

                                    <TextBlock Grid.Row="2" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,6" Text="CommunityToolkit.Mvvm" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource MutedText}" Margin="0,0,0,6" Text="MIT" />

