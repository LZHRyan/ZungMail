                                <TextBlock Style="{StaticResource MutedText}"
                                           Margin="24,2,0,0"
                                           TextWrapping="Wrap"
                                           Text="{Binding FeedbackLogHint}" />

                                <CheckBox Style="{StaticResource RowCheckBox}"
                                          Content="附加系统环境（版本、操作系统、.NET、邮件与账户数量）"
                                          IsChecked="{Binding FeedbackAttachEnvironment}" />
                                <TextBlock Style="{StaticResource MutedText}"
                                           Margin="0,8,0,0"
                                           TextWrapping="Wrap"
                                           Text="环境摘要只含版本、系统与规模统计，不含邮箱地址、账户口令与邮件正文；日志里的邮箱与口令在提交前会替换为占位符。" />

                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                    <Button Style="{StaticResource BtnPrimary}"
                                            Content="{Binding FeedbackSubmitText}"
                                            Command="{Binding SubmitFeedbackCommand}"
