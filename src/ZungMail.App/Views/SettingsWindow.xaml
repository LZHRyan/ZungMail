                                           FontSize="12"
                                           Margin="0,10,0,0"
                                           Foreground="{DynamicResource Ink2Brush}"
                                           TextWrapping="Wrap"
                                           Text="GET /api/update/check?current=1.0.0&amp;channel=stable&amp;os=windows&amp;arch=x64" />
                                <TextBlock FontFamily="Consolas"
                                           FontSize="12"
                                           Margin="0,4,0,0"
                                           Foreground="{DynamicResource Ink2Brush}"
                                           Text="GET /api/update/download/{id}（支持 Range 断点）" />
