                                <TextBlock Style="{StaticResource CardTitle}" Text="版权声明" />
                                <TextBlock Style="{StaticResource MutedText}"
                                           Margin="0,10,0,0"
                                           TextWrapping="Wrap"
                                           Text="© 2026 ZungMail · 保留所有权利。" />
                                <TextBlock Style="{StaticResource MutedText}"
                                           Margin="0,6,0,0"
                                           TextWrapping="Wrap"
                                           Text="本软件按现状提供，不对特定用途的适用性作出担保；第三方组件的版权与许可条款以上述开源协议为准。" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- 底部操作栏 -->
            <Border Grid.Row="2"
                    Background="{DynamicResource ChromeBrush}"
                    BorderBrush="{DynamicResource RuleBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Style="{StaticResource MutedText}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Text="{Binding StatusText}" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource BtnPrimary}"
                                Content="保存设置"
                                Command="{Binding SaveSettingsCommand}" />
                        <Button Style="{StaticResource Btn}"
                                Margin="8,0,0,0"
                                Content="关闭"
                                Command="{Binding CloseCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</views:DialogWindow>
