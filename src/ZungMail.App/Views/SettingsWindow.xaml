                                           FontSize="12"
                                           Margin="0,10,0,0"
                                           Foreground="{DynamicResource Ink2Brush}"
                                           Text="POST /api/feedback（JSON，上限 1 MB）" />
                                <TextBlock Style="{StaticResource MutedText}"
                                           Margin="0,10,0,0"
                                           TextWrapping="Wrap"
                                           Text="服务端默认按来源每小时限 10 条、保留最近 200 条，管理页「用户反馈」页签可查看、复制日志与删除。" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
