                                    <Button Style="{StaticResource Btn}"
                                            Margin="8,0,0,0"
                                            Content="清空"
                                            Command="{Binding ClearFeedbackCommand}" />
                                </StackPanel>

                                <TextBlock Style="{StaticResource FeedbackResult}"
                                           Margin="0,12,0,0"
                                           TextWrapping="Wrap"
                                           Text="{Binding FeedbackResultText}"
                                           Visibility="{Binding HasFeedbackResult, Converter={StaticResource BoolToVisibility}}" />

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,10,0,0"
                                            Visibility="{Binding HasFeedbackSubmittedId, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource MutedText}"
                                               VerticalAlignment="Center"
                                               Text="反馈编号" />
                                    <TextBlock Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               FontFamily="Consolas"
                                               FontSize="13"
                                               Foreground="{DynamicResource InkBrush}"
                                               Text="{Binding FeedbackSubmittedId}" />
                                    <Button Style="{StaticResource Btn}"
                                            Margin="10,0,0,0"
                                            Height="28"
                                            MinHeight="28"
                                            Content="复制编号"
                                            Command="{Binding CopyFeedbackIdCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="提交与隐私" />
                                <TextBlock Style="{StaticResource MutedText}"
                                           Margin="0,8,0,0"
                                           TextWrapping="Wrap"
                                           Text="提交复用「升级」分区里的服务地址，接口固定为下面这条；不需要另配服务器。" />
