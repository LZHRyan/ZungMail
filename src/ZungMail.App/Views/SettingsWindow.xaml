                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <TextBlock Style="{StaticResource MutedText}"
                                               Width="86"
                                               VerticalAlignment="Center"
                                               Text="检测时机" />
                                    <ComboBox Style="{StaticResource AppComboBox}"
                                              Width="180"
                                              ToolTip="客户端启动后等待该时长再检测，避免和收信、索引初始化抢资源"
                                              ItemsSource="{Binding UpdateDelayOptions}"
                                              SelectedIndex="{Binding UpdateDelayIndex, Mode=TwoWay}" />
                                </StackPanel>

                                <TextBlock Style="{StaticResource MutedText}"
                                           Margin="0,12,0,0"
                                           TextWrapping="Wrap"
                                           Text="自动检测失败只写日志与状态栏，不会弹窗打断操作；手动检测失败会给出可操作的原因。" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="检测与安装" />
                                <TextBlock Style="{StaticResource MutedText}"
                                           Margin="0,10,0,0"
                                           TextWrapping="Wrap"
                                           Text="{Binding UpdateStatusText}" />

                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button Style="{StaticResource BtnPrimary}"
                                            Content="{Binding UpdateActionText}"
                                            Command="{Binding OpenUpdateWindowCommand}" />
                                </StackPanel>

                                <TextBlock Style="{StaticResource MutedText}"
                                           Margin="0,12,0,0"
                                           TextWrapping="Wrap"
                                           Text="下载完成后点「立即安装」：客户端会先保存草稿与设置，再关闭自身并启动安装程序，装好后自动重新打开。覆盖安装只替换程序文件，本地邮件数据库、账户、设置、模板与 .eml 都不会被删除。如果发布的是便携版 zip，窗口里不会出现「立即安装」，需下载后手动解压覆盖。" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="接口约定（部署参考）" />
                                <TextBlock Style="{StaticResource MutedText}"
                                           Margin="0,8,0,0"
                                           TextWrapping="Wrap"
                                           Text="升级服务固定提供以下接口，客户端只拼根地址，不需要用户填写具体接口：" />
