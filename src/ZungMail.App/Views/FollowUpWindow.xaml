<views:DialogWindow x:Class="ZungMail.App.Views.FollowUpWindow"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:views="clr-namespace:ZungMail.App.Views"
                     Title="等待回复"
                     Width="900"
                     Height="640"
                     MinWidth="720"
                     MinHeight="480"
                     Background="{DynamicResource WindowBackgroundBrush}"
                     FontFamily="{StaticResource AppFont}"
                     FontSize="13">
    <Border BorderBrush="{DynamicResource RuleStrongBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource ChromeBrush}"
                    BorderBrush="{DynamicResource RuleBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="OnTitleBarMouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                        <Border Width="20" Height="20" CornerRadius="6" Background="{DynamicResource BrandMarkBrush}">
                            <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IcoClock}" Stroke="White" />
                        </Border>
                        <TextBlock Text="等待回复" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource InkBrush}" />
                        <TextBlock Text="{Binding Summary}" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Style="{StaticResource MutedText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Button Style="{StaticResource WinBtn}"
                                Command="{x:Static SystemCommands.MinimizeWindowCommand}"
                                CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                                ToolTip="最小化">
                            <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IcoMin}" />
                        </Button>
                        <Button Style="{StaticResource WinBtn}"
                                Command="{x:Static SystemCommands.MaximizeWindowCommand}"
                                CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                                ToolTip="最大化 / 还原">
                            <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IcoMax}" />
                        </Button>
                        <Button Style="{StaticResource WinBtnClose}"
                                Command="{Binding CloseCommand}"
                                ToolTip="关闭">
                            <Path Style="{StaticResource IconPathSmall}"
                                  Data="{StaticResource IcoClose}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,14,16,16">
                    <TextBlock Style="{StaticResource MutedText}"
                               Text="没有等待回复的邮件"
                               HorizontalAlignment="Center"
                               Margin="0,40,0,0"
                               Visibility="{Binding HasActive, Converter={StaticResource InverseBoolToVisibility}}" />
                    <TextBlock Style="{StaticResource MutedText}"
                               Text="在邮件上点右键 →「等待回复…」即可登记要等谁回、什么时候看。"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0"
                               Visibility="{Binding HasActive, Converter={StaticResource InverseBoolToVisibility}}" />

                    <ItemsControl ItemsSource="{Binding Active}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding SubjectDisplay}"
                                                       Style="{StaticResource PageTitle}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Border Grid.Column="1"
                                                    CornerRadius="6"
                                                    Padding="7,2"
                                                    Background="{DynamicResource AccentSoftBrush}"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ProgressText}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentBrush}" />
                                            </Border>
                                        </Grid>

                                        <TextBlock Style="{StaticResource MutedText}"
                                                   Margin="0,7,0,0"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding RequirementText}" />
                                        <TextBlock Margin="0,3,0,0"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource Ink2Brush}"
                                                   Text="{Binding PendingText}" />
                                        <TextBlock Style="{StaticResource MutedText}"
                                                   Margin="0,3,0,0"
                                                   Text="{Binding NextCheckDisplay}" />
                                        <TextBlock Style="{StaticResource MutedText}"
                                                   Margin="0,1,0,0"
                                                   Text="{Binding NotifiedText}" />
                                        <TextBlock Style="{StaticResource MutedText}"
                                                   Margin="0,3,0,0"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding FollowUp.Note}"
                                                   Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                            <Button Style="{StaticResource BtnGhost}" Content="打开邮件"
                                                    Command="{Binding DataContext.OpenMessageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Style="{StaticResource Btn}" Content="给未回复的人写信" Margin="6,0,0,0"
                                                    Command="{Binding DataContext.RemindCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Style="{StaticResource BtnGhost}" Content="继续跟进" Margin="6,0,0,0"
                                                    Command="{Binding DataContext.ContinueCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Style="{StaticResource BtnGhost}" Content="取消" Margin="6,0,0,0"
                                                    Command="{Binding DataContext.CancelFollowUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource LabelText}"
                               Text="最近结束"
                               Margin="0,10,0,6"
                               Visibility="{Binding HasFinished, Converter={StaticResource BoolToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding Finished}"
                                  Visibility="{Binding HasFinished, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding SubjectDisplay}"
                                               Style="{StaticResource MutedText}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding StateText}"
                                               Style="{StaticResource MutedText}"
                                               Margin="10,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Padding="16,8" BorderBrush="{DynamicResource RuleBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Style="{StaticResource MutedText}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding StatusText}" />
                    <Button Grid.Column="1" Style="{StaticResource Btn}" Content="关闭" Command="{Binding CloseCommand}" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</views:DialogWindow>
