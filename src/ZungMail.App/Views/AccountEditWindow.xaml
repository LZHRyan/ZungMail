<views:DialogWindow x:Class="ZungMail.App.Views.AccountEditWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:ZungMail.App.Views"
                    xmlns:controls="clr-namespace:ZungMail.App.Controls"
                    Title="{Binding Title}"
                    Width="620"
                    Height="700"
                    MinWidth="540"
                    MinHeight="560"
                    Background="{DynamicResource WindowBackgroundBrush}"
                    FontFamily="{StaticResource AppFont}"
                    FontSize="13">

    <Border BorderBrush="{DynamicResource RuleStrongBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0"
                    Background="{DynamicResource ChromeBrush}"
                    BorderBrush="{DynamicResource RuleBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="OnTitleBarMouseDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                        <Border Width="20" Height="20" CornerRadius="6" Background="{DynamicResource BrandMarkBrush}">
                            <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IcoUsers}" Stroke="White" />
                        </Border>
                        <TextBlock Text="{Binding Title}"
                                   FontWeight="SemiBold"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource InkBrush}" />
                        <TextBlock Style="{StaticResource MutedText}"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="{Binding PresetName, StringFormat=· {0}}"
                                   Visibility="{Binding PresetName, Converter={StaticResource NotEmptyToVisibility}}" />
                    </StackPanel>

                    <Button Style="{StaticResource WinBtnClose}"
                            HorizontalAlignment="Right"
                            Command="{x:Static SystemCommands.CloseWindowCommand}"
                            CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                            ToolTip="关闭">
                        <Path Style="{StaticResource IconPathSmall}"
                              Data="{StaticResource IcoClose}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </Grid>
            </Border>

            <!-- 表单 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16,20,16">
                <StackPanel>

                    <TextBlock Style="{StaticResource LabelText}" Text="账户名称" />
                    <TextBox Style="{StaticResource AppTextBox}"
                             Margin="0,5,0,0"
                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Style="{StaticResource LabelText}" Text="邮箱地址" Margin="0,14,0,0" />
                    <TextBox Style="{StaticResource AppTextBox}"
                             Margin="0,5,0,0"
                             Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Style="{StaticResource LabelText}" Text="发信显示名（可选）" />
                            <TextBox Style="{StaticResource AppTextBox}"
                                     Margin="0,5,0,0"
                                     Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource LabelText}" Text="标识色" />
                            <!-- 色盘选色：不再要求用户手敲 # 色号；下面一排常用色可以一键点选 -->
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <controls:ColorPickerBox Hex="{Binding Color, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="点击打开色盘选取账户标识色" />
                                <TextBlock Style="{StaticResource MutedText}"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="{Binding ColorPreview}" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding PresetColors}" Margin="0,6,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource IconBtn}"
                                                Width="20"
                                                Height="20"
                                                Margin="0,0,4,4"
                                                ToolTip="{Binding}"
                                                Command="{Binding DataContext.PickPresetColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <Border Width="13"
                                                    Height="13"
                                                    CornerRadius="4"
                                                    Background="{Binding Converter={StaticResource HexToBrush}}" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>

                    <Rectangle Height="1" Fill="{DynamicResource RuleBrush}" Margin="0,18,0,16" />

                    <TextBlock Style="{StaticResource LabelText}" Text="登录用户名" />
                    <TextBox Style="{StaticResource AppTextBox}"
                             Margin="0,5,0,0"
                             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Style="{StaticResource LabelText}" Text="凭据类型" />
                            <ComboBox Style="{StaticResource AppComboBox}"
                                      Margin="0,5,0,0"
                                      ItemsSource="{Binding AuthKinds}"
                                      SelectedItem="{Binding CredentialKind, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource LabelText}" Text="授权码 / 密码 / 令牌" />
                            <PasswordBox x:Name="SecretBox"
                                         Style="{StaticResource AppPasswordBox}"
                                         Margin="0,5,0,0"
                                         PasswordChanged="OnSecretChanged" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Style="{StaticResource MutedText}"
                               Margin="0,7,0,0"
                               TextWrapping="Wrap"
                               Text="{Binding SecretHint}" />

                    <Rectangle Height="1" Fill="{DynamicResource RuleBrush}" Margin="0,18,0,16" />

                    <TextBlock Style="{StaticResource LabelText}" Text="IMAP（收信）" />
                    <Grid Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="82" />
                            <ColumnDefinition Width="186" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Style="{StaticResource AppTextBox}"
                                 Text="{Binding ImapHost, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Grid.Column="1"
                                 Style="{StaticResource AppTextBox}"
                                 Margin="8,0,0,0"
                                 Text="{Binding ImapPort, UpdateSourceTrigger=PropertyChanged}" />
                        <ComboBox Grid.Column="2"
                                  Style="{StaticResource AppComboBox}"
                                  Margin="8,0,0,0"
                                  ItemsSource="{Binding SecureModes}"
                                  SelectedItem="{Binding ImapSecure, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <TextBlock Style="{StaticResource LabelText}" Text="SMTP（发信）" Margin="0,14,0,0" />
                    <Grid Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="82" />
                            <ColumnDefinition Width="186" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Style="{StaticResource AppTextBox}"
                                 Text="{Binding SmtpHost, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Grid.Column="1"
                                 Style="{StaticResource AppTextBox}"
                                 Margin="8,0,0,0"
                                 Text="{Binding SmtpPort, UpdateSourceTrigger=PropertyChanged}" />
                        <ComboBox Grid.Column="2"
                                  Style="{StaticResource AppComboBox}"
                                  Margin="8,0,0,0"
                                  ItemsSource="{Binding SecureModes}"
                                  SelectedItem="{Binding SmtpSecure, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <TextBlock Style="{StaticResource MutedText}"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Text="按 NFR-S1，客户端强制使用 SSL/TLS 加密连接，不提供明文传输选项。" />

                    <CheckBox Style="{StaticResource AppCheckBox}"
                              Margin="0,14,0,0"
                              Content="启用该账户（参与同步与发信）"
                              IsChecked="{Binding IsEnabled}" />

                    <!-- 收取设置：账户级覆盖全局的「默认收取策略」 -->
                    <TextBlock Style="{StaticResource LabelText}"
                               Margin="0,16,0,6"
                               Text="收取设置" />
                    <ComboBox Style="{StaticResource AppComboBox}"
                              ItemsSource="{Binding FetchPolicies}"
                              SelectedItem="{Binding SelectedFetchPolicy, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Style="{StaticResource MutedText}"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Text="{Binding FetchPolicyHint}" />
                </StackPanel>
            </ScrollViewer>

            <!-- 底部操作栏 -->
            <Border Grid.Row="2"
                    Background="{DynamicResource ChromeBrush}"
                    BorderBrush="{DynamicResource RuleBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Style="{StaticResource MutedText}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Text="{Binding StatusText}" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource Btn}"
                                Content="测试连接"
                                Command="{Binding TestCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                        <Button Style="{StaticResource Btn}"
                                Margin="8,0,0,0"
                                Content="取消"
                                Command="{Binding CancelCommand}" />
                        <Button Style="{StaticResource BtnPrimary}"
                                Margin="8,0,0,0"
                                Content="保存"
                                Command="{Binding SaveCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</views:DialogWindow>
