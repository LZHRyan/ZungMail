<views:DialogWindow x:Class="ZungMail.App.Views.TodoEditWindow"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:views="clr-namespace:ZungMail.App.Views"
                     Title="标记待办"
                     Width="420"
                     Height="300"
                     ResizeMode="NoResize"
                     Background="{DynamicResource WindowBackgroundBrush}"
                     FontFamily="{StaticResource AppFont}"
                     FontSize="13">
    <Border BorderBrush="{DynamicResource RuleStrongBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource RuleBrush}"
                    BorderThickness="0,0,0,1" MouseLeftButtonDown="OnTitleBarMouseDown">
                <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <Border Width="20" Height="20" CornerRadius="6" Background="{DynamicResource BrandMarkBrush}">
                        <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IcoCheck}" Stroke="White" />
                    </Border>
                    <TextBlock Text="标记待办" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource InkBrush}" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="1" Margin="20,16,20,12">
                <TextBlock Style="{StaticResource LabelText}" Text="待办内容" />
                <TextBox x:Name="TitleBox" Style="{StaticResource AppTextBox}" Margin="0,5,0,0" />

                <TextBlock Style="{StaticResource LabelText}" Text="截止日期（可选）" Margin="0,14,0,0" />
                <DatePicker x:Name="DueDate" Width="160" HorizontalAlignment="Left" Margin="0,5,0,0" />

                <TextBlock Style="{StaticResource MutedText}" Margin="0,10,0,0" TextWrapping="Wrap"
                           Text="保存后可在「我的待办」中查看；到期后托盘会提醒。" />
                <TextBlock x:Name="ErrorText" Style="{StaticResource MutedText}" Margin="0,8,0,0"
                           Foreground="{DynamicResource ErrorDotBrush}" />
            </StackPanel>

            <Border Grid.Row="2" Padding="16,10" BorderBrush="{DynamicResource RuleBrush}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource Btn}" Content="取消" Click="OnCancelClick" />
                    <Button Style="{StaticResource BtnPrimary}" Margin="8,0,0,0" Content="保存" Click="OnSaveClick" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</views:DialogWindow>
