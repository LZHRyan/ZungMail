<views:DialogWindow x:Class="ZungMail.App.Views.MailSourceWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:ZungMail.App.Views"
                    Title="邮件源码"
                    Icon="pack://application:,,,/Assets/Brand/ZungMail.ico"
                    Width="960"
                    Height="720"
                    MinWidth="640"
                    MinHeight="420"
                    Background="{DynamicResource WindowBackgroundBrush}"
                    FontFamily="{StaticResource AppFont}"
                    FontSize="13"
                    TextOptions.TextFormattingMode="Ideal"
                    TextOptions.TextRenderingMode="ClearType"
                    UseLayoutRounding="True"
                    SnapsToDevicePixels="True">

    <views:DialogWindow.Resources>
        <!-- 源码区：等宽、不换行、双向滚动；只读但仍可全选复制 -->
        <Style x:Key="SourceTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ReaderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New, Microsoft YaHei" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="AcceptsTab" Value="True" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="SelectionBrush" Value="{DynamicResource SelectedBrush}" />
        </Style>
    </views:DialogWindow.Resources>

    <Border Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource RuleStrongBrush}"
            BorderThickness="1"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ============ 标题栏 ============ -->
            <Border Grid.Row="0"
                    Background="{DynamicResource ChromeBrush}"
                    BorderBrush="{DynamicResource RuleBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="OnWindowTitleBarMouseDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                        <Image Width="20"
                               Height="20"
                               Source="pack://application:,,,/Assets/Brand/ZungMailMark64.png"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="邮件源码"
                                   FontWeight="SemiBold"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource InkBrush}" />
                    </StackPanel>
                    <Button Style="{StaticResource WinBtnClose}"
                            HorizontalAlignment="Right"
                            Click="OnCloseClick"
                            ToolTip="关闭">
                        <Path Style="{StaticResource IconPathSmall}"
                              Data="{StaticResource IcoClose}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </Grid>
            </Border>

            <!-- ============ 摘要：主题 / 来源 / 编码与体积 ============ -->
            <Border Grid.Row="1"
                    Padding="16,10"
                    BorderBrush="{DynamicResource RuleBrush}"
                    BorderThickness="0,0,0,1">
                <StackPanel>
                    <TextBlock Text="{Binding Subject}"
                               FontWeight="SemiBold"
                               FontSize="14"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource InkBrush}" />

                    <WrapPanel Margin="0,8,0,0" Orientation="Horizontal">
                        <Border CornerRadius="9"
                                Padding="9,2"
                                VerticalAlignment="Center"
                                Background="{DynamicResource AccentSoftBrush}">
                            <TextBlock Text="{Binding SourceLabel}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}" />
                        </Border>
                        <TextBlock Text="{Binding SummaryText}"
                                   Style="{StaticResource MutedText}"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center" />
                    </WrapPanel>

                    <!-- 回退说明：离线 / 服务器拒绝时告诉用户看到的是本地重建版 -->
                    <Border Margin="0,8,0,0"
                            Padding="10,7"
                            CornerRadius="6"
                            Background="{DynamicResource WarningSoftBrush}"
                            BorderBrush="{DynamicResource WarningBrush}"
                            BorderThickness="1"
                            Visibility="{Binding HasFallback, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPathSmall}"
                                  Data="{StaticResource IcoAlert}"
                                  Stroke="{DynamicResource WarningBrush}"
                                  VerticalAlignment="Top" />
                            <TextBlock Margin="8,0,0,0"
                                       TextWrapping="Wrap"
                                       FontSize="12.5"
                                       Foreground="{DynamicResource WarningBrush}"
                                       Text="{Binding FallbackReason, StringFormat=未能取回服务器原文：{0}。下面是按本地数据重建的邮件，另存 .eml 仍可在其它客户端打开。}" />
                        </StackPanel>
                    </Border>

                    <!-- 完全取不到：给出原因，可直接重试 -->
                    <Border Margin="0,8,0,0"
                            Padding="10,7"
                            CornerRadius="6"
                            Background="{DynamicResource CriticalSoftBrush}"
                            BorderBrush="{DynamicResource CriticalBrush}"
                            BorderThickness="1"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock TextWrapping="Wrap"
                                   FontSize="12.5"
                                   Foreground="{DynamicResource CriticalBrush}"
                                   Text="{Binding ErrorText}" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- ============ 工具条 ============ -->
            <Border Grid.Row="2"
                    Padding="16,8"
                    BorderBrush="{DynamicResource RuleBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource Btn}"
                                Click="OnCopyAllClick"
                                IsEnabled="{Binding HasSource}"
                                ToolTip="把窗口里的源码复制到剪贴板">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IcoCopy}" />
                                <TextBlock Text="复制全部" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Btn}"
                                Margin="8,0,0,0"
                                Click="OnSaveAsClick"
                                IsEnabled="{Binding HasSource}"
                                ToolTip="把源码原样保存为 .eml（Outlook / Foxmail 可直接打开）">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IcoSave}" />
                                <TextBlock Text="另存为 .eml" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Btn}"
                                Margin="8,0,0,0"
                                Command="{Binding ReloadCommand}"
                                IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBool}}"
                                ToolTip="重新连接服务器获取原始源码">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IcoRefresh}" />
                                <TextBlock Text="重新获取" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <TextBlock Text="正在获取源码…"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Style="{StaticResource MutedText}"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Border>

            <!-- ============ 源码正文 ============ -->
            <TextBox Grid.Row="3"
                     Style="{StaticResource SourceTextBox}"
                     Text="{Binding Text, Mode=OneWay}"
                     AutomationProperties.Name="邮件源码正文" />

            <!-- ============ 状态行 ============ -->
            <Border Grid.Row="4"
                    Padding="16,7"
                    Background="{DynamicResource ChromeBrush}"
                    BorderBrush="{DynamicResource RuleBrush}"
                    BorderThickness="0,1,0,0">
                <TextBlock Text="{Binding StatusText}"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource MutedBrush}" />
            </Border>
        </Grid>
    </Border>
</views:DialogWindow>
