<views:DialogWindow x:Class="ZungMail.App.Views.ShipmentCaseWindow"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:views="clr-namespace:ZungMail.App.Views"
                     Title="一票货"
                     Width="980"
                     Height="700"
                     MinWidth="780"
                     MinHeight="520"
                     Background="{DynamicResource WindowBackgroundBrush}"
                     FontFamily="{StaticResource AppFont}"
                     FontSize="13">
    <Border BorderBrush="{DynamicResource RuleStrongBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ============ 标题栏 ============ -->
            <Border Grid.Row="0"
                    Background="{DynamicResource ChromeBrush}"
                    BorderBrush="{DynamicResource RuleBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="OnTitleBarMouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                        <Border Width="20" Height="20" CornerRadius="6" Background="{DynamicResource BrandMarkBrush}">
                            <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IcoArchive}" Stroke="White" />
                        </Border>
                        <TextBlock Text="一票货" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource InkBrush}" />
                        <TextBlock Text="{Binding MessageCountDisplay}" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Style="{StaticResource MutedText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Button Style="{StaticResource WinBtn}"
                                Command="{x:Static SystemCommands.MinimizeWindowCommand}"
                                CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                                ToolTip="最小化">
                            <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IcoMin}" />
                        </Button>
                        <Button Style="{StaticResource WinBtn}"
                                Command="{x:Static SystemCommands.MaximizeWindowCommand}"
                                CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                                ToolTip="最大化 / 还原">
                            <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IcoMax}" />
                        </Button>
                        <Button Style="{StaticResource WinBtnClose}"
                                Command="{Binding CloseCommand}"
                                ToolTip="关闭">
                            <Path Style="{StaticResource IconPathSmall}"
                                  Data="{StaticResource IcoClose}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ 案件概要 ============ -->
            <Border Grid.Row="1" Padding="16,14,16,10">
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="42"
                                Height="42"
                                CornerRadius="10"
                                VerticalAlignment="Center"
                                Background="{Binding CaseKindColor, Converter={StaticResource HexToBrush}}">
                            <TextBlock Text="{Binding CaseKindShort}"
                                       Foreground="White"
                                       FontSize="11.5"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding CaseRef}" Style="{StaticResource PageTitle}" />
                                <TextBlock Text="{Binding StatusText}"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource MutedBrush}" />
                                <Border CornerRadius="6"
                                        Padding="7,1"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource AccentSoftBrush}"
                                        Visibility="{Binding HasStage, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding StageText}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentBrush}" />
                                </Border>
                                <Border CornerRadius="6"
                                        Padding="7,1"
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource CriticalSoftBrush}"
                                        Visibility="{Binding HasException, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="异常"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource ErrorDotBrush}" />
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Style="{StaticResource MutedText}" Text="{Binding CaseKindLabel}" />
                                <Rectangle Style="{StaticResource VDivider}" Margin="8,0" />
                                <TextBlock Style="{StaticResource MutedText}" Text="{Binding NextDeadlineDisplay}" />
                                <Rectangle Style="{StaticResource VDivider}" Margin="8,0" />
                                <TextBlock Style="{StaticResource MutedText}" Text="{Binding LastActivityDisplay}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource BtnGhost}"
                                    Command="{Binding FilterInMainCommand}"
                                    ToolTip="回到主窗口按该单号查看全部往来邮件">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IcoSearch}" />
                                    <TextBlock Text="在主窗口筛选" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource BtnGhost}"
                                    Margin="6,0,0,0"
                                    Command="{Binding ToggleStatusCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IcoCheck}" />
                                    <TextBlock Text="{Binding ToggleStatusText}" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource BtnPrimary}"
                                    Margin="6,0,0,0"
                                    Command="{Binding ExportCommand}"
                                    ToolTip="把该票货的邮件与附件打成一个 zip">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource IconPathSmall}"
                                          Data="{StaticResource IcoFileZip}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <TextBlock Text="导出资料包" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>

            <!-- ============ 时间轴 + 节点 / 附件 ============ -->
            <Grid Grid.Row="2" Margin="16,0,16,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.25*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="14,12,14,6">
                            <TextBlock Text="邮件时间轴" Style="{StaticResource LabelText}" VerticalAlignment="Center" />
                            <TextBlock Text="同一票货的全部往来" Style="{StaticResource MutedText}"
                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>

                        <ListBox Grid.Row="1"
                                 Style="{StaticResource AppListBox}"
                                 ItemsSource="{Binding Messages}"
                                 Margin="6,0,6,8"
                                 Visibility="{Binding HasMessages, Converter={StaticResource BoolToVisibility}}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="8,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0"
                                                 Width="6"
                                                 Height="6"
                                                 VerticalAlignment="Center"
                                                 Fill="{DynamicResource AccentBrush}"
                                                 Visibility="{Binding IsUnread, Converter={StaticResource BoolToVisibility}}" />
                                        <StackPanel Grid.Column="1" Margin="4,0,8,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0"
                                                        CornerRadius="4"
                                                        Padding="4,0"
                                                        Margin="0,0,5,0"
                                                        VerticalAlignment="Center"
                                                        Background="{Binding TypeColor, Converter={StaticResource HexToBrush}}"
                                                        Visibility="{Binding HasType, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="{Binding TypeLabel}"
                                                               FontSize="9.5"
                                                               FontWeight="Bold"
                                                               Foreground="White" />
                                                </Border>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding SubjectDisplay}"
                                                           Foreground="{DynamicResource InkBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding FromText}" Style="{StaticResource MutedText}" />
                                                <TextBlock Text="{Binding DateDisplay}" Style="{StaticResource MutedText}" Margin="10,0,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Path Grid.Column="2"
                                              Style="{StaticResource IconPathSmall}"
                                              Data="{StaticResource IcoPaperclip}"
                                              Stroke="{DynamicResource MutedBrush}"
                                              VerticalAlignment="Center"
                                              Visibility="{Binding HasAttachment, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Grid.Row="1"
                                   Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Text="该案件还没有关联邮件"
                                   Visibility="{Binding HasMessages, Converter={StaticResource InverseBoolToVisibility}}" />
                    </Grid>
                </Border>

                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="时效节点" Style="{StaticResource LabelText}" />
                                <TextBlock Style="{StaticResource MutedText}"
                                           Margin="0,4,0,0"
                                           TextWrapping="Wrap"
                                           Text="截关 / 截补料 / VGM / ETD / ETA 从邮件正文自动抽取，只有解析出具体时间才会计入。" />
                                <ItemsControl ItemsSource="{Binding Deadlines}" Margin="0,8,0,0"
                                              Visibility="{Binding HasDeadlines, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,6"
                                                    Padding="8,6"
                                                    CornerRadius="6"
                                                    Background="{DynamicResource SidebarBrush}"
                                                    BorderBrush="{DynamicResource RuleBrush}"
                                                    BorderThickness="1"
                                                    ToolTip="{Binding Tooltip}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0"
                                                            Width="3"
                                                            CornerRadius="2"
                                                            Margin="0,1,8,1"
                                                            Background="{Binding KindColor, Converter={StaticResource HexToBrush}}" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding KindLabel}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource InkBrush}" />
                                                        <TextBlock Text="{Binding DueDisplay}" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                    <Border Grid.Column="2"
                                                            CornerRadius="6"
                                                            Padding="7,2"
                                                            VerticalAlignment="Center"
                                                            Background="{DynamicResource AccentSoftBrush}">
                                                        <TextBlock Text="{Binding CountdownText}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{Binding UrgencyColor, Converter={StaticResource HexToBrush}}" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Style="{StaticResource MutedText}"
                                           Margin="0,6,0,0"
                                           Text="未从这些邮件里识别到时效节点"
                                           Visibility="{Binding HasDeadlines, Converter={StaticResource InverseBoolToVisibility}}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="附件" Style="{StaticResource LabelText}" />
                                <TextBlock Style="{StaticResource MutedText}"
                                           Margin="0,4,0,0"
                                           TextWrapping="Wrap"
                                           Text="只列出已下载到本地的附件，随资料包一起导出。" />
                                <ItemsControl ItemsSource="{Binding Attachments}" Margin="0,8,0,0"
                                              Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource BtnGhost}"
                                                    HorizontalContentAlignment="Left"
                                                    Margin="0,0,0,4"
                                                    Padding="8,5"
                                                    IsEnabled="{Binding IsAvailable}"
                                                    ToolTip="{Binding LocalPath}"
                                                    Command="{Binding DataContext.OpenAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IcoPaperclip}" />
                                                    <TextBlock Text="{Binding FileName}" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding SizeDisplay}" Style="{StaticResource MutedText}" Margin="8,0,0,0" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Style="{StaticResource MutedText}"
                                           Margin="0,6,0,0"
                                           Text="暂无已下载的附件"
                                           Visibility="{Binding HasAttachments, Converter={StaticResource InverseBoolToVisibility}}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ============ 状态栏 ============ -->
            <Border Grid.Row="3"
                    Padding="16,8"
                    BorderBrush="{DynamicResource RuleBrush}"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Style="{StaticResource MutedText}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding ExportStatus}" />
                    <Button Grid.Column="1"
                            Style="{StaticResource Btn}"
                            Content="关闭"
                            Command="{Binding CloseCommand}" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</views:DialogWindow>
