<views:DialogWindow x:Class="ZungMail.App.Views.TagPickerWindow"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:views="clr-namespace:ZungMail.App.Views"
                     Title="邮件标签"
                     Width="420"
                     Height="480"
                     Background="{DynamicResource WindowBackgroundBrush}"
                     FontFamily="{StaticResource AppFont}"
                     FontSize="13">
    <Border BorderBrush="{DynamicResource RuleStrongBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource RuleBrush}"
                    BorderThickness="0,0,0,1" MouseLeftButtonDown="OnTitleBarMouseDown">
                <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <Border Width="20" Height="20" CornerRadius="6" Background="{DynamicResource BrandMarkBrush}">
                        <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IcoArchive}" Stroke="White" />
                    </Border>
                    <TextBlock Text="邮件标签" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource InkBrush}" />
                </StackPanel>
            </Border>

            <ListBox x:Name="TagList" Grid.Row="1" Margin="12" Style="{StaticResource AppListBox}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="4,6"
                                  Content="{Binding Name}" Foreground="{DynamicResource InkBrush}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="14,0,14,8">
                <TextBox x:Name="NewTagBox" Style="{StaticResource AppTextBox}" Width="220" />
                <Button Style="{StaticResource Btn}" Margin="8,0,0,0" Content="新建标签" Click="OnCreateTagClick" />
                <TextBlock x:Name="ErrorText" Style="{StaticResource MutedText}" Margin="8,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource ErrorDotBrush}" />
            </StackPanel>

            <Border Grid.Row="3" Padding="16,10" BorderBrush="{DynamicResource RuleBrush}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource Btn}" Content="取消" Click="OnCancelClick" />
                    <Button Style="{StaticResource BtnPrimary}" Margin="8,0,0,0" Content="应用" Click="OnApplyClick" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</views:DialogWindow>
