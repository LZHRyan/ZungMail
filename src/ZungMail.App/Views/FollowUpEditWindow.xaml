<views:DialogWindow x:Class="ZungMail.App.Views.FollowUpEditWindow"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:views="clr-namespace:ZungMail.App.Views"
                     Title="等待回复"
                     Width="560"
                     Height="560"
                     MinWidth="480"
                     MinHeight="480"
                     Background="{DynamicResource WindowBackgroundBrush}"
                     FontFamily="{StaticResource AppFont}"
                     FontSize="13">
    <Border BorderBrush="{DynamicResource RuleStrongBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource ChromeBrush}"
                    BorderBrush="{DynamicResource RuleBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="OnTitleBarMouseDown">
                <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <Border Width="20" Height="20" CornerRadius="6" Background="{DynamicResource BrandMarkBrush}">
                        <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IcoClock}" Stroke="White" />
                    </Border>
                    <TextBlock Text="等待回复" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource InkBrush}" />
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,14,16,16">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{Binding Subject}" Style="{StaticResource PageTitle}" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0"
                                       Text="{Binding FromDisplay}" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,0"
                                       Text="{Binding SentDisplay}" />
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,16,0,0">
                        <TextBlock Style="{StaticResource LabelText}" Text="需要谁回复" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource BtnGhost}" Padding="8,0" Content="全选"
                                    Command="{Binding SelectAllCommand}" />
                            <Button Style="{StaticResource BtnGhost}" Padding="8,0" Margin="4,0,0,0" Content="清空"
                                    Command="{Binding SelectNoneCommand}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0" Text="{Binding SelectionText}" />

                    <Border Margin="0,8,0,0" Style="{StaticResource Card}" Padding="6">
                        <ListBox Style="{StaticResource AppListBox}" ItemsSource="{Binding Recipients}" MaxHeight="180">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="6,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0"
                                                  Style="{StaticResource AppCheckBox}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Display}"
                                                   Margin="6,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource InkBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding KindLabel}"
                                                   Style="{StaticResource MutedText}"
                                                   Margin="10,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <TextBlock Style="{StaticResource LabelText}" Text="判定条件" Margin="0,16,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource SegmentRadio}"
                                     GroupName="FollowUpRequire"
                                     Content="全部回复"
                                     IsChecked="{Binding RequireAll, Mode=TwoWay}" />
                        <RadioButton Style="{StaticResource SegmentRadio}"
                                     GroupName="FollowUpRequire"
                                     Content="至少几人"
                                     Margin="6,0,0,0"
                                     IsChecked="{Binding RequireAll, Mode=TwoWay, Converter={StaticResource InverseBool}}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                Visibility="{Binding RequireAll, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock Text="至少" VerticalAlignment="Center" Foreground="{DynamicResource InkBrush}" />
                        <TextBox Style="{StaticResource AppTextBox}" Width="60" Margin="8,0"
                                 Text="{Binding MinReplies, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="人回复" VerticalAlignment="Center" Foreground="{DynamicResource InkBrush}" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource LabelText}" Text="何时检查" Margin="0,16,0,6" />
                    <ComboBox Style="{StaticResource AppComboBox}"
                              Width="200"
                              HorizontalAlignment="Left"
                              ItemsSource="{Binding IntervalOptions}"
                              SelectedIndex="{Binding IntervalIndex, Mode=TwoWay}" />

                    <TextBlock Style="{StaticResource LabelText}" Text="备注（可留空）" Margin="0,16,0,6" />
                    <TextBox Style="{StaticResource AppTextBox}"
                             Height="64"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Foreground="{DynamicResource ErrorDotBrush}"
                               Margin="0,10,0,0"
                               TextWrapping="Wrap"
                               Text="{Binding Error}"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Style="{StaticResource MutedText}"
                               Margin="0,12,0,0"
                               TextWrapping="Wrap"
                               Text="到点后只提醒一次；提醒后停在本轮，由你决定「继续跟进」或给未回复的人写信。不会自动催信。" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Padding="16,10" BorderBrush="{DynamicResource RuleBrush}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource Btn}" Content="取消" Command="{Binding CancelCommand}" />
                    <Button Style="{StaticResource BtnPrimary}" Margin="8,0,0,0" Content="开始跟进"
                            Command="{Binding ConfirmCommand}" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</views:DialogWindow>
