<views:DialogWindow x:Class="ZungMail.App.Views.FolderPickerWindow"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:views="clr-namespace:ZungMail.App.Views"
                     Title="移动到文件夹"
                     Width="420"
                     Height="480"
                     ResizeMode="CanResize"
                     Background="{DynamicResource WindowBackgroundBrush}"
                     FontFamily="{StaticResource AppFont}"
                     FontSize="13">

    <Border BorderBrush="{DynamicResource RuleStrongBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource ChromeBrush}"
                    BorderBrush="{DynamicResource RuleBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="OnTitleBarMouseDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                        <Border Width="20" Height="20" CornerRadius="6" Background="{DynamicResource BrandMarkBrush}">
                            <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IcoFolder}" Stroke="White" />
                        </Border>
                        <TextBlock Text="移动到文件夹"
                                   FontWeight="SemiBold"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource InkBrush}" />
                    </StackPanel>
                    <Button Style="{StaticResource WinBtnClose}"
                            HorizontalAlignment="Right"
                            Command="{x:Static SystemCommands.CloseWindowCommand}"
                            CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                            ToolTip="关闭">
                        <Path Style="{StaticResource IconPathSmall}"
                              Data="{StaticResource IcoClose}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </Grid>
            </Border>

            <ListBox Grid.Row="1"
                     Margin="10"
                     Style="{StaticResource AppListBox}"
                     ItemContainerStyle="{StaticResource PanelListItem}"
                     ItemsSource="{Binding Targets}"
                     SelectedItem="{Binding Selected, Mode=TwoWay}"
                     MouseDoubleClick="OnListDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource InkBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{StaticResource MutedText}"
                                       Margin="0,2,0,0"
                                       Text="{Binding Folder.FullName, StringFormat={}{0}}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Row="2"
                    Padding="16,10"
                    BorderBrush="{DynamicResource RuleBrush}"
                    BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource Btn}" Content="取消" Command="{Binding CancelCommand}" />
                    <Button Style="{StaticResource BtnPrimary}"
                            Margin="8,0,0,0"
                            Content="移动"
                            Command="{Binding ConfirmCommand}" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</views:DialogWindow>
