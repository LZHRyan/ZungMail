<views:DialogWindow x:Class="ZungMail.App.Views.DiagnosticsWindow"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:views="clr-namespace:ZungMail.App.Views"
                     Title="收发诊断"
                     Width="720"
                     Height="560"
                     MinWidth="560"
                     MinHeight="420"
                     Background="{DynamicResource WindowBackgroundBrush}"
                     FontFamily="{StaticResource AppFont}"
                     FontSize="13">

    <Border BorderBrush="{DynamicResource RuleStrongBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource ChromeBrush}"
                    BorderBrush="{DynamicResource RuleBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="OnTitleBarMouseDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                        <Border Width="20" Height="20" CornerRadius="6" Background="{DynamicResource BrandMarkBrush}">
                            <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IcoInfo}" Stroke="White" />
                        </Border>
                        <TextBlock x:Name="TitleText"
                                   FontWeight="SemiBold"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource InkBrush}" />
                    </StackPanel>
                    <Button Style="{StaticResource WinBtnClose}"
                            HorizontalAlignment="Right"
                            Click="OnCloseClick"
                            ToolTip="关闭">
                        <Path Style="{StaticResource IconPathSmall}"
                              Data="{StaticResource IcoClose}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Row="1" Padding="16,10" BorderBrush="{DynamicResource RuleBrush}" BorderThickness="0,0,0,1">
                <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Foreground="{DynamicResource InkBrush}" />
            </Border>

            <ListBox x:Name="StepList" Grid.Row="2" Margin="10" Style="{StaticResource AppListBox}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="6,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="44" Padding="0,2" CornerRadius="4" VerticalAlignment="Top">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Success}" Value="False">
                                                <Setter Property="Background" Value="{DynamicResource CriticalSoftBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding StateText}" HorizontalAlignment="Center" FontSize="11">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Success}" Value="False">
                                                    <Setter Property="Foreground" Value="{DynamicResource CriticalBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" />
                                <TextBlock Style="{StaticResource MutedText}"
                                           Margin="0,3,0,0"
                                           TextWrapping="Wrap"
                                           Text="{Binding Detail}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Row="3" Padding="16,10" BorderBrush="{DynamicResource RuleBrush}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="StatusText" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button x:Name="CopyButton" Style="{StaticResource Btn}" Content="复制报告" Click="OnCopyClick" />
                    <Button Style="{StaticResource Btn}" Margin="8,0,0,0" Content="关闭" Click="OnCloseClick" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</views:DialogWindow>
