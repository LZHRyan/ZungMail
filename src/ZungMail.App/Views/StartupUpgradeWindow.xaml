<Window x:Class="ZungMail.App.Views.StartupUpgradeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="正在升级数据"
        Width="460"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{StaticResource AppFont}"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Border BorderBrush="{DynamicResource RuleStrongBrush}" BorderThickness="1">
        <Grid Margin="20,18,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource BrandMarkBrush}">
                    <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IcoDatabase}" Stroke="White" />
                </Border>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="正在升级本地数据" FontWeight="SemiBold" FontSize="14"
                               Foreground="{DynamicResource InkBrush}" />
                    <TextBlock x:Name="VersionText" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>

            <ProgressBar Grid.Row="1"
                         x:Name="StepBar"
                         Height="4"
                         Margin="0,16,0,0"
                         IsIndeterminate="True"
                         Minimum="0"
                         Maximum="1"
                         Foreground="{DynamicResource AccentBrush}"
                         Background="{DynamicResource RuleBrush}"
                         BorderThickness="0" />

            <TextBlock Grid.Row="2"
                       x:Name="DetailText"
                       Margin="0,10,0,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource InkBrush}" />

            <TextBlock Grid.Row="3"
                       Style="{StaticResource MutedText}"
                       Margin="0,10,0,0"
                       TextWrapping="Wrap"
                       Text="首次升级要重建索引，机械硬盘上可能持续 1~3 分钟。请不要关闭程序，升级中断不会损坏数据，下次启动会重新开始。" />
        </Grid>
    </Border>
</Window>
