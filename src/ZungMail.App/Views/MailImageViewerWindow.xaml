<views:DialogWindow x:Class="ZungMail.App.Views.MailImageViewerWindow"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:views="clr-namespace:ZungMail.App.Views"
                     Title="查看图片"
                     Width="880"
                     Height="700"
                     MinWidth="420"
                     MinHeight="300"
                     Background="{DynamicResource WindowBackgroundBrush}"
                     FontFamily="{StaticResource AppFont}"
                     FontSize="13">

    <Border BorderBrush="{DynamicResource RuleStrongBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题栏：与主窗口同为 32 DIP，保持同类区块等高 -->
            <Border Grid.Row="0"
                    Background="{DynamicResource ChromeBrush}"
                    BorderBrush="{DynamicResource RuleBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="OnTitleBarMouseDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                        <Border Width="18" Height="18" CornerRadius="5" Background="{DynamicResource BrandMarkBrush}">
                            <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IcoFileImage}" Stroke="White" />
                        </Border>
                        <TextBlock x:Name="TitleText"
                                   FontWeight="SemiBold"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource InkBrush}" />
                    </StackPanel>
                    <Button Style="{StaticResource WinBtnClose}"
                            HorizontalAlignment="Right"
                            Click="OnCloseClick"
                            ToolTip="关闭（Esc）">
                        <Path Style="{StaticResource IconPathSmall}"
                              Data="{StaticResource IcoClose}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </Grid>
            </Border>

            <!-- 图片区：滚轮缩放、按住左键拖动平视、双击在「适应窗口 / 实际大小」之间切换 -->
            <ScrollViewer x:Name="Scroller"
                          Grid.Row="1"
                          Margin="0"
                          Padding="0"
                          Background="{DynamicResource WindowBackgroundBrush}"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          MouseWheel="OnViewerMouseWheel"
                          PreviewMouseLeftButtonDown="OnViewerMouseDown"
                          PreviewMouseMove="OnViewerMouseMove"
                          PreviewMouseLeftButtonUp="OnViewerMouseUp">
                <Image x:Name="Preview"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Stretch="Fill"
                       RenderOptions.BitmapScalingMode="HighQuality" />
            </ScrollViewer>

            <!-- 底栏：左侧尺寸与缩放，右侧操作 -->
            <Border Grid.Row="2"
                    Padding="12,6"
                    BorderBrush="{DynamicResource RuleBrush}"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <TextBlock x:Name="StatusText"
                               Style="{StaticResource MutedText}"
                               VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource Btn}" Content="缩小" Click="OnZoomOutClick" ToolTip="滚轮向下" />
                        <Button Style="{StaticResource Btn}" Margin="6,0,0,0" Content="放大" Click="OnZoomInClick" ToolTip="滚轮向上" />
                        <Button Style="{StaticResource Btn}" Margin="6,0,0,0" Content="适应窗口" Click="OnFitClick" />
                        <Button Style="{StaticResource Btn}" Margin="6,0,0,0" Content="实际大小" Click="OnActualSizeClick" />
                        <Button Style="{StaticResource Btn}" Margin="6,0,0,0" Click="OnSaveAsClick" ToolTip="另存为图片文件">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource IconPathSmall}"
                                      Data="{StaticResource IcoSave}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Text="另存为…" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</views:DialogWindow>
