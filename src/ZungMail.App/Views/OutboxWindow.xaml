<views:DialogWindow x:Class="ZungMail.App.Views.OutboxWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:ZungMail.App.Views"
                    Title="发件箱"
                    Width="720"
                    Height="560"
                    MinWidth="560"
                    MinHeight="420"
                    Background="{DynamicResource WindowBackgroundBrush}"
                    FontFamily="{StaticResource AppFont}"
                    FontSize="13">

    <views:DialogWindow.Resources>
        <DataTemplate x:Key="OutboxRowTemplate">
            <Grid Margin="10,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding SubjectDisplay}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource InkBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Style="{StaticResource MutedText}"
                               Margin="0,4,0,0"
                               Text="{Binding RecipientsDisplay}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Style="{StaticResource MutedText}"
                               Margin="0,4,0,0"
                               Foreground="{DynamicResource ErrorDotBrush}"
                               TextWrapping="Wrap"
                               Text="{Binding LastError}"
                               Visibility="{Binding LastError, Converter={StaticResource NotEmptyToVisibility}}" />
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Border CornerRadius="8"
                            Padding="8,2"
                            HorizontalAlignment="Right">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Style.Triggers>
                                    <!-- 结果未知用警示色，与可安全重试的失败区分 -->
                                    <DataTrigger Binding="{Binding IsUncertain}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding StateDisplay}" FontSize="11">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsUncertain}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <TextBlock Style="{StaticResource MutedText}"
                               Margin="0,6,0,0"
                               HorizontalAlignment="Right"
                               Text="{Binding ScheduleDisplay}" />
                    <TextBlock Style="{StaticResource MutedText}"
                               Margin="0,4,0,0"
                               HorizontalAlignment="Right"
                               Text="{Binding AttemptsDisplay}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </views:DialogWindow.Resources>

    <Border BorderBrush="{DynamicResource RuleStrongBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource ChromeBrush}"
                    BorderBrush="{DynamicResource RuleBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="OnTitleBarMouseDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                        <Border Width="20" Height="20" CornerRadius="6" Background="{DynamicResource BrandMarkBrush}">
                            <Path Style="{StaticResource IconPathSmall}" Data="{StaticResource IcoSend}" Stroke="White" />
                        </Border>
                        <TextBlock Text="发件箱"
                                   FontWeight="SemiBold"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource InkBrush}" />
                        <TextBlock Style="{StaticResource MutedText}"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="定时发送与失败重试（FR-08）" />
                    </StackPanel>

                    <Button Style="{StaticResource WinBtnClose}"
                            HorizontalAlignment="Right"
                            Command="{x:Static SystemCommands.CloseWindowCommand}"
                            CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                            ToolTip="关闭">
                        <Path Style="{StaticResource IconPathSmall}"
                              Data="{StaticResource IcoClose}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <ListBox Style="{StaticResource AppListBox}"
                         ItemContainerStyle="{StaticResource PanelListItem}"
                         ItemTemplate="{StaticResource OutboxRowTemplate}"
                         ItemsSource="{Binding Items}"
                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}" />

                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <Path Style="{StaticResource IconPath}"
                          Width="32"
                          Height="32"
                          Data="{StaticResource IcoSend}"
                          Stroke="{DynamicResource RuleStrongBrush}"
                          HorizontalAlignment="Center" />
                    <TextBlock Text="发件箱是空的"
                               Style="{StaticResource MutedText}"
                               Margin="0,10,0,0"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="2"
                    Background="{DynamicResource ChromeBrush}"
                    BorderBrush="{DynamicResource RuleBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Style="{StaticResource MutedText}"
                               VerticalAlignment="Center"
                               Text="{Binding StatusText}" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource Btn}"
                                Content="刷新"
                                Command="{Binding ReloadCommand}" />
                        <Button Style="{StaticResource BtnPrimary}"
                                Margin="8,0,0,0"
                                Content="立即投递"
                                Command="{Binding SendNowCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                        <Button Style="{StaticResource Btn}"
                                Margin="8,0,0,0"
                                Content="重试选中"
                                Command="{Binding RetryCommand}" />
                        <Button Style="{StaticResource Btn}"
                                Margin="8,0,0,0"
                                Content="删除选中"
                                Command="{Binding DeleteCommand}" />
                        <Button Style="{StaticResource Btn}"
                                Margin="8,0,0,0"
                                Content="关闭"
                                Command="{Binding CloseCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</views:DialogWindow>
