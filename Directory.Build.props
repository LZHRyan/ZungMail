<Project>
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- 客户端与依赖统一按 x64 编译，避免 AnyCPU 在 32/64 位环境间漂移。
         仅设置 PlatformTarget，不改解决方案的 Any CPU 配置，现有 dotnet build/test 命令无需改参数。 -->
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <Prefer32Bit>false</Prefer32Bit>
    <!-- 1.2.0：MailClient → ZungMail 全量改名版本（程序名、安装目录、数据目录都变了） -->
    <Version>1.2.0</Version>
    <Product>ZungMail</Product>
    <Authors>Leung</Authors>
    <!-- 版本资源补全：安全软件 / SmartScreen 会看「公司、产品、描述、版权」是否齐全，
         空白版权（此前只有一个空格）属于「非正规软件」的典型特征。
         FileDescription 取自 AssemblyTitle，Comments 取自 Description。 -->
    <Company>Leung</Company>
    <AssemblyTitle>ZungMail 货代邮件客户端</AssemblyTitle>
    <Description>ZungMail 货代邮件客户端（WPF / .NET 8）</Description>
    <Copyright>Copyright © 2026 Leung</Copyright>
    <NeutralLanguage>zh-CN</NeutralLanguage>
    <!-- 生成并提交 packages.lock.json；发布构建可用 locked-mode 还原固化依赖版本 -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <!-- 生产项目统一输出至仓库根目录 bin/<项目名>/<配置>/<目标框架>。
       测试项目保留各自默认输出，避免测试运行器与产物目录混用。 -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'ZungMail.App' Or
                             '$(MSBuildProjectName)' == 'ZungMail.Application' Or
                             '$(MSBuildProjectName)' == 'ZungMail.Core' Or
                             '$(MSBuildProjectName)' == 'ZungMail.Infrastructure' Or
                             '$(MSBuildProjectName)' == 'ZungMail.Mail'">
    <BaseOutputPath>$(MSBuildThisFileDirectory)bin\$(MSBuildProjectName)\</BaseOutputPath>
  </PropertyGroup>
</Project>
